 1664 0C1E 4F                 CLRA
 1665 0C1F C6 0A              LDAB   #$0A             B:=10
 1666 0C21 CE 0BE3            LDX    #TENVL           POINT TO POWER OF TEN
 1667 0C24 BD 0C3A            JSR    MPY16            TENVL:=TENVL*10
 1668 0C27 B7 0BE3            STAA   TENVL
 1669 0C2A F7 0BE4            STAB   TENVL+1
