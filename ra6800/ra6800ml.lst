   13                  * EDOS addresses
   14      0000        XPASS  EQU    $0               ASSEMBLY PASS: 5, 7, 9 (USER 2,3,4)
   15      E800        XABORT EQU    $E800            ENTER EDOS, ABORT OUTPUT FILE
   16      E809        XRI    EQU    $E809            EDOS ROM DISK BYTE READ ROUTINE
   17      E80C        XWRT   EQU    $E80C            EDOS ROM DISK WRITE ROUTINE
   18      E80F        XSAVE  EQU    $E80F            ENTER EDOS, KEEP OUTPUT FILE
   19      F018        XOUTC  EQU    $F018            EXBUG PRINT SINGLE CHARACTER (ON CONSOLE)
   20      E82D        XRESTR EQU    $E82D            EDOS REWIND INPUT FILE
   21                  *
   22      A042        STACK  EQU    $A042
   23                  *
   24 0020                    ORG    $20
   25 0020 8E A042            LDS    #STACK
   26 0023 7E 047B            JMP    PASS1
