  874                  *
  875                  * COMPARE TWO STRINGS *
  876                  *
  877                  * ON ENTRY (X) = A PRAM LIST OF 5 BYTES *
  878                  *    ADDR(STRING1)
  879                  *    ADDR(STRING2)
  880                  *    COUNT OF # BYTES TO BE COMPARED
  881                  *
  882                  * ON RETURN IF CC Z BIT IS SET THERE IS A MATCH
  883                  *    EXAMPLE :
  884                  *          LDX #STRING1
  885                  *          JSR COMPAR
  886                  *          BEQ ------   MATCH
  887                  *
  888                  *    STRING1 RMB 2
  889                  *    STRING2 RMB 2
  890                  *    COUNT   RMB 1
  891                  *
  892 0782 36          COMPAR PSHA
  893 0783 37                 PSHB
  894 0784 E6 04              LDAB   4,X              GET COUNT
  895 0786 FF 07B1            STX    XSAV             SAVE PARAM POINTER
  896 0789 FE 07B1     CMP1   LDX    XSAV             GET PARAM POINTER
  897 078C EE 00              LDX    0,X              GET ADDR(STRING1)
  898 078E A6 00              LDAA   0,X              GET CHARACTER
  899 0790 FE 07B1            LDX    XSAV             GET PTR
  900 0793 6C 01              INC    1,X              PTR SET TO NEXT
  901 0795 26 02              BNE    CMP2             CHAR IN
  902 0797 6C 00              INC    0,X              STRING1
  903 0799 FE 07B1     CMP2   LDX    XSAV             GET PARAM POINTER
  904 079C EE 02              LDX    2,X              GET ADDR(STRING2)
  905 079E A1 00              CMPA   0,X              COMPARE
  906 07A0 26 0C              BNE    CDONE            NOT EQUAL
  907 07A2 FE 07B1            LDX    XSAV             GET PARAM POINTER
  908 07A5 6C 03              INC    3,X              PTR SET TO NEXT
  909 07A7 26 02              BNE    CMP3             CHAR IN
  910 07A9 6C 02              INC    2,X              STRING2
  911 07AB 5A          CMP3   DECB                    DECREMENT COUNTER
  912 07AC 26 DB              BNE    CMP1             TRY AGAIN
  913 07AE 33          CDONE  PULB                    DONE
  914 07AF 32                 PULA
  915 07B0 39                 RTS
  916                  *
  917 07B1             XSAV   RMB    2                PARAM PTR SAVE AREA
  918                  *
  919                  * NEXT TOKEN ROUTINE
  920                  * SCANS A LINE OF SOURCE CODE AND RETURNS
  921                  * THE NEXT TOKEN, CLASS &RC IN REGS A,B
  922                  * THE ADDRESS OF THE TOKEN IS RETURNED IN
  923                  * DESCRA AND THE NUM OF BYTES IN THE TOKEN IS
  924                  * THE RC AND CLASS ARE:
  925                  *
  926                  *   TYPE    RC(B)    CLASS(A)
  927                  *
  928                  * NAME       01        02        SUBSTRINGS
  929                  * HEX        03        02
  930                  * DECIMAL    09        02
  931                  *
  932                  * #          23        04        DELIMITERS
  933                  * ,          2C        04
  934                  * '          27        04
  935                  *
  936                  * *          2A        24        ARITHMETIC
  937                  * /          2F        24
  938                  * +          2B        24
  939                  * -          2D        24
  940                  *
  941                  * A          41        01        A,B,X REGS
  942                  * B          42        01
  943                  * X          58        01
  944                  *
  945                  * CR         0D        0D        EOL
  946                  *
  947                  * ERROR      00        00        ERRORS
  948                  *
  949                  *
  950 07B3 7F 0368     NXTOK  CLR    DESCRC
  951 07B6 7C 0368            INC    DESCRC           DESCRC := 1
  952 07B9 FE 0369     NXT0   LDX    CUCHAR           POINT TO CURRENT CHAR
  953 07BC FF 0366            STX    DESCRA           INIT DESCRA
  954 07BF A6 00              LDAA   0,X              GET CHAR
  955 07C1 08                 INX
  956 07C2 FF 0369            STX    CUCHAR           POINT TO NEXT CHAR
  957 07C5 81 20              CMPA   #$20             LESS THAN 20 HEX? (SPACE)
  958 07C7 27 F0              BEQ    NXT0             BLANK,SKIP OVER
  959 07C9 22 06              BHI    NXT1             IS > 20
  960                  *
  961 07CB 81 0D              CMPA   #$0D             CR?
  962 07CD 26 47              BNE    NXTER            NO,UNRECOGNIZABLE CHAR
  963 07CF 16                 TAB                     YES, SET RC
  964 07D0 39                 RTS
  965                  *
  966 07D1 81 5F       NXT1   CMPA   #$5F             IS >5F?
  967 07D3 23 02              BLS    NXT3             NO
  968 07D5 20 3F              BRA    NXTER            YES,UNRECOGNIZABLE CHAR
  969                  *
  970 07D7 BD 0880     NXT3   JSR    GCHRTB           GET BYTE FROM CHARTAB
  971 07DA 85 01              BITA   #$01             A,B,X REG?
  972 07DC 27 13              BEQ    NXT4             NO
  973                  *
  974 07DE FE 0369            LDX    CUCHAR           YES,CHECK NEXT CHAR
  975 07E1 E6 00              LDAB   0,X
  976 07E3 C1 20              CMPB   #$20             BLANK?
  977 07E5 27 04              BEQ    NXT3A            YES
  978 07E7 C1 0D              CMPB   #$0D             EOL?
  979 07E9 26 0A              BNE    NXT4A            NO GOTO NSCAN
  980                  *
  981 07EB FE 0366     NXT3A  LDX    DESCRA           GET RC
  982 07EE E6 00              LDAB   0,X
  983 07F0 39                 RTS
  984                  *
  985 07F1 85 80       NXT4   BITA   #$80             NAME?
  986 07F3 27 04              BEQ    NXT5             NO
  987 07F5 BD 0830     NXT4A  JSR    NSCAN            YES SCAN NAME STRING
  988 07F8 39                 RTS
  989                  *
  990 07F9 85 40       NXT5   BITA   #$40             DECIMAL?
  991 07FB 27 04              BEQ    NXT6             NO
  992 07FD BD 0819            JSR    DSCAN            YES,SCAN DECIMAL STRING
  993 0800 39                 RTS
  994                  *
  995 0801 85 20       NXT6   BITA   #$20             ARITHMETIC?
  996 0803 26 E6              BNE    NXT3A            YES GET RC AND RETURN
  997                  *
  998 0805 85 04              BITA   #$04             DELIMITERS?
  999 0807 27 0D              BEQ    NXTER            NO,UNRCOGNIZABLE CHAR
 1000 0809 FE 0366            LDX    DESCRA           GET CHAR
 1001 080C E6 00              LDAB   0,X
 1002 080E C1 24              CMPB   #$24             IS ? (HEX)
 1003 0810 26 D9              BNE    NXT3A            NO,GET RC AND RTN
 1004                  *
 1005 0812 BD 0855            JSR    HSCAN            SCAN HEX STRING
 1006 0815 39                 RTS
 1007                  *
 1008 0816 4F          NXTER  CLRA                    TROUBLE,SET RC,CLASS=00
 1009 0817 5F                 CLRB
 1010 0818 39                 RTS
 1011                  *
 1012                  * DSCAN - SCAN DECIMAL STRING AND STOP AT
 1013                  * FIRST NON-DECMIAL CHARACTER.
 1014                  *
 1015 0819 FE 0369     DSCAN  LDX    CUCHAR           POINT TO NEXT CHAR
 1016 081C A6 00              LDAA   0,X              GET CHAR
 1017 081E 7C 0368            INC    DESCRC           INCR DESCRC COUNT
 1018 0821 08                 INX
 1019 0822 FF 0369            STX    CUCHAR           POINT TO NEXT CHAR
 1020 0825 BD 0880            JSR    GCHRTB           GET BYTE IN CHARTAB
 1021 0828 85 40              BITA   #$40             DECIMAL?
 1022 082A 26 ED              BNE    DSCAN            YES CONTINUE SCAN
 1023 082C C6 09              LDAB   #$09
 1024 082E 20 43              BRA    ENDSCN           RETURN
 1025                  *
 1026                  * NSCAN SCAN NAME STRING AND STOP AT
 1027                  * FIRST NON-ALPHANUMERIC CHAR
 1028                  *
 1029 0830 FE 0369     NSCAN  LDX    CUCHAR           POINT TO NEXT CHAR
 1030 0833 A6 00              LDAA   0,X              GET CHAR
 1031 0835 7C 0368            INC    DESCRC           INCR DESCRC COUNT
 1032 0838 08                 INX
 1033 0839 FF 0369            STX    CUCHAR           POINT TO NEXT CHAR
 1034 083C BD 0880            JSR    GCHRTB           GET BYTE FROM CHARTAB
 1035 083F 85 80              BITA   #$80             ALPHA?
 1036 0841 26 ED              BNE    NSCAN            YES CONTINUE SCAN
 1037 0843 85 40              BITA   #$40             NUMERIC?
 1038 0845 26 E9              BNE    NSCAN            YES CONTINUE SCAN
 1039 0847 C6 07              LDAB   #$07             NAME TO LONG?
 1040 0849 F1 0368            CMPB   DESCRC
 1041 084C 24 03              BCC    NSCANA           NO
 1042 084E F7 0368            STAB   DESCRC           YES,TRUNCATE
 1043 0851 C6 01       NSCANA LDAB   #$01             LOAD RC
 1044 0853 20 1E              BRA    ENDSCN           RETURN
 1045                  *
 1046                  * HSCAN - SCAN A STRING OF HEX DATA AND STOP
 1047                  * AT FIRST NON-HEXADECIMAL CHARACTER.
 1048                  *
 1049 0855 7F 0368     HSCAN  CLR    DESCRC           DESCRC:=0
 1050 0858 FE 0369            LDX    CUCHAR           POINT TO NEXT CHAR
 1051 085B FF 0366            STX    DESCRA           INIT DESCRA
 1052 085E FE 0369     HSCAN1 LDX    CUCHAR           POINT TO NEXT CHAR
 1053 0861 A6 00              LDAA   0,X              GET CHAR
 1054 0863 7C 0368            INC    DESCRC           INCR DESCRC COUNT
 1055 0866 08                 INX
 1056 0867 FF 0369            STX    CUCHAR           POINT TO NEXT CHAR
 1057 086A BD 0880            JSR    GCHRTB           GET BYTE FROM CHRTAB
 1058 086D 85 02              BITA   #$02             HEX?
 1059 086F 26 ED              BNE    HSCAN1           YES CONTINUE SCAN
 1060 0871 C6 03              LDAB   #$03
 1061                  *
 1062 0873 7A 0368     ENDSCN DEC    DESCRC           DESCRC := CORRECT COUNT
 1063 0876 FE 0369            LDX    CUCHAR
 1064 0879 09                 DEX
 1065 087A FF 0369            STX    CUCHAR           CUCHAR:= CORRECT VALUE
 1066 087D 86 02              LDAA   #$02             LOAD CLASS RC
 1067 087F 39                 RTS                     ALL DONE
 1068                  *
 1069                  * GET A BYTE FROM CHARACTER TABLE INDEXED BY
 1070                  * VALUE IN A REGISTER.
 1071                  *
 1072 0880 81 20       GCHRTB CMPA   #$20             VALID CHAR?
 1073 0882 25 16              BCS    GCHRTR           NO <20
 1074 0884 81 5F              CMPA   #$5F             VALID CHAR?
 1075 0886 22 12              BHI    GCHRTR           NO >5F
 1076                  *
 1077 0888 7F 089C            CLR    CHPTR            INIT PARAM
 1078 088B B7 089D            STAA   CHPTR+1          SAVE CHAR
 1079 088E CE 089C            LDX    #CHPTR           POINT TO PARAM
 1080 0891 BD 0CA9            JSR    ADD16            ADD IN BASE OF CHARTAB
 1081 0894 FE 089C            LDX    CHPTR            GET BYTE IN CHARTAB
 1082 0897 A6 00              LDAA   0,X
 1083 0899 39                 RTS
 1084                  *
 1085 089A 4F          GCHRTR CLRA
 1086 089B 39                 RTS
 1087                  *
 1088 089C             CHPTR  RMB    2                PARAM LIST
 1089 089E 02 D8              FDB    CHRTAB-$20
 1090                  *
 1091                  * TABLE MANIPULATION ROUTINES FOR TABLES
 1092                  * SYMTAB AND MNTAB
 1093                  *
 1094                  * STORAGE LOCATIONS USED BY ROUTINES:
 1095                  *
 1096 08A0             PSTNG1 RMB    2                ADDRESS OF MENMONIC
 1097 08A2             PSTNG2 RMB    2                ADDRESS IN THE TABLE
 1098 08A4             PCOUNT RMB    1                LENGTH OF MNEMONIC
 1099 08A5             TBADD  RMB    2                TABLE POINTER
 1100 08A7             HSMBL  RMB    6                SYMBOL TEMP LOC
 1101 08AD             HKEYA  RMB    2                HASHED CODE
 1102 08AF             HKEYB  RMB    2                TEMP LOC FOR HASHED CODE
 1103 08B1             HSAV1  RMB    2                TEMP LOC FOR PTR
 1104 08B3             HSAV2  RMB    2                TEMP LOC FOR PTR
 1105                  *
 1106                  *
 1107                  * STORE A SYMBOL IN SYMTAB (SYMBOL TABLE)
 1108                  * ON ENTRY DESCRA CONTAINS THE ADDRESS OF
 1109                  * THE SYMBOL, AND DESCRC CONTAINS THE LENGTH
 1110                  * A STANDARD HASH CODE ALGORITHM IS USED
 1111                  *
 1112 08B5 BD 0976     STOSYM JSR    HASH             GET HASHED KEY
 1113 08B8 FF 036D            STX    SYMPTR           SAVE
 1114                  *
 1115                  * SEE IF LOC(HASH KEY) IS EMPTY
 1116                  *
 1117 08BB A6 00       SYMA   LDAA   0,X              GET FIRST CHARACTER
 1118 08BD 81 20              CMPA   #$20             BLANK?
 1119 08BF 26 2F              BNE    SYMB             NO
 1120                  *
 1121                  * STORE SYMBOL IN SYMTAB
 1122                  *
 1123 08C1 FF 08B3            STX    HSAV2            SAVE TABLE POINTER
 1124 08C4 CE 08A7            LDX    #HSMBL           POINT TO HSMBL
 1125 08C7 FF 08B1            STX    HSAV1            SAVE
 1126 08CA C6 06              LDAB   #6               LOAD SYMBOL LENGTH
 1127                  *
 1128                  * DO TRANSFER
 1129                  *
 1130 08CC FE 08B1     SYM1   LDX    HSAV1            POINT TO HSYMBL
 1131 08CF A6 00              LDAA   0,X              GET CHAR
 1132 08D1 08                 INX
 1133 08D2 FF 08B1            STX    HSAV1            POINT TO NEXT CHAR
 1134 08D5 FE 08B3            LDX    HSAV2            POINT TO TABLE SPACE
 1135 08D8 A7 00              STAA   0,X              STORE CHAR IN SYMTAB
 1136 08DA 08                 INX
 1137 08DB FF 08B3            STX    HSAV2            POINT TO NEXT POS
 1138 08DE 5A                 DECB                    ALL DONE?
 1139 08DF 26 EB              BNE    SYM1             NO
 1140                  *
 1141                  * STORE STORE LC, AND SET INFO BYTE
 1142                  *
 1143 08E1 B6 035E            LDAA   LC               GET LC
 1144 08E4 A7 00              STAA   0,X              STORE
 1145 08E6 B6 035F            LDAA   LC+1             GET LS BYTE OF LC
 1146 08E9 A7 01              STAA   1,X              STORE
 1147 08EB 86 40              LDAA   #$40             INFO BYTE:=RELOC,DEFINED
 1148 08ED A7 02              STAA   2,X
 1149 08EF 39                 RTS                     RETURN
 1150                  *
 1151                  * COMPARE HSMBL WITH ENTRY IN SYMTAB
 1152                  *
 1153 08F0 BD 093B     SYMB   JSR    SYMCMP           COMPARE
 1154 08F3 26 10              BNE    SYMC             NO MATCH
 1155                  *
 1156                  * ERROR, SYMBOL ALREADY IN TABLE
 1157                  *
 1158 08F5 FE 036D            LDX    SYMPTR           GET ADDRESS OF ENTRY
 1159 08F8 86 80              LDAA   #$80
 1160 08FA AA 08              ORAA   8,X              SET REDEFINED BIT
 1161 08FC A7 08              STAA   8,X
 1162 08FE CE 0206            LDX    #$0206           LOAD ERROR NUMBER
 1163 0901 BD 0E78     SYMB1  JSR    PRINTE           PRINT IT
 1164 0904 39                 RTS                     RETURN
 1165                  *
 1166                  * FIND ANOTHER SLOT IN SYMTAB FOR SYMBOL
 1167                  *
 1168 0905 BD 0950     SYMC   JSR    SYMMOD           GET ADDR(NEXT SLOT)
 1169 0908 BC 08AD            CPX    HKEYA            CHECKED ALREADY?
 1170 090B 27 02              BEQ    *+4              YES,TABLE IS FULL
 1171                  *
 1172 090D 20 AC              BRA    SYMA             TRY AGAIN
 1173                  *
 1174 090F CE 0221            LDX    #$0221           LOAD ERROR NUMBER
 1175 0912 20 ED              BRA    SYMB1            PRINT IT & RETURN
 1176                  *
 1177                  * LOOK UP SYMBOL IN SYMTAB
 1178                  * ON ENTRY DESCRA = ADDRESS OF SYMBOL
 1179                  *          DESCRC = SYMBOL LENGTH
 1180                  * ON RETURN B = VALUE OF INFO BYTE
 1181                  *             = FF SYMBOL NOT FOUND
 1182                  *           X = VALUE OF SYMBOL
 1183                  *
 1184                  *
 1185 0914 BD 0976     LKPSYM JSR    HASH             GET KEY
 1186 0917 FF 036D            STX    SYMPTR           SAVE
 1187                  *
 1188 091A A6 00       LKPSM1 LDAA   0,X              GET CHARACTER
 1189 091C 81 20              CMPA   #$20             BLANK?
 1190 091E 26 03              BNE    LKPSM3           NO
 1191                  *
 1192                  * ENTRY NOT IN SYMTAB
 1193                  *
 1194 0920 C6 FF       LKPSM2 LDAB   #$FF             LOAD RC
 1195 0922 39                 RTS                     RETURN
 1196                  *
 1197                  * COMPARE SYMBOL WITH ENTRY IN SYMTAB
 1198                  *
 1199 0923 BD 093B     LKPSM3 JSR    SYMCMP           COMPARE
 1200 0926 26 08              BNE    LKPSM4           NO MATCH
 1201                  *
 1202                  * FOUND, EXTRACT INFO, AND VALUE
 1203                  *
 1204 0928 FE 036D            LDX    SYMPTR           POINT TO ENTRY
 1205 092B E6 08              LDAB   8,X              GET INFO BYTE
 1206 092D EE 06              LDX    6,X              GET VALUE
 1207 092F 39                 RTS
 1208                  *
 1209                  * PROBE AGAIN FOR SYMBOL IN SYMTAB
 1210                  *
 1211 0930 BD 0950     LKPSM4 JSR    SYMMOD           GET NEXT KEY
 1212 0933 BC 08AD            CPX    HKEYA            ALREADY CHECKED?
 1213 0936 26 E2              BNE    LKPSM1           NO,TRY AGAIN
 1214 0938 C6 FF              LDAB   #$FF             SET RC
 1215 093A 39                 RTS
 1216                  *
 1217                  * ROUTINE TO COMPARE SYMBOL WITH ENTRY
 1218                  *
 1219 093B FF 08A0     SYMCMP STX    PSTNG1           SAVE PTR TO ENTRY
 1220 093E 86 06              LDAA   #6
 1221 0940 B7 08A4            STAA   PCOUNT           PCOUNT := LENGTH(SYMBOL)
 1222 0943 CE 08A7            LDX    #HSMBL
 1223 0946 FF 08A2            STX    PSTNG2           POINT TO HSMBL
 1224 0949 CE 08A0            LDX    #PSTNG1          POINT TO PARAMS
 1225 094C BD 0782            JSR    COMPAR           COMPARE
 1226 094F 39                 RTS
 1227                  *
 1228                  * FIND NEXT SLOT IN SYMTAB
 1229                  * SYMPTR:=SYMPTR+9 (MODULO NSYM)
 1230                  *
 1231 0950 FE 036D     SYMMOD LDX    SYMPTR           GET ADDR(CURRENT SLOT)
 1232 0953 08                 INX
 1233 0954 08                 INX
 1234 0955 08                 INX
 1235 0956 08                 INX
 1236 0957 08                 INX
 1237 0958 08                 INX
 1238 0959 08                 INX
 1239 095A 08                 INX
 1240 095B 08                 INX
 1241                  *
 1242                  * BEYOND SYMTAB?
 1243                  *
 1244 095C BC 0357            CPX    SYMEND
 1245 095F 26 03              BNE    *+5              NO
 1246 0961 FE 0353            LDX    SYMTAB           POINT TO FIRST ENTRY
 1247 0964 FF 036D            STX    SYMPTR           SAVE PTR TO ENTRY
 1248 0967 39                 RTS
 1249                  *
 1250                  * DELETE LAST SYMBOL ENTERED
 1251                  *
 1252 0968 FE 036D     DELSYM LDX    SYMPTR
 1253 096B 86 20              LDAA   #$20             LOAD BLANK
 1254 096D C6 09              LDAB   #9               LOAD ENTRY LENGTH
 1255                  *
 1256 096F A7 00       DEL1   STAA   0,X              BLANK BYTE
 1257 0971 08                 INX                     POINT TO NEXT BYTE
 1258 0972 5A                 DECB                    ALL DONE ?
 1259 0973 26 FA              BNE    DEL1             NO
 1260                  *
 1261 0975 39                 RTS                     YES, RETURN
 1262                  *
 1263                  * HASH SYMBOL TO PRODUCE A KEY
 1264                  *
 1265 0976 CE 2020     HASH   LDX    #$2020           BLANK HSMBL
 1266 0979 FF 08A7            STX    HSMBL
 1267 097C FF 08A9            STX    HSMBL+2
 1268 097F FF 08AB            STX    HSMBL+4
 1269                  *
 1270                  * MOVE SYMBOL TO HSMBL
 1271                  *
 1272 0982 CE 08A7            LDX    #HSMBL           POINT TO HSMBL
 1273 0985 FF 08B3            STX    HSAV2            SAVE
 1274 0988 FE 0366            LDX    DESCRA           POINT TO SYMBOL
 1275 098B FF 08B1            STX    HSAV1            SAVE
 1276 098E F6 0368            LDAB   DESCRC           GET LENGTH(SYMBOL)
 1277                  *
 1278 0991 FE 08B1     HASH1  LDX    HSAV1            POINT TO SYMBOL
 1279 0994 A6 00              LDAA   0,X              GET CHAR
 1280 0996 08                 INX
 1281 0997 FF 08B1            STX    HSAV1            POINT TO NEXT CHAR
 1282 099A FE 08B3            LDX    HSAV2            POINT TO HSYMBL
 1283 099D A7 00              STAA   0,X              STORE CHAR
 1284 099F 08                 INX
 1285 09A0 FF 08B3            STX    HSAV2            POINT TO NEXT CHAR
 1286 09A3 5A                 DECB                    ALL DONE
 1287 09A4 26 EB              BNE    HASH1            NO
 1288                  *
 1289                  * FOLD HSMBL TO CREATE A KEYA
 1290                  *
 1291 09A6 FE 08A7            LDX    HSMBL            HKEYA:=HSMBL(2)
 1292 09A9 FF 08AD            STX    HKEYA
 1293 09AC FE 08A9            LDX    HSMBL+2
 1294 09AF FF 08AF            STX    HKEYB
 1295 09B2 CE 08AD            LDX    #HKEYA
 1296 09B5 BD 0CA9            JSR    ADD16            ;      +HSMBL+2(2)
 1297 09B8 FE 08AB            LDX    HSMBL+4
 1298 09BB FF 08AF            STX    HKEYB
 1299 09BE CE 08AD            LDX    #HKEYA
 1300 09C1 BD 0CA9            JSR    ADD16            ;       +HSMBL+4(2)
 1301                  *
 1302                  * HKEYA:=REMAINDER OF HKEYA/NSYM
 1303                  *
 1304 09C4 B6 08AD            LDAA   HKEYA            LOAD VALUES
 1305 09C7 F6 08AE            LDAB   HKEYA+1
 1306 09CA FE 0355            LDX    NSYM
 1307 09CD FF 08AF            STX    HKEYB
 1308 09D0 CE 08AF            LDX    #HKEYB           POINT TO NSYM
 1309 09D3 BD 0C5E            JSR    DIV16
 1310 09D6 FF 08AD            STX    HKEYA            SAVE REMAINDER
 1311                  *
 1312                  * HKEYA:=HKEYA*9
 1313                  *
 1314 09D9 4F                 CLRA
 1315 09DA C6 09              LDAB   #9
 1316 09DC CE 08AD            LDX    #HKEYA
 1317 09DF BD 0C3A            JSR    MPY16
 1318 09E2 B7 08AD            STAA   HKEYA
 1319 09E5 F7 08AE            STAB   HKEYA+1
 1320                  *
 1321                  * ADD IN BASE OF SYMTAB
 1322                  *
 1323 09E8 FE 0353            LDX    SYMTAB
 1324 09EB FF 08AF            STX    HKEYB
 1325 09EE CE 08AD            LDX    #HKEYA
 1326 09F1 BD 0CA9            JSR    ADD16
 1327 09F4 FE 08AD            LDX    HKEYA
 1328 09F7 39                 RTS
 1329                  *
 1330                  * LOOK UP MNEMONIC IN MNTAB
 1331                  * ON ENTRY DESCRA = ADDR OF MNEMONIC
 1332                  *          DESCRC = LENGTH OF MNEMONIC
 1333                  * ON RETURN
 1334                  *  REG A = 00 FOUND
 1335                  *  REG A = FF NOT IN TABLE
 1336                  *  REG X = ADDR OF ROUTINE TO PROCESS
 1337                  *          THE OPCODE/PSEUDOP
 1338                  *  REG B = MACHINE CODE FOR OPCODES
 1339                  *        = FF FOR PSEUDOPS
 1340                  *
 1341                  * THE ALGORITHM USED IS A BINARY SEARCH
 1342                  *
 1343                  * TEMPORARY LOCATIONS:
 1344 09F8             LP     RMB    1                ONE BELOW LOWEST ENTRY
 1345 09F9             MP     RMB    1                ONE HIGHER THAN HIGHEST ENTRY
 1346 09FA             IP     RMB    1                CALCULATED PROBE VALUE
 1347 09FB 00 06       ENSIZ  FDB    6                LENGTH OF ENTRY IN MNTAB
 1348                  *
 1349 09FD B6 0368     MNLKP  LDAA   DESCRC
 1350 0A00 B7 08A4            STAA   PCOUNT           INIT PCOUNT
 1351 0A03 86 57              LDAA   #$57             $57=CHRTAB-MNTAB/6+1 (# OF ENTRIES+1)
 1352 0A05 B7 09F9            STAA   MP               INIT MP
 1353 0A08 4F                 CLRA
 1354 0A09 B7 09F8            STAA   LP               INIT LP
 1355                  *
 1356 0A0C B6 09F8     MNLKPA LDAA   LP
 1357 0A0F 4C                 INCA                    A:=LP+1
 1358 0A10 B1 09F9            CMPA   MP               MP:=LP+1 ?
 1359 0A13 26 03              BNE    MNLKPB           NO
 1360                  *
 1361 0A15 86 FF              LDAA   #$FF             YES, ENTRY NOT IN TABLE
 1362 0A17 39                 RTS
 1363                  *
 1364                  * IP:=(LP+MP)/2 TRUNCATED
 1365                  *
 1366 0A18 F6 09F8     MNLKPB LDAB   LP
 1367 0A1B FB 09F9            ADDB   MP               B:=LP+MP
 1368 0A1E 56                 RORB                    B:=B/2
 1369 0A1F F7 09FA            STAB   IP               SAVE IP
 1370                  *
 1371                  * GET 16 BITADDRESS OF ENTRY
 1372                  *
 1373 0A22 4F                 CLRA
 1374 0A23 CE 09FB            LDX    #ENSIZ           GET ENTRY LENGTH
 1375 0A26 5A                 DECB                    B:=IP-1
 1376 0A27 BD 0C3A            JSR    MPY16            GET (IP-1)*6
 1377 0A2A B7 08A0            STAA   PSTNG1           SAVE
 1378 0A2D F7 08A1            STAB   PSTNG1+1
 1379 0A30 CE 0100            LDX    #MNTAB
 1380 0A33 FF 08A2            STX    PSTNG2           PSTNG2:=BASE OF MNTAB
 1381 0A36 CE 08A0            LDX    #PSTNG1          POINT TO PARAMS
 1382 0A39 BD 0CA9            JSR    ADD16            PSTNG1:=(IP-1)*6+MNTAB
 1383 0A3C FE 08A0            LDX    PSTNG1
 1384 0A3F FF 08A5            STX    TBADD            SAVE
 1385                  *
 1386                  * COMPARE MNEMONIC WITH ENTRY IN MNTAB
 1387                  *
 1388 0A42 FE 0366            LDX    DESCRA           GET MNEMONIC ADDRESS
 1389 0A45 FF 08A2            STX    PSTNG2           INIT PARAM FOR COMPARE
 1390 0A48 CE 08A0            LDX    #PSTNG1          POINT TO PARAMS
 1391 0A4B BD 0782            JSR    COMPAR           COMPARE
 1392 0A4E 25 0B              BCS    MNLI             ENTRY<MNEMONIC
 1393 0A50 26 11              BNE    MNMI             ENTRY>MNEMONIC
 1394                  *
 1395 0A52 4F                 CLRA                    ENTRY FOUND
 1396 0A53 FE 08A5            LDX    TBADD            POINT TO ENTRY
 1397 0A56 E6 05              LDAB   5,X              GET MACHINE CODE
 1398 0A58 EE 03              LDX    3,X              GET BRANCH TO ROUTINE ADDR
 1399 0A5A 39                 RTS
 1400                  *
 1401                  * ENTRY<MNEMONIC LP:=IP
 1402                  *
 1403 0A5B B6 09FA     MNLI   LDAA   IP
 1404 0A5E B7 09F8            STAA   LP
 1405 0A61 20 A9              BRA    MNLKPA           TRY AGAIN
 1406                  *
 1407                  * ENTRY>MNEMONIC MP:=IP
 1408                  *
 1409 0A63 B6 09FA     MNMI   LDAA   IP
 1410 0A66 B7 09F9            STAA   MP
 1411 0A69 20 A1              BRA    MNLKPA           TRY AGAIN
 1412                  *
 1413                  * EVALUATE NUMBERS, SYMBOLS AND EXPRESSIONS
 1414                  *
 1415 0A6B             VALUE  RMB    2
 1416 0A6D             TMPVAL RMB    2
 1417 0A6F             CLFLG  RMB    1                CLASS OF PREVIOUS TOKEN
 1418 0A70             CLASS  RMB    1                CLASS OF CURRENT TOKEN
 1419 0A71             OPERN  RMB    1                ARITHMETIC OPERATOR
 1420                  *
 1421 0A72 7F 0A6B     NSEVL  CLR    VALUE
 1422 0A75 7F 0A6C            CLR    VALUE+1          VALUE := 0
 1423 0A78 7F 0A6F            CLR    CLFLG            CLFLG := 0
 1424 0A7B B7 0A70            STAA   CLASS            SAVE CLASS OF TOKEN
 1425 0A7E C1 2A              CMPB   #$2A             IS * ?
 1426 0A80 26 2D              BNE    NSVLC1           NO
 1427                  *
 1428 0A82 FE 035E            LDX    LC               YES
 1429 0A85 FF 0A6B            STX    VALUE            VALUE := LC
 1430 0A88 86 02              LDAA   #2
 1431 0A8A B7 0A6F            STAA   CLFLG            CLFLG:=2
 1432 0A8D 73 0362            COM    RELFLG           RELFLG:=RELOC
 1433                  *
 1434 0A90 FE 0369     NSVLA  LDX    CUCHAR
 1435 0A93 A6 00              LDAA   0,X              GET NEXT CHAR
 1436 0A95 81 20              CMPA   #$20             BLANK?
 1437 0A97 27 08              BEQ    NSVLB            YES
 1438 0A99 81 0D              CMPA   #$0D             EOL?
 1439 0A9B 27 04              BEQ    NSVLB            YES
 1440 0A9D 81 2C              CMPA   #$2C             COMMA?
 1441 0A9F 26 08              BNE    NSVLC            NO
 1442                  *
 1443 0AA1 FE 0A6B     NSVLB  LDX    VALUE
 1444 0AA4 FF 0D25            STX    ADR1             ADR1,2:=VALUE
 1445 0AA7 5F                 CLRB                    RC := 00
 1446 0AA8 39                 RTS                     ALL DONE
 1447                  *
 1448 0AA9 BD 07B3     NSVLC  JSR    NXTOK            GET NEXT TOKEN
 1449 0AAC B7 0A70            STAA   CLASS            SAVE TOKEN CLASS
 1450 0AAF B1 0A6F     NSVLC1 CMPA   CLFLG            CLASS = CLFLG?
 1451 0AB2 26 06              BNE    NSVLF            NO
 1452                  *
 1453 0AB4 CE 0204     NSVLD  LDX    #$0204           ERROR
 1454 0AB7 5F          NSVLE  CLRB
 1455 0AB8 53                 COMB                    RC := FF
 1456 0AB9 39                 RTS                     RETURN
 1457                  *
 1458 0ABA 81 02       NSVLF  CMPA   #$02             IS STRING?
 1459 0ABC 27 14              BEQ    NSVLH            YES
 1460                  *
 1461 0ABE 81 24              CMPA   #$24             ARITHMETIC OPERATOR?
 1462 0AC0 27 02              BEQ    NSVLG            YES
 1463 0AC2 20 F0              BRA    NSVLD            ERROR
 1464                  *
 1465 0AC4 7D 0A6F     NSVLG  TST    CLFLG            CLFLG=0?
 1466 0AC7 27 EB              BEQ    NSVLD            YES,ERROR
 1467                  *
 1468 0AC9 F7 0A71            STAB   OPERN            SAVE OPERATOR
 1469 0ACC B7 0A6F            STAA   CLFLG            CLFLG:=CLASS
 1470 0ACF 7E 0A90            JMP    NSVLA            SCAN AGAIN
 1471                  *
 1472 0AD2 C1 03       NSVLH  CMPB   #$03             HEX STRING?
 1473 0AD4 26 11              BNE    NSVLJ            NO
 1474                  *
 1475 0AD6 F6 0368            LDAB   DESCRC           YES
 1476 0AD9 C1 04              CMPB   #4               IS > 4?
 1477 0ADB 2F 05              BLE    NSVLH1           NO
 1478                  *
 1479 0ADD CE 0210            LDX    #$0210           YES,ERROR
 1480 0AE0 20 D5              BRA    NSVLE
 1481                  *
 1482 0AE2 BD 0B8B     NSVLH1 JSR    CVHB             CONVERT
 1483 0AE5 20 3B              BRA    NSVLM
 1484                  *
 1485 0AE7 C1 09       NSVLJ  CMPB   #$09             DECIMAL?
 1486 0AE9 26 11              BNE    NSVLK            NO
 1487                  *
 1488 0AEB F6 0368            LDAB   DESCRC
 1489 0AEE C1 05              CMPB   #5               LENGTH > 5?
 1490 0AF0 2F 05              BLE    NSVLJ1           NO
 1491                  *
 1492 0AF2 CE 0210            LDX    #$0210           YES,ERROR
 1493 0AF5 20 C0              BRA    NSVLE
