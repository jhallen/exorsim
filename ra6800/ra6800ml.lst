 1657 0C0B 4F                 CLRA                    CLEAR ACCUMULATOR
 1658 0C0C CE 0BE3            LDX    #TENVL           POINT TO POWER OF TEN
 1659 0C0F BD 0C3A            JSR    MPY16            (A,B):=TENVL*DIGIT
