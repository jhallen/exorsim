 1621                  * ROUTINE TO CONVERT ASCII TO BINARY
 1622                  *
 1623 0BD5 A6 00       CVHBS  LDAA   0,X              GET BYTE
 1624 0BD7 80 30              SUBA   #$30             CONVERT
 1625 0BD9 81 09              CMPA   #$09             0 - 9 ?
 1626 0BDB 2F 02              BLE    *+4              YES
 1627 0BDD 80 07              SUBA   #$07             NO, 10 - 15
 1628 0BDF 39                 RTS
 1629                  *
 1630                  * CVDB: CONVERT DECIMAL TO BINARY
 1631                  * ON ENTRY DESCRA = ADDRESS OF DECIMAL STRING
 1632                  *          DESCRC = # BYTES IN DECIMAL STRING
 1633                  * ON RETURN [X] = VALUE IN BINARY
 1634                  *
 1635 0BE0             DVAL   RMB    2                TEMP STORAGE FOR BINARY
 1636 0BE2             DCOUNT RMB    1                DIGIT COUNT
 1637 0BE3             TENVL  RMB    2                POWER OF TEN
 1638 0BE5             DXSAV  RMB    2                TEMPORARY STORAGE FOR X
 1639                  *
 1640 0BE7 7F 0BE0     CVDB   CLR    DVAL             DVAL:=0
 1641 0BEA 7F 0BE1            CLR    DVAL+1
 1642 0BED 7F 0BE3            CLR    TENVL
 1643 0BF0 7F 0BE4            CLR    TENVL+1
 1644 0BF3 7C 0BE4            INC    TENVL+1          TENVL:=1
 1645 0BF6 FE 0366            LDX    DESCRA           POINT TO STRING
 1646 0BF9 09                 DEX
 1647 0BFA F6 0368            LDAB   DESCRC
 1648 0BFD F7 0BE2            STAB   DCOUNT           INIT DCOUNT
 1649                  *
 1650 0C00 08          CVDB1  INX                     POINT TO
 1651 0C01 5A                 DECB                    LEAST SIGNIFICANT
 1652 0C02 26 FC              BNE    CVDB1            DIGIT
