; Comment

echo "SWTPC setup file..."

; CPU

cpu 6800

; Load initial memory

read swtbug.bin

; Mark address ranges with ROMs

rom e000 e400

; Load device drivers

device swtpc_acia 8004
device swtpc_acia_alias 8006
device swtpc_1771 8018
device swtpc_1771_ds 8014

; Default disk images
; These are overridden by the command line

drivetype swtpc
drive0 flex.dsk

; Default line-printer file

lpt listing.lp

; 'Facts' file
; These provide symbols and for the dissembler

facts facts

echo "Done."
