; Comment

echo "EXORdisk-II setup..."

; CPU

cpu 6809

; Load initial memory

read exbug09.bin

; Mark address ranges with ROMs

rom e800 ec00
rom f000 fc00
rom fcfc fd00

; Load device drivers

device exbug_acia fcf4
device exbug_pia fcf8
device exordisk_ii e800
device exordisk_ii_lpt e800

; Default disk images
; These are overridden by the command line

drive0 mdos09.dsk

; Default line-printer file

lpt listing.lp

; 'Facts' file
; These provide symbols and for the dissembler

facts facts09

echo "Done."
