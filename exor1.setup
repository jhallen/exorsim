; Comment

echo "Setup file for EXORdisk-I.."

; Load initial memory

read exbug.bin
l exordisk.s19

; Mark address ranges that are ROMs

rom e800 ec00
rom f000 fc00
rom fcfc fd00

; Load device drivers

device exbug_acia fcf4
device exbug_pia fcf8
device exordisk_i e800
device exordisk_i_lpt_char eab0
device exordisk_i_lpt_crlf_line ead5

; Default disk images
; These are overridden by the command line

drive0 edos.dsk
drive1 edos_blank.dsk

; Default line-printer file

lpt listing.lp

; 'Facts' file
; These provide symbols and for the dissembler

facts facts

echo "Done."
