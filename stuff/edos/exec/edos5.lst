    5                  *
    6                  *ASCII CHARACTER DEFINITIONS
    7                  *
    8      000D        CR     EQU    $0D              ASCII CARRIAGE RETURN <CR>
    9      000A        LF     EQU    $0A              ASCII LINE FEED <LF>
   10      0010        DLE    EQU    $10              ASCII DLE
   11      0020        SPC    EQU    $20              ASCII SPACE
   12      001B        ESC    EQU    $1B              ASCII ESCAPE
   13      001A        ASUB   EQU    $1A              ASCII SUBSTITUTE CHAR
   14      0012        DC2    EQU    $12              ASCII DEVICE CONTROL #2
   15      0014        DC4    EQU    $14              ASCII DEVICE CONTROL #4
   16      00FF        RUB    EQU    $FF              ASCII RUBOUT CHARACTER
   17                  *
   18                  *DEFINITION OF CONSTANTS
   19                  *
   20      0001        LBYT   EQU    $1               DISPLACEMENT TO LOWER BYTE OF 2-BYTE VALUE
   21      0100        HBYT   EQU    $100             DIVISOR TO GENERATE SINGLE UPPER BYTE OF 2-BYTE VALUE
   22                  *
   23      0082        SYSSZ  EQU    130              EDOS IS PERMANENTLY ALLOCATED 130 SECTORS (SYSTEM AREA)
   24      FFFF        TIMAX  EQU    $FFFF            MAXIMUM TIMER COUNT-DOWN PERIOD
