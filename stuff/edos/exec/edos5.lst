  313 032E BD 03C4     USCMD  JSR    CRLF             ESTABLISH NEW LINE ON CONSOLE
  314 0331 86 21              LDAA   #'!              PRINT AN ASCII "!"
  315 0333 BD F018            JSR    PRINC            USER PROMPT CHARACTER
  316 0336 CE 006C            LDX    #IBUF1           SET POINTER TO INPUT BUFFER START
  317 0339 DF BC              STX    BFPT1            INITIALIZE POINTER COPY TO BUFFER START
  318 033B BD 03C8     USCM1  JSR    ECHOC            GET A CONSOLE INPUT CHARACTER
  319 033E 81 7F              CMPA   #$7F             IF NOT AN ASCII RUBOUT OR "BREAK"
  320 0340 27 15              BEQ    USCM3            AND
  321 0342 4D                 TSTA                    NOT AN ASCII NULL
  322 0343 27 1F              BEQ    USCM4            THEN
  323 0345 A7 00              STAA   $0,X             STORE THE CHARACTER
  324 0347 08                 INX                     STEP ON TO THE NEXT BUFFER LOCATION
  325 0348 8C 00BC            CPX    #IBUF1+80        IF BUFFER OVERFLOW
  326 034B 26 03              BNE    USCM2            THEN
  327 034D 7E 0183            JMP    ERRM             TELL USER FORMAT ERROR, WAIT FOR NEW COMMAND
  328 0350 81 0D       USCM2  CMPA   #CR              IF A <CR> CHARACTER
  329 0352 26 E7              BNE    USCM1            THEN
  330 0354 DF BE              STX    BFND1            COMMAND ENDED, COPY END POINT (NOT USED!)
  331 0356 39                 RTS                     RETURN THE COMPLETE COMMAND STRING
  332                  *
  333                  *THIS ROUTINE DELETES CHARACTERS FROM THE COMMAND INPUT BUFFER
  334                  *ECHOING THE CHARACTERS AS THEY ARE DELETED FROM THE BUFFER
  335                  *
  336 0357 8C 006C     USCM3  CPX    #IBUF1           RUBOUT FOUND, IF BUFFER EMPTY
  337 035A 27 D2              BEQ    USCMD            ISSUE NEW PROMPT, START AGAIN
  338 035C 09                 DEX                     ELSE BACK UP POINTER
  339 035D A6 00              LDAA   $0,X             GET THROWN-OUT CHARACTER
  340 035F BD F018            JSR    PRINC            AND PRINT IT
  341 0362 20 D7              BRA    USCM1            GET NEXT INPUT CHARACTER
  342                  *
  343 0364 7E 016E     USCM4  JMP    WTCMD            WAIT FOR NEXT USER COMMAND INPUT
  344                  *
  345                  *
  346                  *THIS ROUTINE PARSES A SINGLE COMMAND OR FILE NAME AND
  347                  *LEAVES IT IN FLNM0-4.  IF A UID WAS SPECIFIED, IT IS LEFT IN FLNM5.
  348                  *
  349 0367 CE 00C0     PRSFL  LDX    #FLNM0           FILL FLNM0-4 WITH
  350 036A 86 20              LDAA   #SPC             ASCII SPACE CHARACTERS
  351 036C C6 05              LDAB   #$5              AS A DEFAULT VALUE
  352 036E A7 00       PRSF1  STAA   $0,X             STORE A SPACE CHARACTER
  353 0370 08                 INX                     STEP ON TO THE NEXT POSITION
  354 0371 5A                 DECB                    WHILE FLNM0 TO FLNM4
  355 0372 26 FA              BNE    PRSF1            CONTINUE
  356 0374 7F 00C5            CLR    FLNM5            SET DEFAULT UNIT ID = 0 (SYS DISK)
  357 0377 CE 00C0            LDX    #FLNM0           START TO TRANSFER IN A COMMAND OR FILE NAME
  358 037A BD 039F     PRSF2  JSR    NXITM            GET A CHARACTER FROM THE STRING
  359 037D 81 3A              CMPA   #':              IF IT IS ASCII ":"
  360 037F 26 14              BNE    NOUID            THEN
  361 0381 BD 039F            JSR    NXITM            GET THE NEXT CHARACTER
  362 0384 80 30              SUBA   #'0              STRIP DECIMAL ASCII TO BINARY
  363 0386 16                 TAB                     COPY THE RESULT IN B
  364 0387 84 FC              ANDA   #$FC             IF INTEGER RESULT IS .LE. 3
  365 0389 26 07              BNE    UIDER            THEN
  366 038B D7 C5              STAB   FLNM5            ACCEPT & STORE UNIT ID
  367 038D BD 039F     PRSF3  JSR    NXITM            GET DELIMITER (COMMA)
  368 0390 20 FB              BRA    PRSF3            OR TERMINATOR <CR>
  369                  *
  370 0392 7E 0183     UIDER  JMP    ERRM             TELL USER FORMAT ERROR, TRY AGAIN
  371                  *
  372 0395 8C 00C5     NOUID  CPX    #FLNM5           IF ROOM IN FIELD
  373 0398 27 E0              BEQ    PRSF2            THEN
  374 039A A7 00              STAA   $0,X             STORE THE CHARACTER
  375 039C 08                 INX                     STEP OVER THE LOCATION
  376 039D 20 DB              BRA    PRSF2            GET THE NEXT CHARACTER
  377                  *
  378                  *THIS ROUTINE PASSES SINGLE CHARACTERS BACK TO PRSFL.  WHEN A DELIMITER
  379                  *(COMMA) OR TERMINATOR <CR> IS FOUND, PRSFL IS TERMINATED (ERSATZ RTS)
  380                  *
  381 039F FF 03B8     NXITM  STX    ITMDX            SAVE CURRENT INDEX REGISTER
  382 03A2 DE BC              LDX    BFPT1            PICK UP SCAN POINTER
  383 03A4 A6 00              LDAA   $0,X             PICK UP A CHARACTER
  384 03A6 81 0D              CMPA   #CR              IF NOT AN ASCII <CR>
  385 03A8 27 0B              BEQ    NXIT1            THEN
  386 03AA 08                 INX                     STEP POINTER TO NEXT CHARACTER
  387 03AB DF BC              STX    BFPT1            STORE THE SCAN POINTER
  388 03AD 81 2C              CMPA   #',              IF NOT A COMMA
  389 03AF 27 04              BEQ    NXIT1            THEN
  390 03B1 FE 03B8            LDX    ITMDX            RESTORE INDEX REGISTER
  391 03B4 39                 RTS                     RETURN THE CHARACTER
  392                  *
  393 03B5 31          NXIT1  INS                     IF CHARACTER COMMA OR <CR>
  394 03B6 31                 INS                     DELETE RETURN ADDRESS
  395 03B7 39                 RTS                     TERMINATE & RETURN FROM PRSFL
  396                  *
  397 03B8             ITMDX  RMB    2                NXITM INDEX SAVE LOCATION
  398                  *
  399                  *
  400                  *THIS ROUTINE PRINTS OUT A STRING OF ASCII CHARACTERS
  401                  *START ADDRESS IS IN X, NUMBER OF CHARACTERS IN B
  402                  *
  403 03BA A6 00       PRINS  LDAA   $0,X             GET A CHARACTER
  404 03BC BD F018            JSR    PRINC            PRINT IT OUT
  405 03BF 08                 INX                     STEP TO NEXT CHARACTER
  406 03C0 5A                 DECB                    WHILE CHARACTERS
  407 03C1 26 F7              BNE    PRINS            CONTINUE
  408 03C3 39                 RTS                     RETURN TO CALLER
  409                  *
  410                  *
  411                  *THIS ROUTINE PRODUCES <CR> <LF> ON THE CONSOLE
  412                  *(ESTABLISH A NEW LINE FOR THE NEXT FUNCTION)
  413                  *
  414 03C4 86 0D       CRLF   LDAA   #CR              DEFINE AN ASCII <CR>
  415 03C6 20 09              BRA    ECHO1            BORROW THE ECHO FUNCTION
  416                  *
  417                  *THIS ROUTINE ECHOS INPUT CHARACTERS, EXCEPT RUBOUT OR "BREAK"
  418                  *THE PARITY BIT IS STRIPPED, AND <CR> IS AMPLIFIED TO <CR> <LF>
  419                  *THE INPUT CHARACTER IS PASSED THROUGH THIS ROUTINE
  420                  *
  421 03C8 BD 03E2     ECHOC  JSR    GETCH            GET AN INPUT CHARACTER
  422 03CB 84 7F              ANDA   #$7F             STRIP OFF THE PARITY BIT
  423 03CD 81 7F              CMPA   #$7F             IF NOT A RUBOUT OR "BREAK"
  424 03CF 27 10              BEQ    ECHO2            THEN
  425 03D1 36          ECHO1  PSHA                    SAVE THE CHARACTER
  426 03D2 BD F018            JSR    PRINC            PRINT THE CHARACTER
  427 03D5 32                 PULA                    RESTORE THE CHARACTER
  428 03D6 81 0D              CMPA   #CR              IF IT IS ASCII <CR>
  429 03D8 26 07              BNE    ECHO2            THEN
  430 03DA 36                 PSHA                    SAVE THE CHARACTER AGAIN
  431 03DB 86 0A              LDAA   #LF              DEFINE AN ASCII <LF>
  432 03DD BD F018            JSR    PRINC            AND DO A CONSOLE LINE FEED
  433 03E0 32                 PULA                    RESTORE THE CHARACTER
  434 03E1 39          ECHO2  RTS                     RETURN TO CALLER
  435                  *
  436                  *
  437                  *THIS ROUTINE LOOPS ON THE ACIA STATUS REGISTER DONE BIT WAITING FOR
  438                  *A CHARACTER.  THE CPU WAITS HERE UNTIL A CHARACTER IS READY.  WHEN
  439                  *A CHARACTER IS PRESENTED, IT IS RETURNED TO CALLER IN A.
  440                  *
  441 03E2 B6 FCF4     GETCH  LDAA   ACIAS            READ THE ACIA STATUS
  442 03E5 47                 ASRA                    IF CHARACTER IS AVAILABLE
  443 03E6 24 FA              BCC    GETCH            THEN
  444 03E8 B6 FCF5            LDAA   ACIAR            READ THE CHARACTER
  445 03EB 0C                 CLC                     CLEAR THE "C" BIT
  446 03EC 39                 RTS                     RETURN THE CHARACTER
  447                  *
  448                  *
  449                  *THIS ROUTINE PERFORMS BINARY TO HEX CONVERSION,
  450                  *AND PRINTS THE RESULT USING THE SWITCHED PRINT
  451                  *VECTOR TO SELECT THE OUTPUT DEVICE.
  452                  *
  453 03ED 97 C9       PRBIN  STAA   HDIGT            COPY THE BINARY DATA
  454 03EF 44                 LSRA                    SHIFT THE 4
  455 03F0 44                 LSRA                    MOST SIGNIFICANT
  456 03F1 44                 LSRA                    BITS INTO A
  457 03F2 44                 LSRA                    BINARY VALUE
  458 03F3 BD 03FD            JSR    PRBN1            PRINT THE VALUE(H)
  459 03F6 96 C9              LDAA   HDIGT            GET THE BINARY DATA
  460 03F8 84 0F              ANDA   #$0F             STRIP OFF THE HIGH DIGIT
  461 03FA 7E 03FD            JMP    PRBN1            PRINT THE VALUE(L) & RETURN
  462                  *
  463 03FD 81 0A       PRBN1  CMPA   #$0A             IF .GE. 9
  464 03FF 2B 02              BMI    PRBN2            THEN
  465 0401 8B 07              ADDA   #$7              SKIP OVER : TO @
  466 0403 8B 30       PRBN2  ADDA   #'0              CONVERT TO ASCII (HEX)
  467 0405 7E 0030            JMP    PRNVC            PRINT, USING SWITCHED PRINT & RETURN
  468                  *
  469                  *
  470                  *THIS ROUTINE READS A FULL DISK SECTOR FROM THE DEFINED
  471                  *UNIT/TRACK/SECTOR, LEAVING THE RESULT BEGINNING AT THE
  472                  *ADDRESS IN X.  SUCCESS RETURN IS A = 0
  473                  *
  474 0408 DF CA       RED11  STX    SECP1            SAVE INDEX REGISTER
  475 040A 37                 PSHB                    SAVE DEFINED TRACK
  476 040B BD EA03            JSR    XUS              TRANSMIT <UNIT><SECTOR> TO DISK
  477 040E BD 046F            JSR    DSKRD            IF DISK IS READY, THEN
  478 0411 32                 PULA                    GET DEFINED TRACK
  479 0412 BD EA2B            JSR    SEEK             SEEK SELECTED UNIT TO DEFINED TRACK
  480 0415 86 05              LDAA   #$5              SET RETRY COUNT FOR 5
  481 0417 B7 0155            STAA   TRYCT            ATTEMPTED RETRIES ON READ ERROR
  482 041A 86 02       RED12  LDAA   #$2              DEFINE READ COMMAND
  483 041C BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  484 041F B6 EC00            LDAA   DKDID            READ THE DISK STATUS
  485 0422 84 80              ANDA   #$80             IF DELETED DATA (DD), REPORT IT
  486 0424 26 18              BNE    RED14            ELSE
  487 0426 B6 EC00            LDAA   DKDID            READ THE DISK STATUS
  488 0429 84 08              ANDA   #$08             IF CRC ERROR
  489 042B 27 17              BEQ    RED15            THEN
  490 042D BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
  491 0430 7A 0155            DEC    TRYCT            DECREMENT TRY COUNTER
  492 0433 26 E5              BNE    RED12            THEN
  493 0435 F6 02D6     MEDER  LDAB   MEDEM            GET CHARACTER COUNT AND POINTER
  494 0438 CE 02D7            LDX    #MEDEM+1         FOR "MEDIA ERROR" MESSAGE
  495 043B 7E 0189            JMP    MSWTC            PRINT IT & WAIT FOR COMMAND INPUT
  496                  *
  497 043E BD EA38     RED14  JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
  498 0441 86 80              LDAA   #$80             DEFINE OPERATION RESULT NON-ZERO, MINUS
  499 0443 39                 RTS                     RETURN TO CALLER (FAILED)
  500                  *
  501 0444 DE CA       RED15  LDX    SECP1            PICK UP THE INDEX POINTER
  502 0446 86 80              LDAA   #$80             DEFINE COUNT OF BYTES IN A FULL SECTOR
  503 0448 B7 0155            STAA   BYTCT            FOR A COUNT (128 BYTES)
  504 044B 86 3C       RED16  LDAA   #$3C             DEFINE DISK COMMAND MODE
  505 044D B7 EC03            STAA   DKCOC            SET DISK TO COMMAND MODE
  506 0450 86 40              LDAA   #$40             DEFINE READ DATA COMMAND
  507 0452 B7 EC02            STAA   DKCOD            COMMAND DISK TO READ
  508 0455 B6 EC00            LDAA   DKDID            READ THE DATA FROM THE IDISK
  509 0458 A7 00              STAA   $00,X            STORE AWAY READ BYTE
  510 045A 86 2C              LDAA   #$2C             DEFINE RESET COMMAND MODE
  511 045C B7 EC03            STAA   DKCOC            RESET DISK FROM COMMAND MODE
  512 045F 86 40              LDAA   #$40             DEFINE READ DATA COMMAND
  513 0461 B7 EC02            STAA   DKCOD            STROBE IN RESET COMMAND MODE
  514 0464 7F EC02            CLR    DKCOD            CLEAR COMMAND OUT OF PIA
  515 0467 08                 INX                     TAKE THE NEXT BYTE
  516 0468 7A 0155            DEC    BYTCT            WHILE BYTES
  517 046B 26 DE              BNE    RED16            CONTINUE
  518 046D 4F                 CLRA                    DEFINE OPERATION RESULT ZERO (SUCCESS)
  519 046E 39                 RTS                     RETURN TO CALLER (SUCCESS)
  520                  *
  521                  *
  522                  *THIS ROUTINE CHECKS ON DISK READY FOR USE.  IF READY,
  523                  *RETURNS TO CALLER, IF NOT READY,  ABORTS OPERATION
  524                  *PRINTS "DISK NOT READY" & WAITS FOR COMMAND
  525                  *
  526 046F B6 EC00     DSKRD  LDAA   DKDID            READ DISK STATUS REGISTER
  527 0472 84 20              ANDA   #$20             IF SELECTED DISK READY
  528 0474 26 01              BNE    DSKR1            THEN
  529 0476 39                 RTS                     RETURN, ELSE
  530 0477 F6 02C7     DSKR1  LDAB   DKNRM            GET CHARACTER COUNT AND POINTER
  531 047A CE 02C8            LDX    #DKNRM+1         FOR "DISK NOT READY" MESSAGE
  532 047D 7E 0189            JMP    MSWTC            PRINT IT, AND WAIT FOR COMMAND INPUT
  533                  *
  534                  *
  535                  *THIS ROUTINE WRITES DATA TO DISK.  DATA IS POINTED TO
  536                  *BY X REGISTER. A FULL SECTOR OF 128 BYTES IS ASSUMED AND
  537                  *WRITTEN.  A WRITE FAILURE RETURNS A = 1, SUCCESS - A = 0.
  538                  *
  539 0480 DF CA       WRTSE  STX    SECP1            SAVE THE DATA POINTER
  540 0482 37                 PSHB                    SAVE THE SELECTED TRACK
  541 0483 BD EA03            JSR    XUS              TRANSMIT <UNIT><SECTOR> TO DISK
  542 0486 BD 046F            JSR    DSKRD            IF DISK IS READY, THEN
  543 0489 32                 PULA                    GET THE SELECTED TRACK
  544 048A BD EA2B            JSR    SEEK             SEEK TO THE SELECTED TRACK
  545 048D 86 05              LDAA   #$5              SET TRY COUNT FOR 5
  546 048F B7 0155            STAA   TRYCT            ATTEMPTED RETRIES ON READ ERROR
  547 0492 DE CA              LDX    SECP1            PICK UP THE DATA POINTER
  548 0494 C6 80              LDAB   #128             DEFINE A SECTOR = 128 DECIMAL BYTES
  549                  *
  550 0496 A6 00       WRTS1  LDAA   0,X              PICK UP A DATA BYTE
  551 0498 B7 EC06            STAA   DKDOD            LOAD DATA TO BUFFER
  552 049B 86 30              LDAA   #$30             DEFINE LOAD COMMAND
  553 049D B7 EC02            STAA   DKCOD            COMMAND BUFFER TO LOAD
  554 04A0 08                 INX                     STEP TO THE NEXT DATA BYTE
  555 04A1 5A                 DECB                    WHILE SECTOR BYTES
  556 04A2 26 F2              BNE    WRTS1            CONTINUE
  557                  *
  558 04A4 86 04       WRTS2  LDAA   #$04             DEFINE WRITE COMMAND
  559 04A6 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  560 04A9 86 06              LDAA   #$06             ASK DISK FOR STATUS
  561 04AB BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  562 04AE B6 EC00            LDAA   DKDID            READ THE REQUESTED STATUS
  563 04B1 84 08              ANDA   #$08             IF THERE WAS A CRC ERROR
  564 04B3 27 0F              BEQ    WRTS3            THEN (SUCCESS EXIT, A = 0)
  565 04B5 BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
  566 04B8 7A 0155            DEC    TRYCT            IF RETRY COUNT RUN OUT
  567 04BB 26 E7              BNE    WRTS2            THEN
  568 04BD 86 0E              LDAA   #$0E             ASK DISK TO MARK THIS SECTOR = DD
  569 04BF BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  570 04C2 86 01              LDAA   #1               FAILURE EXIT, SET A .NE. 0
  571 04C4 39          WRTS3  RTS                     RETURN TO CALLER
  572                  *
  573                  *
  574                  *THIS ROUTINE SEARCHES THE DEFINED DISK DIRECTORY FOR A FILE NAME.
  575                  *IF FOUND, X POINTS TO THE FCB OF THAT FILE IN THE BUFFER, AND A = 0.
  576                  *
  577 04C5 0C          FNDFL  CLC                     CLEAR THE C BIT FOR SHIFT
  578 04C6 96 C5              LDAA   FLNM5            PICK UP CURRENT UNIT ID
  579 04C8 46                 RORA                    SHIFT UID BITS 1,0
  580 04C9 46                 RORA                    INTO BITS 7,6 OF RESULT
  581 04CA 46                 RORA                    BIT 7 BECOMES OLD 1, 6 BECOMES OLD 0
  582 04CB 8A 04              ORAA   #4               START AT SECTOR 4
  583 04CD B7 0150            STAA   USECT            INITIALIZE SEARCH SECTOR VALUE
  584 04D0 B6 0150     FNDF1  LDAA   USECT            PICK UP SEARCH SECTOR VALUE
  585 04D3 84 3F              ANDA   #$3F             STRIP OFF UID
  586 04D5 81 1B              CMPA   #$1B             IF NOT RUN OUT OF SECTORS
  587 04D7 27 42              BEQ    FNDFX            THEN (FAILURE EXIT A .NE. 0)
  588 04D9 CE 00D0            LDX    #SECB1           DEFINE DISK SECTOR BUFFER #1
  589 04DC B6 0150            LDAA   USECT            PICK UP SEARCH SECTOR VALUE
  590 04DF 5F                 CLRB                    ON TRACK 0
  591 04E0 BD 0408            JSR    RED11            READ A DISK SECTOR INTO BUFFER
  592 04E3 4D                 TSTA                    IF NOT SUCCESSFUL
  593 04E4 27 05              BEQ    FNDF2            THEN
  594 04E6 7C 0150            INC    USECT            TRY THE NEXT SECTOR
  595 04E9 20 E5              BRA    FNDF1            WHILE SECTORS LAST
  596 04EB CE 00D0     FNDF2  LDX    #SECB1           START AT BEGINNING OF BUFFER
  597 04EE DF CE              STX    SESP1            INITIALIZE SCAN POINTER
  598 04F0 DE CE       FNDF3  LDX    SESP1            PICK UP SCAN POINTER
  599 04F2 A6 05              LDAA   $5,X             PICK UP THIS FILE'S ATTRIBUTES
  600 04F4 81 FF              CMPA   #$FF             IF THIS IS NOT THE END OF DIRECTORY
  601 04F6 27 23              BEQ    FNDFX            AND (FAILURE EXIT A .NE. 0)
  602 04F8 81 80              CMPA   #$80             IF THIS IS NOT A DELETED FILE
  603 04FA 27 20              BEQ    FNDF4            AND
  604 04FC A6 00              LDAA   $0,X             THE FIRST CHARACTER EQUALS
  605 04FE 91 C0              CMPA   FLNM0            THE FIRST SEARCH CHARACTER
  606 0500 26 1A              BNE    FNDF4            AND
  607 0502 A6 01              LDAA   $1,X             THE SECOND CHARACTER EQUALS
  608 0504 91 C1              CMPA   FLNM1            THE SECOND SEARCH CHARACTER
  609 0506 26 14              BNE    FNDF4            AND
  610 0508 A6 02              LDAA   $2,X             THE THIRD CHARACTER EQUALS
  611 050A 91 C2              CMPA   FLNM2            THE THIRD SEARCH CHARACTER
  612 050C 26 0E              BNE    FNDF4            AND
  613 050E A6 03              LDAA   $3,X             THE FOURTH CHARACTER EQUALS
  614 0510 91 C3              CMPA   FLNM3            THE FOURTH SEARCH CHARACTER
  615 0512 26 08              BNE    FNDF4            AND
  616 0514 A6 04              LDAA   $4,X             THE FIFTH CHARACTER EQUALS
  617 0516 91 C4              CMPA   FLNM4            THE FIFTH SEARCH CHARACTER
  618 0518 26 02              BNE    FNDF4            THEN
  619 051A 4F                 CLRA                    FILE NAME IS FOUND (SUCCESS EXIT A = 0)
  620 051B 39          FNDFX  RTS                     RETURN TO CALLER
  621                  *
  622 051C 86 0B       FNDF4  LDAA   #11              DEFINE DIRECTORY ENTRY SIZE (11 BYTES / ENTRY)
  623 051E 5F                 CLRB                    ALLOWING A HIGH BYTE OF 0
  624 051F 9B CF              ADDA   SESP1+LBYT       ADD ENTRY SIZE TO CURRENT
  625 0521 D9 CE              ADCB   SESP1            BUFFER SCAN POINTER (2 BYTE ADD)
  626 0523 97 CF              STAA   SESP1+LBYT       UPDATE THE BUFFER SCAN POINTER
  627 0525 D7 CE              STAB   SESP1            MODULO <ENTRY SIZE>
  628 0527 DE CE              LDX    SESP1            IF THE BUFFER HAS
  629 0529 8C 0149            CPX    #SECB1+121       NO MORE DIRECTORY ENTRIES
  630 052C 26 C2              BNE    FNDF3            THEN
  631 052E 7C 0150            INC    USECT            TRY THE NEXT SECTOR
  632 0531 20 9D              BRA    FNDF1            AND KEEP LOOKING
  633                  *
  634                  *
  635                  *THIS ROUTINE SETS UP AN INPUT FILE ON THE FILE DEFINITION LOCATIONS.
  636                  *IF NO FILE, FAILURE IS REPORTED.  SUCCESS - A = 0, FAILURE - A .NE. 0
  637                  *
  638 0533 BD 04C5     DFINF  JSR    FNDFL            LOOK FOR THIS FILE NAME IN THE DIRECTORY
  639 0536 4D                 TSTA                    IF IT DOES NOT EXIST
  640 0537 27 01              BEQ    DFIN1            THEN
  641 0539 39                 RTS                     FAILURE EXIT A .NE. 0
  642 053A DE CE       DFIN1  LDX    SESP1            GET FILE CONTROL BLOCK ADDRESS
  643 053C E6 06              LDAB   $6,X             USE DESCRIPTOR "TRACK"
  644 053E D7 06              STAB   ITRK             TO DEFINE ITRK
  645 0540 E6 08              LDAB   $8,X             USE DESCRIPTOR SIZE(H)
  646 0542 D7 04              STAB   ISIZE            TO DEFINE ISIZE(H)
  647 0544 E6 09              LDAB   $9,X             USE DESCRIPTOR SIZE(L)
  648 0546 D7 05              STAB   ISIZE+1          TO DEFINE ISIZE(L)
  649 0548 7F 0008            CLR    ICNTR            CLEAR INPUT FILE BYTE COUNTER
  650 054B D6 C5              LDAB   FLNM5            PICK UP CURRENT UNIT ID
  651 054D 0C                 CLC                     CLEAR "C" FOR SHIFTING
  652 054E 56                 RORB                    SHIFT UID BITS 1,0
  653 054F 56                 RORB                    INTO BITS 7,6
  654 0550 56                 RORB                    7 BECOMES OLD 1, 6 BECOMES OLD 0
  655 0551 EA 07              ORAB   $7,X             OR IN SECTOR NUMBER FROM DESCRIPTOR
  656 0553 5A                 DECB                    MINUS ONE
  657 0554 D7 07              STAB   ISCTR            STORE IN ISCTR
  658 0556 0C                 CLC                     CLEAR "C" FOR REVERSE SHIFT
  659 0557 59                 ROLB                    SHIFT UID BITS BACK INTO BITS 1,0
  660 0558 59                 ROLB                    SECTOR NUMBER GOES INTO
  661 0559 59                 ROLB                    BITS 6-2 OF RESULT
  662 055A D7 03              STAB   IUNIT            STORE COMBINED RESULT IN IUNIT
  663 055C 4F                 CLRA                    CLEAR A, SIGNALING SUCCESS
  664 055D 39                 RTS                     RETURN TO CALLER
  665                  *
  666                  *
  667                  *
  668                  *
  669                  *THIS ROUTINE IS SIMILAR TO DFINF.  IF CALLED, IT WOULD DEFINE AN
  670                  *OUTPUT FILE IN THE OUTPUT FILE DEFINITION LOCATIONS.  IT DOES NOT
  671                  *APPEAR TO BE USED.  AN EXISTING FILE WILL BE PRECISELY OVERWRITTEN
  672                  *IF IT IS CALLED, WITH NO CHANGE IN FILE SIZE.
  673                  *
  674 055E BD 04C5     DFOFL  JSR    FNDFL            LOOK FOR THIS FILE NAME IN THE DIRECTORY
  675 0561 4D                 TSTA                    IF IT DOES NOT EXIST
  676 0562 27 01              BEQ    DFOF1            THEN
  677 0564 39                 RTS                     FAILURE EXIT A .NE. 0
  678 0565 DE CE       DFOF1  LDX    SESP1            GET FILE CONTROL BLOCK ADDRESS
  679 0567 E6 06              LDAB   $6,X             USE DESCRIPTOR "TRACK"
  680 0569 D7 0B              STAB   OTRK             TO DEFINE OTRK
  681 056B E6 08              LDAB   $8,X             USE DESCRIPTOR "SIZE"
  682 056D A6 09              LDAA   $9,X             (2 BYTES)
  683 056F 80 01              SUBA   #$1              MINUS 1 SECTOR
  684 0571 C2 00              SBCB   #$0              (2 BYTES)
  685 0573 D7 09              STAB   OSIZE            TO DEFINE OSIZE
  686 0575 97 0A              STAA   OSIZE+LBYT       (2 BYTES)
  687 0577 7F 000D            CLR    OCNTR            CLEAR OUTPUT FILE BYTE COUNTER
  688 057A D6 C5              LDAB   FLNM5            PICK UP UNIT I/D
  689 057C D7 02              STAB   OUNIT            AND DEFINE OUNIT
  690 057E 0C                 CLC                     CLEAR "C" FOR SHIFTING
  691 057F 56                 RORB                    SHIFT UID BITS 1,0
  692 0580 56                 RORB                    INTO BITS 7,6
  693 0581 56                 RORB                    7 BECOMES OLD 1, 6 BECOMES OLD 0
  694 0582 EA 07              ORAB   $7,X             OR IN SECTOR NUMBER FROM DESCRIPTOR
  695 0584 D7 0C              STAB   OSCTR            WHICH DEFINES OSCTR
  696 0586 4F                 CLRA                    CLEAR A, SIGNALLING SUCCESS
  697 0587 39                 RTS                     RETURN TO CALLER
  698                  *
  699                  *
  700                  *
  701                  *THIS ROUTINE ATTEMPTS TO CREATE A FILE ENTRY IN THE DIRECTORY
  702                  *VARIOUS RETURN FLAGS EXIST. THEY ARE ASSIGNED AS FOLLOWS:
  703                  *A = 0 SUCCESS, FILE CREATED IN DIRECTORY
  704                  *A = 1 FAILURE, NO ROOM LEFT IN DIRECTORY
  705                  *A = 2 FAILURE, THIS FILE NAME ALREADY EXISTS
  706                  *A = 3 FAILURE, NOT ENOUGH ROOM ON THE DISK
  707                  *
  708 0588 BD 04C5     CREAF  JSR    FNDFL            SEARCH FOR FILE NAME (DUPLICATE) IN DIRECTORY
  709 058B 4D                 TSTA                    IF DUPLICATE FILE NAME IS FOUND
  710 058C 26 03              BNE    CREA1            THEN
  711 058E 86 02              LDAA   #$2              DEFINE FLAG VALUE = DUPLICATE FILE
  712 0590 39                 RTS                     AND RETURN (FAILURE)
  713 0591 81 FF       CREA1  CMPA   #$FF             IF DIRECTORY IS FULL (NO EOD MARK)
  714 0593 27 03              BEQ    CREA2            THEN
  715 0595 86 01              LDAA   #$1              DEFINE FLAG VALUE = NO ROOM
  716 0597 39                 RTS                     AND RETURN (FAILURE)
  717 0598 DE CE       CREA2  LDX    SESP1            LOAD SCAN POINTER
  718 059A 86 1A              LDAA   #26              THERE ARE 26 SECTORS PER TRACK
  719 059C B7 0155            STAA   SECCT            PREPARE TO COUNT BY <SECTOR><TRACK>
  720 059F 4F                 CLRA                    STARTING FROM
  721 05A0 5F                 CLRB                    0, COUNT OFF SECTOR MODULUS
  722 05A1 AB 06       CREA3  ADDA   $6,X             TIMES THE TRACKS
  723 05A3 C9 00              ADCB   #$0              ALREADY USED
  724 05A5 7A 0155            DEC    SECCT            GIVING THE NO. OF SECTORS
  725 05A8 26 F7              BNE    CREA3            ALREADY USED (TO THIS TRACK)
  726 05AA AB 07              ADDA   $7,X             THEN ADD THE SECTORS ALREADY USED ON
  727 05AC C9 00              ADCB   #$0              THIS TRACK, GIVING SECTORS USED (TOTAL)
  728 05AE B7 0156            STAA   SECCT+1          PUT AWAY THE CALCULATED
  729 05B1 F7 0155            STAB   SECCT            NUMBER OF SECTORS ALREADY USED
  730 05B4 CE 07D0            LDX    #2000            THERE ARE 2000 SECTORS AVAILABLE ON THE DISK
  731 05B7 DF CA              STX    SECAV            CALCULATE
  732 05B9 D6 CA              LDAB   SECAV            THAT THE
  733 05BB 96 CB              LDAA   SECAV+1          AVAILABLE SECTORS
  734 05BD B0 0156            SUBA   SECCT+1          MINUS THE USED
  735 05C0 F2 0155            SBCB   SECCT            SECTORS GIVES THE FREE SECTORS
  736 05C3 D7 CA              STAB   SECAV            SAVE THE NEW
  737 05C5 97 CB              STAA   SECAV+1          FREE SECTORS
  738 05C7 90 C8              SUBA   FILRQ+1          SUBTRACT THE NEW FILE'S SECTOR REQUIREMENT
  739 05C9 D2 C7              SBCB   FILRQ            IF NOT ENOUGH SECTORS ARE FREE
  740 05CB 2A 05              BPL    CREA4            THEN
  741 05CD DE CA              LDX    SECAV            DEFINE HOW MANY SECTORS ARE AVAILABLE
  742 05CF 86 03              LDAA   #$3              FLAG "NOT ENOUGH ROOM ON DISK"
  743 05D1 39                 RTS                     RETURN TO CALLER (FAILURE)
  744                  *
  745                  *FILE IS PERMISSIBLE, CREATE THE DIRECTORY ENTRY
  746                  *
  747 05D2 DE CE       CREA4  LDX    SESP1            PICK UP THE POINTER TO CURRENT E.O.D. FCB
  748 05D4 96 C0              LDAA   FLNM0            CONVERT THE CURRENT END-OF-DIRECTORY
  749 05D6 A7 00              STAA   $0,X             FILE CONTROL BLOCK INTO A DIRECTORY
  750 05D8 96 C1              LDAA   FLNM1            ENTRY FOR THE REQUESTED FILE
  751 05DA A7 01              STAA   $1,X             BY TRANSFERRING THE REQUESTED
  752 05DC 96 C2              LDAA   FLNM2            FILE NAME INTO THE CURRENT FCB
  753 05DE A7 02              STAA   $2,X             AS IT RESIDES IN THE SECTOR BUFFER.
  754 05E0 96 C3              LDAA   FLNM3            (A NEW END-OF-DIRECTORY
  755 05E2 A7 03              STAA   $3,X             FILE CONTROL BLOCK MUST BE
  756 05E4 96 C4              LDAA   FLNM4            CREATED TO REPLACE THIS ONE)
  757 05E6 A7 04              STAA   $4,X             LAST NAME CHARACTER, NOW
  758                  *
  759 05E8 96 C6       WTNDX  LDAA   FILAT            LOAD REQUESTED FILE ATTRIBUTE
  760 05EA A7 05              STAA   5,X              INTO "ATTRIBUTE" IN FCB
  761 05EC D6 C7              LDAB   FILRQ            PICK UP REQUESTED FILE SIZE
  762 05EE 96 C8              LDAA   FILRQ+1          IN SECTORS TO BE WRITTEN
  763 05F0 8B 01              ADDA   #1               ADD 1, TO ALLOW FOR A POSSIBLE
  764 05F2 C9 00              ADCB   #0               SECTOR OVERFLOW
  765 05F4 E7 08              STAB   8,X              SET THIS ALLOCATION INTO THE
  766 05F6 A7 09              STAA   9,X              FILE LENGTH IN FCB TEMPLATE
  767 05F8 E6 06              LDAB   6,X              LOAD START TRACK FROM OLD FCB
  768 05FA A6 07              LDAA   7,X              LOAD START SECTOR FROM OLD FCB
  769 05FC F7 0153            STAB   STRAK            SAVE THE TRACK
  770 05FF B7 0154            STAA   STSEC            SAVE THE SECTOR
  771 0602 DE C7              LDX    FILRQ            IF THE SECTORS REQUIRED
  772 0604 8C 0000            CPX    #$0              ARE DEFINED AS 0
  773 0607 26 07              BNE    WTND1            THEN
  774 0609 08                 INX                     ALLOCATE ONE SECTOR
  775 060A DF C7              STX    FILRQ            AS A MINIMUM REQUEST
  776 060C DE CE              LDX    SESP1            GET THE SECTOR BUFFER POINTER
  777 060E 20 D8              BRA    WTNDX            ALLOCATE THE 1 SECTOR MINIMUM
  778                  *
  779 0610 8C 0000     WTND1  CPX    #$0              IF ALLOCATION IS NOT COMPLETE
  780 0613 27 0B              BEQ    WTND3            THEN
  781 0615 4C                 INCA                    TAKE THE NEXT SECTOR
  782 0616 81 1B              CMPA   #27              IF NO MORE SECTORS
  783 0618 26 03              BNE    WTND2            THEN
  784 061A 5C                 INCB                    TAKE THE NEXT TRACK
  785 061B 86 01              LDAA   #$1              SECTOR NUMBER 1
  786 061D 09          WTND2  DEX                     COUNT OFF THIS SECTOR, IF ALL GONE
  787 061E 26 F0              BNE    WTND1            THEN
  788 0620 F7 0151     WTND3  STAB   CRTRK            SAVE THE NEW START TRACK
  789 0623 B7 0152            STAA   CRSEC            AND NEW START SECTOR
  790 0626 DE CE              LDX    SESP1            IF NEW FCB & EOD FCB
  791 0628 8C 013E            CPX    #SECB1+110       WILL NOT FIT IN THIS SECTOR
  792 062B 26 26              BNE    WTND6            THEN
  793                  *
  794 062D 5F          WTND4  CLRB                    SELECT TRACK 0
  795 062E B6 0150            LDAA   USECT            USING THE CURRENT SECTOR
  796 0631 CE 00D0            LDX    #SECB1           AND SECTOR BUFFER
  797 0634 BD 0480            JSR    WRTSE            WRITE THE SECTOR BUFFER TO DISK
  798 0637 4D                 TSTA                    IF WRITE WAS NOT SUCCESSFUL
  799 0638 27 0F              BEQ    WTND5            THEN
  800 063A 7C 0150            INC    USECT            TAKE THE NEXT SECTOR
  801 063D F6 0150            LDAB   USECT            IF THIS SECTOR
  802 0640 C4 3F              ANDB   #$3F             WITH THE UNIT ID STRIPPED
  803 0642 C1 1B              CMPB   #27              IS THE LAST SECTOR
  804 0644 26 E7              BNE    WTND4            THEN
  805 0646 7E 0435            JMP    MEDER            REPORT "MEDIA ERROR" & WAIT FOR NEW COMMAND
  806                  *
  807                  *CURRENT SECTOR HAS NO ROOM FOR EOD, OPEN NEXT SECTOR
  808                  *
  809 0649 CE 00D0     WTND5  LDX    #SECB1           INITIALIZE THE SECTOR BUFFER POINTER
  810 064C DF CE              STX    SESP1            TO THE START OF THE SECTOR BUFFER
  811 064E 7C 0150            INC    USECT            TAKE THE NEXT SECTOR
  812 0651 20 0B              BRA    WTND7            AND PUT AN E.O.D. FCB THERE
  813                  *
  814                  *PUT AN E.O.D. FILE CONTROL BLOCK IN THE CURRENT SECTOR
  815                  *
  816 0653 5F          WTND6  CLRB                    DEFINE THE NUMBER OF
  817 0654 86 0B              LDAA   #11              BYTES IN A FILE CONTROL BLOCK = 11
  818 0656 9B CF              ADDA   SESP1+LBYT       USE THIS NUMBER TO
  819 0658 D9 CE              ADCB   SESP1            STEP OVER THE CURRENT
  820 065A 97 CF              STAA   SESP1+LBYT       FILE CONTROL BLOCK
  821 065C D7 CE              STAB   SESP1            AND ACCESS THE NEXT ONE
  822 065E DE CE       WTND7  LDX    SESP1            LOAD SECTOR BUFFER POINTER
  823 0660 C6 05              LDAB   #$5              CREATE A FILE NAME OF FIVE
  824 0662 86 2A              LDAA   #'*              ASCII ASTERISK CHARACTERS
  825                  *
  826 0664 A7 00       WTND8  STAA   0,X              STORE A CHARACTER
  827 0666 08                 INX                     IN THE NAME FIELD
  828 0667 5A                 DECB                    WHILE NAME FIELD
  829 0668 26 FA              BNE    WTND8            CONTINUE
  830                  *
  831 066A 86 FF              LDAA   #$FF             DEFINE ATTRIBUTE CHARACTER AS
  832 066C A7 00              STAA   0,X              END OF DIRECTORY MARK
  833 066E 08                 INX                     IN THE ATTRIBUTE FIELD
  834 066F B6 0151            LDAA   CRTRK            SET THIS FILE'S START TRACK
  835 0672 A7 00              STAA   0,X              AS "TRACK"
  836 0674 08                 INX                     IN THE TRACK FIELD
  837 0675 B6 0152            LDAA   CRSEC            SET THIS FILE'S START SECTOR
  838 0678 A7 00              STAA   0,X              AS "SECTOR"
  839 067A 5F          WTND9  CLRB                    SELECT TRACK 0
  840 067B B6 0150            LDAA   USECT            USING THE CURRENT SECTOR
  841 067E 84 3F              ANDA   #$3F             MASK OFF THE UNIT ID
  842 0680 81 1B              CMPA   #27              IF SECTORS HAVE RUN OUT
  843 0682 26 03              BNE    WTNDA            THEN
  844 0684 7E 0435     MEDE1  JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
  845                  *
  846 0687 B6 0150     WTNDA  LDAA   USECT            USING THE CURRENT SECTOR
  847 068A CE 00D0            LDX    #SECB1           AND THE CURRENT SECTOR BUFFER LOAD
  848 068D BD 0480            JSR    WRTSE            WRITE THIS SECTOR TO DISK
  849 0690 4D                 TSTA                    IF THE WRITE WAS SUCCESFUL
  850 0691 26 01              BNE    WTNDB            THEN
  851 0693 39                 RTS                     RETURN TO CALLER (SUCCESS)
  852                  *
  853 0694 7C 0150     WTNDB  INC    USECT            TAKE THE NEXT SECTOR
  854 0697 20 E1              BRA    WTND9            AND TRY AGAIN
  855                  *
  856                  *
  857                  *
  858                  *
  859                  *THIS ROUTINE CLOSES ANY OPEN FILES, AND RETURNS TO
  860                  *LOOK FOR THE NEXT USER INPUT COMMAND STRING
  861                  *
  862 0699 0F          FLCLS  SEI                     RUN THE CPU NON-INTERRUPTABLE
  863 069A 8E 006B            LDS    #EXSTK           REINITIALIZE EDOS STACK
  864 069D 7D 0001            TST    OFILE            IF THERE IS NO OUTPUT FILE CURRENTLY OPEN
  865 06A0 26 03              BNE    FLCL2            THEN
  866 06A2 7E 016E     FLCL1  JMP    WTCMD            WAIT FOR NEW COMMAND
  867                  *
  868 06A5 7D 000D     FLCL2  TST    OCNTR            IF WRITE BUFFER IS NOT FULL
  869 06A8 27 06              BEQ    FLCL3            THEN
  870 06AA 4F                 CLRA                    USING NULL FILL CHARACTERS
  871 06AB BD E80C            JSR    XWRT             PAD BUFFER
  872 06AE 20 F5              BRA    FLCL2            UNTIL FULL
  873                  *
  874 06B0 CE 0000     FLCL3  LDX    #0               CREATE A NULL FILE NAME
  875 06B3 DF C0              STX    FLNM0            (PREVENTING A MATCH
  876 06B5 DF C2              STX    FLNM2            THEREBY FINDING
  877 06B7 DF C3              STX    FLNM3            END OF DIRECTORY)
  878 06B9 96 02              LDAA   OUNIT            DEFINE NULL FILE AS ON THE CURRENT UNIT
  879 06BB 97 C5              STAA   FLNM5            (LOOK FOR EOD ON UNIT HAVING OPEN FILE)
  880 06BD 4F                 CLRA                    DEFINE AN ATTRIBUTE OF 0
  881 06BE 97 C6              STAA   FILAT            IN THE ATTRIBUTE LOCATION
  882 06C0 BD 04C5            JSR    FNDFL            TURN TO LAST ENTRY IN DIRECTORY
  883 06C3 81 FF              CMPA   #$FF             IF IT IS END OF DIRECTORY MARK
  884 06C5 26 BD              BNE    MEDE1            THEN
  885 06C7 DE CE              LDX    SESP1            AT CURRENT SCAN POSITION IN SECTOR BUFFER
  886 06C9 A6 09              LDAA   9,X              GET THE "FREE SPACE" VALUE FROM
  887 06CB E6 08              LDAB   8,X              THE CURRENT EOD RECORD
  888 06CD 80 01              SUBA   #1               SUBTRACT ONE SECTOR
  889 06CF C2 00              SBCB   #0               TO BE HELD AS A SPARE
  890 06D1 90 0A              SUBA   OSIZE+LBYT       SUBTRACT SIZE OF FILE JUST
  891 06D3 D2 09              SBCB   OSIZE            WRITTEN (FILE NOW BEING CLOSED)
  892 06D5 97 C8              STAA   FILRQ+1          STORE SIZE OF NEW FREE SPACE
  893 06D7 D7 C7              STAB   FILRQ            (NUMBER OF SECTORS NOW AVAILABLE ON DISK)
  894 06D9 BD 05E8            JSR    WTNDX            REWRITE THE DISK DIRECTORY
  895 06DC 20 C4              BRA    FLCL1            RETURN TO MONITOR, WAIT FOR NEXT COMMAND
  896                  *
  897                  *THIS ROUTINE LOADS A USER OBJECT FILE, OR PROGRAM FROM
  898                  *THE DISK.  IF REQUIRED, THE USER MUST START IT, USING MAID
  899                  *
  900 06DE CE E815     LOAD   LDX    #PROG            LOAD VECTOR TO PROGRAM LOADER IN EDOS ROM
  901 06E1 FF 06FA            STX    LOADV            MODIFY JUMP INSTRUCTION FOR PROGRAM LOADER
  902 06E4 BD 0367     LOAD1  JSR    PRSFL            PARSE FILE NAME TO BE LOADED
  903 06E7 BD 0533            JSR    DFINF            SET UP POINTERS TO FILE
  904 06EA 4D                 TSTA                    IF FILE DOES NOT EXIST (DEFINITION FAILED)
  905 06EB 27 09              BEQ    LOAD2            THEN
  906 06ED F6 028C     NOSFL  LDAB   NOSFM            DEFINE CHARACTER COUNT AND POINTER
  907 06F0 CE 028D            LDX    #NOSFM+1         FOR "NO SUCH FILE" MESSAGE
  908 06F3 7E 0189            JMP    MSWTC            PRINT IT & WAIT FOR NEW COMMAND
  909                  *
  910 06F6 8E FF8A     LOAD2  LDS    #EXBST           SWITCH TO EXBUG STACK SPACE
  911 06F9 7E E815            JMP    PROG             PULL IN THE PROGRAM, START EXBUG
  912      06FA        LOADV  EQU    *-2              SELF-MODIFIED JUMP ADDRESS FOR LOADER FUNCTION
  913                  *
  914                  *PULL IN RELOCATING LOADER & START IT RUNNING (SYSTEM FUNCTION)
  915                  *
  916 06FC CE E824     RLOAD  LDX    #EDITR           LOAD VECTOR FOR LOAD & GO LOADER (START = 20)
  917 06FF FF 06FA            STX    LOADV            MODIFY JUMP INSTRUCTION FOR LOAD & GO
  918 0702 CE 006C            LDX    #IBUF1           BACK UP TO GET FILENAME "RLOAD"
  919 0705 DF BC              STX    BFPT1            REDO THE COMMAND AS A FILENAME
  920 0707 7E 06E4            JMP    LOAD1            USING PRSFL,DFINF & LOADER
  921                  *
  922                  *
  923                  *THIS GROUP OF ROUTINES LIST A FILE, USING VARIOUS OUTPUT DEVICES
  924                  *
  925 070A CE F018     CLIST  LDX    #PRINC           DEFINE CONSOLE O/P ROUTINE
  926 070D 20 03              BRA    LIST1            LIST THE FILE USING IT
  927 070F CE EAB0     PLIST  LDX    #LPTC            DEFINE LINE PRINTER O/P ROUTINE
  928 0712 DF 31       LIST1  STX    PRNVC+1          STORE SELECTED O/P ROUTINE ADDRESS
  929 0714 7F 0F06            CLR    NULCT            CLEAR NULL COUNTER
  930 0717 BD 0367            JSR    PRSFL            LOAD FILE NAME AND UID TO FLNM0-5
  931 071A BD 0533            JSR    DFINF            FIND AND DEFINE FILE FOR READ
  932 071D 4D                 TSTA                    IF NO FILE FOUND
  933 071E 27 03              BEQ    LIST2            THEN
  934 0720 7E 06ED            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
  935 0723 BD E809     LIST2  JSR    XRI              READ A 8-BIT BYTE FROM DISK
  936 0726 25 0C              BCS    LIST4            IF NOT EOF, THEN
  937 0728 84 7F              ANDA   #$7F             STRIP THE PARITY BIT
  938 072A 27 0B              BEQ    LIST5            IF NOT A NULL, THEN
  939 072C 7F 0F06            CLR    NULCT            CLEAR NULL COUNTER
  940 072F BD 0030     LIST3  JSR    PRNVC            OUTPUT THE CHARACTER ON THE DEFINED DEVICE
  941 0732 20 EF              BRA    LIST2            READ THE NEXT BYTE
  942                  *
  943 0734 7E 016E     LIST4  JMP    WTCMD            WAIT FOR NEW COMMAND
  944                  *
  945 0737 7D 0F06     LIST5  TST    NULCT            IF PREVIOUS CHAR NOT NULL
  946 073A 26 E7              BNE    LIST2            THEN
  947 073C 7C 0F06            INC    NULCT            RECORD THIS NULL
  948 073F 20 EE              BRA    LIST3            AND PRINT IT
  949                  *
  950                  *
  951                  *THIS FUNCTION ALLOWS THE USER TO CHANGE FILE ATTRIBUTES
  952                  *
  953 0741 BD 0367     ATTR   JSR    PRSFL            LOAD FILE NAME & UID TO FLNM0-5
  954 0744 BD 04C5            JSR    FNDFL            FIND THE REFERENCED FILE DIRECTORY ENTRY
  955 0747 4D                 TSTA                    IF NO SUCH FILE EXISTS
  956 0748 27 03              BEQ    ATTR1            THEN
  957 074A 7E 06ED            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
  958 074D BD 0367     ATTR1  JSR    PRSFL            LOAD NEW ATTRIBUTE TO FLNM0
  959 0750 CE 00C0            LDX    #FLNM0           POINT X TO THE NEW ATTRIBUTE (FLNM0)
  960 0753 BD 0766            JSR    CONHX            CONVERT INPUT ATTRIBUTE STRING TO BINARY
  961 0756 DE CE              LDX    SESP1            RESTORE THE SECTOR BUFFER POINTER
  962 0758 96 CB              LDAA   BINLO            GET THE CONVERTED NEW ATTRIBUTE
  963 075A 81 FF              CMPA   #$FF             END-OF-DIRECTORY IS FORBIDDEN, IF ANYTHING ELSE
  964 075C 27 05              BEQ    ATTR2            THEN
  965 075E A7 05              STAA   $5,X             STORE THE NEW ATTRIBUTE IN THE FCB
  966 0760 7E 07E9            JMP    RENA4            AND REWRITE THE SECTOR TO DISK
  967                  *
  968 0763 7E 0183     ATTR2  JMP    ERRM             CAN'T ALLOW BLOCKING OFF THE DISK, ERROR!!!
  969                  *
  970                  *
  971                  *THIS ROUTINE CONVERTS ASCII TO HEX
  972                  *
  973 0766 7F 00CA     CONHX  CLR    BINHI            CLEAR OUT THE BINARY SCRATCH
  974 0769 7F 00CB            CLR    BINLO            LOCATIONS, PREPARING TO PACK IN HEX DIGITS
  975 076C A6 00       CONH1  LDAA   $0,X             PICK UP THE CURRENT DIGIT
  976 076E BD 0779            JSR    CNHXS            CONVERT & PACK A HEX DIGIT
  977 0771 24 03              BCC    CONH2            IF HEX - BIN CONVERSION TERMINATED, THEN
  978 0773 DE CC              LDX    BFOP2            PICK UP X FROM BFOP2
  979 0775 39                 RTS                     AND RETURN, CONVERSION COMPLETE
  980                  *
  981 0776 08          CONH2  INX                     ELSE POINT TO THE NEXT DIGIT
  982 0777 20 F3              BRA    CONH1            WHILE DIGITS, CONTINUE
  983                  *
  984 0779 80 30       CNHXS  SUBA   #'0              IF .GE. ASCII 0
  985 077B 25 26              BCS    CNHS2            AND
  986 077D 8B E9              ADDA   #$E9             .LE. ASCII F
  987 077F 25 22              BCS    CNHS2            THEN
  988 0781 8B 06              ADDA   #$6              IF .LT. ASCII A
  989 0783 2A 04              BPL    CNHS1            CHECK
  990 0785 8B 07              ADDA   #$7              IF NOT ASCII : TO @
  991 0787 25 1A              BCS    CNHS2            THEN
  992 0789 8B 0A       CNHS1  ADDA   #$A              COMPLETE BINARY CONVERSION
  993 078B 0C                 CLC                     (CLEAR C TO PATCH ERROR)
  994 078C 25 15              BCS    CNHS2            (PROGRAM ERROR-BRANCH NEVER TAKEN)
  995 078E 97 C9              STAA   HDIGT            SAVE THE 4-BIT HEX DIGIT
  996 0790 D6 CA              LDAB   BINHI            PICK UP THE BINARY
  997 0792 96 CB              LDAA   BINLO            STRING IN PROCESS
  998 0794 48                 ASLA                    SHIFT IN A 0 BIT
  999 0795 59                 ROLB                    4 TIMES, DOUBLE
 1000 0796 48                 ASLA                    PRECISION, TO
 1001 0797 59                 ROLB                    PREPARE A HOLE
 1002 0798 48                 ASLA                    FOR THE NEW HEX DIGIT
 1003 0799 59                 ROLB                    THE PACK IS RIGHT JUSTIFIED
 1004 079A 48                 ASLA                    IF MORE THAN 4 DIGITS ARE
 1005 079B 59                 ROLB                    INPUT, THE 4 LEAST SIGNIFICANT WILL BE USED
 1006 079C 9B C9              ADDA   HDIGT            PACK IN 4 BIT BINARY
 1007 079E D7 CA              STAB   BINHI            STORE PACKED BINARY (H)
 1008 07A0 97 CB              STAA   BINLO            STORE PACKED BINARY (L)
 1009 07A2 0C                 CLC                     CLEAR C SHOWING SUCCESS (PACK STILL IN PROGRESS)
 1010 07A3 39          CNHS2  RTS                     RETURN TO CALLER
 1011                  *
 1012                  *
 1013                  *THIS FUNCTION RENAMES AN EXISTING FILE.  THE ONLY EFFECT
 1014                  *IS TO CHANGE THE NAME FIELD IN THE SPECIFIED FILE'S FCB.
 1015                  *
 1016 07A4 BD 0367     RENAM  JSR    PRSFL            PARSE OLD FILE NAME
 1017 07A7 96 C5              LDAA   FLNM5            AND ACCEPT THE UNIT NUMBER
 1018 07A9 97 C9              STAA   UNUMB            COMMIT TO THIS UNIT NUMBER
 1019 07AB BD 0367            JSR    PRSFL            PARSE NEW FILE NAME
 1020 07AE 96 C9              LDAA   UNUMB            BUT USE OLD UNIT NUMBER
 1021 07B0 97 C5              STAA   FLNM5            TO FORCE CONSISTENT FILE UID
 1022 07B2 BD 04C5            JSR    FNDFL            LOOK TO SEE IF THIS NAME ALREADY EXISTS
 1023 07B5 4D                 TSTA                    IF IT DOES NOT EXIST
 1024 07B6 27 60              BEQ    DUPNM            THEN
 1025 07B8 CE 006C            LDX    #IBUF1           START ACTION PASS ON COMMAND STRING
 1026 07BB DF BC              STX    BFPT1            REINITIALIZE COMMAND STRING POINTER
 1027 07BD BD 0367            JSR    PRSFL            STEP OVER "RENAM" COMMAND
 1028 07C0 BD 0367            JSR    PRSFL            PARSE THE FILE NAME TO BE CHANGED
 1029 07C3 BD 04C5            JSR    FNDFL            FIND THE FILE TO BE CHANGED
 1030 07C6 4D                 TSTA                    IF IT DOES NOT EXIST
 1031 07C7 27 03              BEQ    RENA2            THEN
 1032 07C9 7E 06ED     RENA1  JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 1033                  *
 1034 07CC BD 0367     RENA2  JSR    PRSFL            PARSE THE NEW FILE NAME
 1035 07CF DE CE              LDX    SESP1            POINT TO THE FILE FCB IN SECTOR BUFFER #1
 1036 07D1 96 C0              LDAA   FLNM0            IF THE FIRST CHARACTER OF THE NEW NAME
 1037 07D3 81 20              CMPA   #SPC             IS A SPACE, THE NEW NAME IS ILLEGAL
 1038 07D5 27 F2              BEQ    RENA1            ELSE,
 1039 07D7 A7 00              STAA   $0,X             STORE THE FIRST CHARACTER IN THE FCB
 1040 07D9 96 C1              LDAA   FLNM1            GET THE SECOND CHARACTER
 1041 07DB A7 01              STAA   $1,X             STORE THE SECOND CHARACTER IN THE FCB
 1042 07DD 96 C2              LDAA   FLNM2            GET THE THIRD CHARACTER
 1043 07DF A7 02              STAA   $2,X             STORE THE THIRD CHARACTER IN THE FCB
 1044 07E1 96 C3              LDAA   FLNM3            GET THE FOURTH CHARACTER
 1045 07E3 A7 03              STAA   $3,X             STORE THE FOURTH CHARACTER IN THE FCB
 1046 07E5 96 C4              LDAA   FLNM4            GET THE FIFTH CHARACTER
 1047 07E7 A7 04              STAA   $4,X             STORE THE FIFTH CHARACTER IN THE FCB
 1048 07E9 5F          RENA4  CLRB                    SELECT TRACK 0
 1049 07EA B6 0150            LDAA   USECT            LOAD <UNIT><SECTOR> SET BY FNDFL
 1050 07ED CE 00D0            LDX    #SECB1           RESET X TO POINT TO THE START OF THE SECTOR BUFFER
 1051 07F0 BD 0480            JSR    WRTSE            REWRITE THE SECTOR TO THE DISK DIRECTORY
 1052 07F3 4D                 TSTA                    IF WRITE OF SECTOR WAS SUCCESSFUL
 1053 07F4 26 01              BNE    RENA5            THEN
 1054 07F6 39                 RTS                     RETURN TO CALLER (SUCCESS)
 1055                  *
 1056 07F7 7E 0435     RENA5  JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 1057                  *
 1058                  *
 1059                  *THIS FUNCTION CREATES A FILE DIRECTORY ENTRY OF REQUESTED
 1060                  *SIZE, APPENDING IT TO THE END OF EXISTING FILES.  ANY DATA
 1061                  *PRESENT IN THE FILE AREA REMAINS UNCHANGED, ONLY THE DIRECTORY
 1062                  *AREA IS ALTERED.
 1063                  *
 1064 07FA 7F 00C6     CREAT  CLR    FILAT            DEFINE CREATED FILE ATTRIBUTE = 0
 1065 07FD BD 0367            JSR    PRSFL            PARSE FILE NAME (NEXT ITEM IS SIZE IN HEX)
 1066 0800 DE BC              LDX    BFPT1            POINT TO THE NEXT ITEM
 1067 0802 BD 0766            JSR    CONHX            AND CONVERT THE HEX TO BINARY
 1068 0805 DE CA              LDX    BINHI            AN ATTEMPT TO CREATE A FILE OF 0 SIZE
 1069 0807 27 21              BEQ    FERR1            IS FORBIDDEN, ELSE
 1070 0809 DF C7              STX    FILRQ            DEFINE THE REQUESTED FILE SIZE
 1071 080B BD 0588            JSR    CREAF            CREATE THE NEW FILE DIRECTORY ENTRY
 1072 080E 4D                 TSTA                    IF SUCCESSFUL IN CREATING THE NEW FILE
 1073 080F 26 03              BNE    ERTYP            THEN
 1074 0811 7E 016E            JMP    WTCMD            WAIT FOR NEW COMMAND
 1075                  *
 1076 0814 81 02       ERTYP  CMPA   #$2              IF A = 2
 1077 0816 26 09              BNE    NRMMS            THEN
 1078 0818 F6 0299     DUPNM  LDAB   DUNMM            LOAD CHARACTER COUNT
 1079 081B CE 029A            LDX    #DUNMM+1         AND POINTER FOR "DUPLICATE NAME"
 1080 081E 7E 0189            JMP    MSWTC            PRINT "DUPL NAME" & WAIT FOR NEW COMMAND
 1081                  *
 1082 0821 F6 02A3     NRMMS  LDAB   NORMM            LOAD CHARACTER COUNT
 1083 0824 CE 02A4            LDX    #NORMM+1         AND POINTER FOR "NO ROOM"
 1084 0827 7E 0189            JMP    MSWTC            PRINT "NO ROOM" & WAIT FOR NEW COMMAND
 1085                  *
 1086 082A 7E 0183     FERR1  JMP    ERRM             PRINT "FORMAT ERROR" & WAIT FOR NEW COMMAND
 1087                  *
 1088                  *
 1089 082D 96 C5       INIT   LDAA   FLNM5            IT IS FORBIDDEN TO INIT UID = 0
 1090 082F 27 31              BEQ    FERR2            BY COMMAND INIT:0 (INITX MUST BE USED)
