 1889                  *
 1890                  *DUPLICATE CONTENTS OF DISK DRIVE 0 TO DISK DRIVE 1  EACH TRACK
 1891                  *IS COPIED IN 3 DISK REVOLUTIONS, STORED IN 3 REVOLUTIONS AND
 1892                  *CHECK READ FOR CRC IN 2 REVOLUTIONS. BUFFER USED IS TRKBF
 1893                  *
 1894      0DBA        DUP    EQU    *
 1895 0DBA 86 01              LDAA   #$1              START ON SECTOR #1
 1896 0DBC 97 07              STAA   ISCTR            FOR THE INPUT FILE
 1897 0DBE 7F 0006            CLR    ITRK             START ON TRACK 0
 1898 0DC1 86 41              LDAA   #$41             SELECT UNIT 1, SECTOR 1
 1899 0DC3 97 0C              STAA   OSCTR            FOR THE OUTPUT FILE
 1900 0DC5 7F 000B            CLR    OTRK             START ON TRACK 0
 1901 0DC8 96 07       DUP1   LDAA   ISCTR            PICK UP INITIAL INPUT SECTOR
 1902 0DCA BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1903 0DCD BD 046F            JSR    DSKRD            IF DISK IS READY, THEN
 1904 0DD0 96 06              LDAA   ITRK             PICK UP INITIAL INPUT TRACK
 1905 0DD2 BD EA2B            JSR    SEEK             SEEK DISK 0 TO TRACK 0
 1906 0DD5 CE 1200            LDX    #TRKBF           DEFINE START OF TRACK BUFFER
 1907 0DD8 DF CA              STX    BGBFP            IN THE TRACK BUFFER POINTER
 1908 0DDA 96 07       DUP2   LDAA   ISCTR            PICK UP CURRENT SECTOR FOR INPUT
 1909 0DDC BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1910 0DDF DE CA              LDX    BGBFP            PICK UP THE CURRENT TRACK BUFFER POINTER
 1911 0DE1 BD 0E6C            JSR    DUSRD            READ A SECTOR INTO THE TRACK BUFFER
 1912 0DE4 DF CA              STX    BGBFP            SAVE THE CURRENT TRACK BUFFER POINTER
 1913 0DE6 86 03              LDAA   #$3              INTERLEAVE SECTORS BY 3 (ALLOW PROCESSING TIME)
 1914 0DE8 9B 07              ADDA   ISCTR            TO AVOID A 1 REVOLUTION WAIT BETWEEN SECTORS
 1915 0DEA 97 07              STAA   ISCTR            (MAINTAIN MINIMUM DISK ACCESS DELAY TIME)
 1916 0DEC C6 02              LDAB   #$2              ASSUME REV 1, START REV 2 @ SECTOR 2
 1917 0DEE 81 1C              CMPA   #28              IF NEXT SECTOR IS 28, END OF REV 1
 1918 0DF0 27 12              BEQ    DUP3             THEN START REV 2
 1919 0DF2 5C                 INCB                    ELSE ASSUME REV 2, START REV 3 @ SECTOR 3
 1920 0DF3 81 1D              CMPA   #29              IF NEXT SECTOR IS 29, END OF REV 2
 1921 0DF5 27 0D              BEQ    DUP3             THEN START REV 3
 1922 0DF7 81 1B              CMPA   #27              IF NEXT SECTOR IS 27, END OF REV 3
 1923 0DF9 26 DF              BNE    DUP2             THEN
 1924 0DFB 7C 0006            INC    ITRK             TAKE THE NEXT TRACK
 1925 0DFE 86 01              LDAA   #$1              START ON SECTOR 1
 1926 0E00 97 07              STAA   ISCTR            OF THAT TRACK
 1927 0E02 20 04              BRA    DUP4             WRITE THE TRACK JUST READ
 1928                  *
 1929 0E04 D7 07       DUP3   STAB   ISCTR            START REV 2 OR 3
 1930 0E06 20 D2              BRA    DUP2             READ THE INTERLEAVED SECTORS
 1931                  *
 1932 0E08 86 05       DUP4   LDAA   #$5              DEFINE A WRITE RETRY COUNT
 1933 0E0A 97 C9              STAA   WRTRY            5 ATTEMPTS TO WRITE THE TRACK
 1934 0E0C CE 1200     DUP5   LDX    #TRKBF           START THE BUFFER POINTER
 1935 0E0F DF CA              STX    BGBFP            AT THE BEGINNING OF THE TRACK BUFFER
 1936 0E11 96 0C              LDAA   OSCTR            PICK UP INITIAL <UNIT><SECTOR>
 1937 0E13 BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1938 0E16 BD 046F            JSR    DSKRD            IF DISK IS READY, THEN
 1939 0E19 96 0B              LDAA   OTRK             PICK UP INITIAL TRACK
 1940 0E1B BD EA2B            JSR    SEEK             SEEK DRIVE 1 TO TRACK 0, SECTOR 1
 1941 0E1E 96 0C       DUP6   LDAA   OSCTR            PICK UP CURRENT <UNIT><SECTOR>
 1942 0E20 BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1943 0E23 DE CA              LDX    BGBFP            PICK UP THE CURRENT TRACK BUFFER POINTER
 1944 0E25 BD 0EBE            JSR    DUWTS            WRITE A SECTOR TO DISK
 1945 0E28 DF CA              STX    BGBFP            SAVE THE CURRENT TRACK BUFFER POINTER
 1946 0E2A 86 03              LDAA   #$3              INTERLEAVE SECTORS BY 3 (ALLOW PROCESSING TIME)
 1947 0E2C 9B 0C              ADDA   OSCTR            TO AVOID A 1 REVOLUTION WAIT BETWEEN SECTORS
 1948 0E2E 97 0C              STAA   OSCTR            (MAINTAIN MINIMUM DISK ACCESS DELAY TIME)
 1949 0E30 C6 42              LDAB   #$42             ASSUME REV 1, START REV 2 @ SECTOR 2
 1950 0E32 81 5C              CMPA   #28+$40          IF NEXT SECTOR IS 28, END OF REV 1
 1951 0E34 27 0F              BEQ    DUP7             THEN START REV 2
 1952 0E36 5C                 INCB                    ELSE ASSUME REV 2, START REV 3 @ SECTOR 3
 1953 0E37 81 5D              CMPA   #29+$40          IF NEXT SECTOR IS 29, END OF REV 2
 1954 0E39 27 0A              BEQ    DUP7             THEN START REV 3
 1955 0E3B 81 5B              CMPA   #27+$40          IF NEXT SECTOR IS 27, END OF REV 3
 1956 0E3D 26 DF              BNE    DUP6             THEN
 1957 0E3F 86 41              LDAA   #$41             START <UNIT><SECTOR> AT
 1958 0E41 97 0C              STAA   OSCTR            DRIVE 1, SECTOR 0 AGAIN
 1959 0E43 20 04              BRA    DUP8             CHECK CRC ON TRACK JUST WRITTEN
 1960                  *
 1961 0E45 D7 0C       DUP7   STAB   OSCTR            START REV 2 OR 3
 1962 0E47 20 D5              BRA    DUP6             WRITE INTERLEAVED SECTORS
 1963                  *
 1964 0E49 BD 0EDB     DUP8   JSR    DUCRC            CHECK READ FOR CRC, IF FAILURE
 1965 0E4C 27 0F              BEQ    DUP9             THEN
 1966 0E4E 86 41              LDAA   #$41             START <UNIT><SECTOR> AT
 1967 0E50 97 0C              STAA   OSCTR            DRIVE 1, SECTOR 0 AGAIN
 1968 0E52 BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
 1969 0E55 7A 00C9            DEC    WRTRY            DECREMENT WRITE RETRY COUNTER, IF TRIES RUN OUT
 1970 0E58 26 B2              BNE    DUP5             THEN (ELSE TRY TO WRITE THE TRACK AGAIN)
 1971 0E5A 7E 0435            JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 1972                  *
 1973 0E5D 7C 000B     DUP9   INC    OTRK             TAKE THE NEXT TRACK
 1974 0E60 96 0B              LDAA   OTRK             IF THE NEXT TRACK
 1975 0E62 81 4D              CMPA   #77              IS (LAST TRACK)+1
 1976 0E64 26 03              BNE    DUPA             THEN
 1977 0E66 7E 016E            JMP    WTCMD            WAIT FOR NEXT COMMAND
 1978                  *
 1979 0E69 7E 0DC8     DUPA   JMP    DUP1             ELSE START ON THE NEXT TRACK
 1980                  *
 1981                  *
 1982                  *READ A DISK SECTOR TO TRACK INPUT BUFFER,  IF A READ ERROR
 1983                  *PERSISTS, USE THE DATA READ ON THE FIFTH TRY
 1984                  *
 1985 0E6C 86 05       DUSRD  LDAA   #$5              DEFINE A RETRY COUNT OF
 1986 0E6E B7 0155            STAA   TRYCT            5 TRIES TO READ DATA WITH ERRORS
 1987 0E71 86 02       DUSR1  LDAA   #$2              DEFINE DISK READ COMMAND
 1988 0E73 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
 1989 0E76 B6 EC00            LDAA   DKDID            READ DISK STATUS
 1990 0E79 84 08              ANDA   #$8              IF CRC ERROR
 1991 0E7B 27 08              BEQ    DUSR2            THEN
 1992 0E7D BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
 1993 0E80 7A 0155            DEC    TRYCT            RECORD FAILED READ TRY, WHILE COUNT
 1994 0E83 26 EC              BNE    DUSR1            TRY AGAIN, ELSE
 1995 0E85 86 04       DUSR2  LDAA   #$4              DEFINE WRITE DATA COMMAND
 1996 0E87 A7 00              STAA   $0,X             ASSUME USABLE SECTOR (NOT "DD" MARK)
 1997 0E89 B6 EC00            LDAA   DKDID            IF THIS SECTOR READ AS "DD"
 1998 0E8C 84 80              ANDA   #$80             INDICATED ON "DD" STATUS BIT
 1999 0E8E 27 04              BEQ    DUSR3            THEN
 2000 0E90 86 0E              LDAA   #$E              DEFINE WRITE "DD" COMMAND
 2001 0E92 A7 00              STAA   $0,X             PASS COMMAND TO WRITE ROUTINE
 2002 0E94 08          DUSR3  INX                     STEP OVER THE SECTOR COMMAND BYTE IN THE BUFFER
 2003 0E95 86 80              LDAA   #128             DEFINE BYTE COUNT FOR A SECTOR = 128
 2004 0E97 B7 0155            STAA   BYTCT            INITIALIZE READ DATA BYTE COUNTER
 2005 0E9A C6 40              LDAB   #$40             DEFINE READ DATA COMMAND
 2006 0E9C 86 3C       DUSR4  LDAA   #$3C             DEFINE COMMAND CONTROL
 2007 0E9E B7 EC03            STAA   DKCOC            ISSUE COMMAND CONTROL
 2008 0EA1 F7 EC02            STAB   DKCOD            ISSUE COMMAND DEFINED IN B REG (READ DATA)
 2009 0EA4 B6 EC00            LDAA   DKDID            LOAD DATA READ FROM DISK BUFFER
 2010 0EA7 A7 00              STAA   $0,X             STORE DATA IN TRKBF
 2011 0EA9 08                 INX                     TAKE THE NEXT LOCATION IN TRKBF
 2012 0EAA 86 2C              LDAA   #$2C             DEFINE RESET DRIVE COMMAND
 2013 0EAC B7 EC03            STAA   DKCOC            ISSUE RESET DRIVE
 2014 0EAF F7 EC02            STAB   DKCOD            ISSUE COMMAND DEFINED IN B REG (READ DATA)
 2015 0EB2 7F EC02            CLR    DKCOD            CLEAR THE COMMAND REGISTER
 2016 0EB5 7A 0155            DEC    BYTCT            COUNT OFF THIS BYTE, WHILE 128 BYTES
 2017 0EB8 26 E2              BNE    DUSR4            CONTINUE
 2018 0EBA BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
 2019 0EBD 39                 RTS                     RETURN TO CALLER
