 1838                  *
 1839                  *THIS SUBROUTINE WRITES A RECORD TO CASSETTE
 1840                  *RETURN IS DELAYED UNTIL RECORD IS WRITTEN
 1841                  *
 1842 0D6C 0D          DUMWT  SEC                     SET THE CARRY BIT TO "1"
 1843 0D6D 79 FF62            ROL    EXPUN            SET THE EXBUG PUNCH FLAG BIT 0
 1844 0D70 86 10              LDAA   #DLE             LOAD A R.O.C. "ATTENTION" CHAR FOR CASSETTE TERMINAL
 1845 0D72 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1846 0D75 86 30              LDAA   #'0              DEFINE "PRINTER OFF" COMMAND
 1847 0D77 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1848 0D7A 86 FF              LDAA   #RUB             DEFINE A RUBOUT CHAR (TIME FILLER)
 1849 0D7C BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1850 0D7F 86 12              LDAA   #DC2             DEFINE "CASSETTE WRITE" COMMAND
 1851 0D81 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1852 0D84 CE 1200            LDX    #TRKBF           SET POINTER AT BEGINNING OF BUFFER
 1853 0D87 A6 00       DUMW1  LDAA   $0,X             PICK UP A CHARACTER
 1854 0D89 BD F018            JSR    PRINC            WRITE IT TO THE CASSETTE TAPE
 1855 0D8C A6 00              LDAA   $0,X             LOAD THE CHARACTER AGAIN
 1856 0D8E 08                 INX                     TAKE THE NEXT BUFFER POSITION
 1857 0D8F 81 0D              CMPA   #CR              IF THE CHARACTER WAS NOT <CR>, THEN
 1858 0D91 26 F4              BNE    DUMW1            CONTINUE, ELSE
 1859                  *
 1860 0D93 86 14              LDAA   #DC4             DEFINE "CASSETTE OFF" COMMAND
 1861 0D95 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1862 0D98 86 10              LDAA   #DLE             LOAD A R.O.C. "ATTENTION" CHAR FOR CASSETTE TERMINAL
 1863 0D9A BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1864 0D9D 86 39              LDAA   #'9              DEFINE "PRINTER ON" COMMAND
 1865 0D9F BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1866 0DA2 7F FF62            CLR    EXPUN            CLEAR THE PUNCH ON CONTROL FLAG
 1867                  *
 1868                  *NOW WAIT FOR CASSETTE TO WRITE LAST RECORD & STOP
 1869                  *
 1870 0DA5 CE 5DC0            LDX    #24000           DEFINE A COUNT OF 24000, DECIMAL
 1871 0DA8 09          WAIT1  DEX                     COUNT DOWN TO 0, @ 8 USEC PER COUNT
 1872 0DA9 26 FD              BNE    WAIT1            WHILE COUNT, CONTINUE (200 MILLISECONDS)
 1873 0DAB 39                 RTS                     AFTER TIMED WAIT, RETURN TO CALLER
