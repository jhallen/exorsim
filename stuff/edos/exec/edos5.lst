 1473 0AF6 CE 02E3            LDX    #NOEXM+1         AND PONTER FOR " NON EXISTENT"
 1474 0AF9 BD 03BA            JSR    PRINS            PRINT " NON EXISTENT"
 1475 0AFC BD 03C4            JSR    CRLF             PRINT <CR><LF>
 1476 0AFF 39                 RTS                     RETURN TO CALLER
