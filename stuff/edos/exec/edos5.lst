  154                  *
  155                  *EDOS STARTUP ENTRY POINT - PRINT OUT ID MESSAGE - WAIT FOR COMMAND I/P
  156                  *
  157 015C 8E 006B     EXEC   LDS    #EXSTK           INITIALIZE EXECUTIVE STACK
  158 015F BD 03C4            JSR    CRLF             ESTABLISH NEW LINE ON CONSOLE
  159 0162 F6 02F0            LDAB   IDMES            GET CHARACTER COUNT FOR I/D
  160 0165 CE 02F1            LDX    #IDMES+1         SET STRING POINTER FOR I/D
  161 0168 BD 03BA            JSR    PRINS            OUTPUT I/D MESSAGE ON CONSOLE
  162 016B BD 03C4            JSR    CRLF             END I/D WITH <CR><LF>
  163 016E 0F          WTCMD  SEI                     WAIT FOR USER COMMAND (INTERRUPTS DISABLED)
  164 016F BD E806            JSR    INTIO            INIT DISC INTERFACE TO KNOWN STATE
  165 0172 8E 006B            LDS    #EXSTK           REINITIALIZE EDOS STACK SPACE
  166 0175 BD 032E            JSR    USCMD            OUTPUT USER PROMPT CHARACTER, WAIT FOR COMMAND
  167 0178 BD 0367            JSR    PRSFL            PARSE COMMAND & LEAVE IN FLNM0-FLNM4
  168                  *
  169                  *DO STRING COMPARE TO IDENTIFY COMMAND.  COMMAND LIST IS PACKED
  170                  *IN 5-CHARACTER STRINGS, PADDED WITH TRAILING SPACES.  THE SWITCH
  171                  *ADDRESS FOR EACH COMMAND FOLLOWS THE CHARACTER STRING.
  172                  *THE INPUT COMMAND STRING IS FOUND AT FLNM0 TO FLNM4
  173                  *
  174 017B CE 01BB            LDX    #CMDST           POINT TO START OF PROTOTYPE COMMANDS
  175 017E 8C 027F     CMDLP  CPX    #CMDLM           IF ALL POSSIBLE COMMANDS EXAUSTED
  176 0181 26 0B              BNE    TRYCM            THEN
  177 0183 F6 027F     ERRM   LDAB   FERRM            GET CHARACTER COUNT FOR MESSAGE
  178 0186 CE 0280            LDX    #FERRM+1         SET STRING POINTER FOR FORMAT ERROR MESSAGE
  179 0189 BD 03BA     MSWTC  JSR    PRINS            PRINT MESSAGE ON CONSOLE
  180 018C 20 E0              BRA    WTCMD            WAIT FOR ANOTHER COMMAND INPUT
  181                  *
  182 018E A6 00       TRYCM  LDAA   $0,X             IF FIRST PROTOTYPE CHARACTER EQUALS
  183 0190 91 C0              CMPA   FLNM0            FIRST CHARACTER OF THIS COMMAND
  184 0192 26 1E              BNE    SKPCM            AND
  185 0194 A6 01              LDAA   $1,X             SECOND PROTOTYPE CHARACTER EQUALS
  186 0196 91 C1              CMPA   FLNM1            SECOND CHARACTER OF THIS COMMAND
  187 0198 26 18              BNE    SKPCM            AND
  188 019A A6 02              LDAA   $2,X             THIRD PROTOTYPE CHARACTER EQUALS
  189 019C 91 C2              CMPA   FLNM2            THIRD CHARACTER OF THIS COMMAND
  190 019E 26 12              BNE    SKPCM            AND
  191 01A0 A6 03              LDAA   $3,X             FOURTH PROTOTYPE CHARACTER EQUALS
  192 01A2 91 C3              CMPA   FLNM3            FOURTH CHARACTER OF THIS COMMAND
  193 01A4 26 0C              BNE    SKPCM            AND
  194 01A6 A6 04              LDAA   $4,X             FITH PROTOTYPE CHARACTER EQUALS
  195 01A8 91 C4              CMPA   FLNM4            FITH CHARACTER OF THIS COMMAND
  196 01AA 26 06              BNE    SKPCM            THEN
  197 01AC EE 05              LDX    $5,X             COMMAND IS IDENTIFIED, SELECT ADDRESS
  198 01AE AD 00              JSR    $0,X             CALL THIS COMMAND SERVICE
  199 01B0 20 BC              BRA    WTCMD            WAIT FOR NEXT COMMAND
  200                  *
  201 01B2 08          SKPCM  INX                     STEP
  202 01B3 08                 INX                     OVER
  203 01B4 08                 INX                     FIVE
  204 01B5 08                 INX                     PROTOTYPE
  205 01B6 08                 INX                     CHARS &
  206 01B7 08                 INX                     SERVICE
  207 01B8 08                 INX                     ADDRESS.
  208 01B9 20 C3              BRA    CMDLP            TRY ANOTHER COMMAND
