 2089                  *MOVE AN INPUT FILE TO A OUTPUT FILE, VIA A LARGE BUFFER AREA
 2090                  *
 2091 0F24 7F 0158     MOVFL  CLR    EOFFL            CLEAR "END OF FILE" FLAG
 2092 0F27 CE 1200     MOVF1  LDX    #BGBUF           SET THE POINTER AT THE START
 2093 0F2A DF CA       MOVF2  STX    BGBFP            OF THE LARGE BUFFER AREA
 2094 0F2C BD E809            JSR    XRI              GET AN INPUT BYTE FROM THE DISK
 2095 0F2F 25 23              BCS    MOVF5            IF NOT EOF, THEN
 2096 0F31 DE CA              LDX    BGBFP            LOAD THE CURRENT BUFFER POINTER
 2097 0F33 A7 00              STAA   $0,X             STORE THE DATA IN THE BUFFER AREA
 2098 0F35 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 2099 0F36 8C 1EFE            CPX    #BGBFE           IF END OF THE BUFFER
 2100 0F39 26 EF              BNE    MOVF2            THEN
 2101                  *
 2102 0F3B DF CA              STX    BGBFP            SAVE THE POINTER AS A LIMIT
 2103 0F3D CE 1200     MOVF3  LDX    #BGBUF           START AT THE BEGINNING OF THE BUFFER
 2104 0F40 DF CC       MOVF4  STX    BFOP2            USING AN OUTPUT POINTER LOCATION
 2105 0F42 A6 00              LDAA   $0,X             GET THE CURRENT DATA BYTE
 2106 0F44 BD E80C            JSR    XWRT             WRITE THE DATA TO DISK
 2107 0F47 DE CC              LDX    BFOP2            LOAD THE OUTPUT POINTER
 2108 0F49 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 2109 0F4A 9C CA              CPX    BGBFP            IF REACHED PREVIOUS END POINT
 2110 0F4C 26 F2              BNE    MOVF4            THEN
 2111 0F4E 7D 0158            TST    EOFFL            IF THE END OF FILE HAS BEEN REACHED
 2112 0F51 27 D4              BEQ    MOVF1            THEN
 2113 0F53 39                 RTS                     FILE IS MOVED, RETURN TO CALLER
 2114                  *
 2115 0F54 7C 0158     MOVF5  INC    EOFFL            RECORD END OF FILE FOUND
 2116 0F57 20 E4              BRA    MOVF3            START WRITING IT
