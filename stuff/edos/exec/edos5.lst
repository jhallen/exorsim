 1521 0B5F CE 00C0            LDX    #FLNM0           POINT TO THE SEARCH STRING
 1522 0B62 86 45              LDAA   #'E              BUILD UP
 1523 0B64 A7 00              STAA   0,X              AN IMAGE
 1524 0B66 86 44              LDAA   #'D              OF "EDIT "
 1525 0B68 A7 01              STAA   1,X              AS A SEARCH
 1526 0B6A 86 49              LDAA   #'I              PATTERN
 1527 0B6C A7 02              STAA   2,X              (LOOK FOR
 1528 0B6E 86 54              LDAA   #'T              THE EDITOR
 1529 0B70 A7 03              STAA   3,X              PROGRAM FILE)
 1530 0B72 B7 0157            STAA   LGOFL            SET LOAD-&-GO FLAG
 1531 0B75 86 20       GEPRO  LDAA   #SPC             PAD THE NAME
 1532 0B77 A7 04              STAA   4,X              TO 5 CHARACTERS
 1533 0B79 BD 0533            JSR    DFINF            IF THE REQUESTED PROGRAM OBJECT FILE
 1534 0B7C 4D                 TSTA                    IS NOT RESIDENT ON THE DISK
 1535 0B7D 27 03              BEQ    GEPR1            THEN
