 1580 0BCA DF C7              STX    FILRQ            AND DEFINE THE REQUESTED FILE SIZE
 1581 0BCC 86 FF       DOOF2  LDAA   #$FF             DEFINE END OF DIRECTORY (NEW FILE GOES ON THE END)
 1582 0BCE 97 C6              STAA   FILAT            WITH ATTRIBUTE = $FF
