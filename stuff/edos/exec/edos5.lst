 1635                  *
 1636                  *THESE ROUTINES GENERATE DISK FILES FROM:
 1637                  *
 1638                  *CASSETTE
 1639                  *
 1640                  *HS PAPER TAPE READER
 1641                  *
 1642                  *TELETYPE READER
 1643                  *
 1644      0C1E        CTAPE  EQU    *
 1645      0C1E        PTAPE  EQU    *
 1646      0C1E        TTAPE  EQU    *
 1647 0C1E BD 0C13            JSR    SVIOF            VALIDATE NEW FILE NAME, & ALLOCATE
 1648 0C21 BD 0C69            JSR    GENDV            SWITCH TO SELECTED TERMINAL, INPUT DATA & WRITE IT TO DISK
 1649 0C24 7E 0699            JMP    FLCLS            CLOSE THE NEW FILE, WAIT FOR NEXT COMMAND
 1650                  *
 1651                  *THESE ROUTINES GENERATE A COPY OF A NEW SYSTEM FROM:
 1652                  *
 1653                  *
 1654                  *CASSETTE
 1655                  *
 1656                  *HS PAPER TAPE READER
 1657                  *
 1658                  *TELETYPE READER
 1659                  *
 1660      0C27        PXGEN  EQU    *
 1661      0C27        CXGEN  EQU    *
 1662      0C27        TXGEN  EQU    *
 1663 0C27 86 01              LDAA   #1               SELECT TRACK 1
 1664 0C29 97 0B              STAA   OTRK             FOR THE SYSTEM AREA
 1665 0C2B 97 0C              STAA   OSCTR            BEGIN AT SECTOR 1
 1666 0C2D 7F 0002            CLR    OUNIT            USE THE SYSTEM DISK
 1667 0C30 7F 000D            CLR    OCNTR            CLEAR THE O/P BYTE COUNT
 1668 0C33 CE 0082            LDX    #SYSSZ           ALLOCATE SYSSZ SECTORS
 1669 0C36 DF 09              STX    OSIZE            FOR THE NEW SYSTEM AREA
 1670 0C38 BD 0C69            JSR    GENDV            SWITCH TO SELECTED TERMINAL, INPUT DATA & WRITE IT TO DISK
 1671 0C3B 86 53              LDAA   #'S              DEFINE FILE BLOCK "S"
 1672 0C3D BD E80C            JSR    XWRT             AND WRITE IT TO DISK
 1673 0C40 86 1B              LDAA   #ESC             GENERATE END OF OBJECT FILE MARK (ESC CHAR)
 1674 0C42 BD E80C            JSR    XWRT             AND WRITE IT TO DISK
 1675 0C45 86 14              LDAA   #DC4             COMMAND "PUNCH OFF" IN THE FILE TO TERMINATE DUMPS
 1676 0C47 BD E80C            JSR    XWRT             WRITE THE DC4 TO THE DISK
 1677 0C4A 7D 000D     GENS1  TST    OCNTR            IF DISK DATA BUFFER IS NOT FULL (128 BYTES)
 1678 0C4D 27 06              BEQ    GENS2            THEN
 1679 0C4F 4F                 CLRA                    PAD WITH NULLS
 1680 0C50 BD E80C            JSR    XWRT             WRITING TO DISK
 1681 0C53 20 F5              BRA    GENS1            UNTIL BUFFER IS FULL
 1682                  *
 1683 0C55 86 03       GENS2  LDAA   #3               DEFINE SECTOR 3
 1684 0C57 B7 0150            STAA   USECT            AS THE CURRENT SECTOR
 1685 0C5A 86 01              LDAA   #1               DEFINE SECTOR 1
 1686 0C5C B7 0152            STAA   CRSEC            AS THE STARTING SECTOR
 1687 0C5F 96 0B              LDAA   OTRK             DEFINE THE START TRACK
 1688 0C61 4C                 INCA                    AS THE CURRENT TRACK +1
 1689 0C62 B7 0151            STAA   CRTRK            FOR USE BY WTNDX
 1690 0C65 BD 0649            JSR    WTND5            GENERATE THE DIRECTORY ENTRY
 1691 0C68 39                 RTS                     AND RETURN
 1692                  *
 1693                  *
 1694                  *IDENTIFY INPUT DEVICE, & READ TO DISK
 1695                  *UNTIL END OF MEDIA OCCURS.
 1696                  *
 1697 0C69 96 6C       GENDV  LDAA   IBUF1            GET THE FIRST CHARACTER OF COMMAND
 1698 0C6B 81 50              CMPA   #'P              IF IT IS AN ASCII "P", THEN
 1699 0C6D 27 79              BEQ    GENDA            USE HS PAPER TAPE READER I/P
 1700 0C6F 7D FF02     GEND1  TST    SPEED            IF SPEED FLAG IS NEGATIVE
 1701 0C72 2A 0C              BPL    GEND2            IT IS A TAPE CASSETTE TERMINAL
 1702 0C74 86 10              LDAA   #$10             LOAD THE RDC "ATTENTION"
 1703 0C76 BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1704 0C79 86 37              LDAA   #$37             LOAD "BLOCK FORWARD" MODE
 1705 0C7B BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1706 0C7E 20 0D              BRA    GEND3            INPUT RESULTING DATA STREAM
 1707                  *
 1708 0C80 B6 FCFD     GEND2  LDAA   SBITC            GET CONTROL TEMPLATE FOR ACIA
 1709 0C83 84 55              ANDA   #$55             MASK TO REQUEST FOR READER RELAY CONTROL
 1710 0C85 B7 FCF4            STAA   ACIAC            SET UP IN ACIA (RTS)
 1711 0C88 86 11              LDAA   #$11             LOAD "AUTO READER ON"
 1712 0C8A BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1713 0C8D CE 1200     GEND3  LDX    #TRKBF           LOAD POINTER TO TRACK BUFFER AREA (END OF EDOS + MOD 2
 1714 0C90 DF CA       GEND4  STX    BGBFP            SAVE WRITE BUFFER POINTER
 1715 0C92 CE FFFF            LDX    #TIMAX           BEGIN TIMEOUT FOR EOM
 1716 0C95 B6 FCF4     GEND5  LDAA   ACIAS            READ ACIA STATUS REGISTER
 1717 0C98 47                 ASRA                    SHIFT "DATA AVAILABLE" FLAG TO C BIT
 1718 0C99 25 09              BCS    GEND6            IF DATA IS READY, GO GET IT
 1719 0C9B 09                 DEX                     IF TIMEOUT HAS RUN DOWN
 1720 0C9C 26 F7              BNE    GEND5            THEN
 1721 0C9E 86 1A              LDAA   #ASUB            LOAD A "SUB" CHARACTER TO SHOW EOM
 1722 0CA0 DE CA              LDX    BGBFP            GET CURRENT BUFFER POINTER
 1723 0CA2 20 10              BRA    GEND7            AND CLOSE OFF THE READ
 1724                  *
 1725 0CA4 DE CA       GEND6  LDX    BGBFP            GET CURRENT BUFFER POINTER
 1726 0CA6 B6 FCF5            LDAA   ACIAR            PICK UP THE DATA CHARACTER
 1727 0CA9 84 7F              ANDA   #$7F             STRIP OFF THE PARITY BIT
 1728 0CAB 81 0D              CMPA   #CR              IF IT IS AN ASCII <CR>, CYCLE THE TTY
 1729 0CAD 27 05              BEQ    GEND7            ELSE,
 1730 0CAF A7 00              STAA   0,X              STORE THE CHARACTER IN THE BUFFER
 1731 0CB1 08                 INX                     MOVE ON TO THE NEXT FREE BUFFER LOCATION
 1732 0CB2 20 DC              BRA    GEND4            AND CONTINUE READING
 1733                  *
 1734 0CB4 A7 00       GEND7  STAA   0,X              STORE THE <CR> OR <SUB>(EOM) IN THE BUFFER
 1735 0CB6 08                 INX                     MOVE ON TO THE NEXT FREE BUFFER LOCATION
 1736 0CB7 86 FF              LDAA   #$FF             GENERATE AN END-OF-LINE MARKER
 1737 0CB9 A7 00              STAA   0,X              IN THE BUFFER
 1738 0CBB B6 FCFD            LDAA   SBITC            GET CONTROL TEMPLATE FOR ACIA
 1739 0CBE 84 35              ANDA   #$35             TURN OFF RELAY CONTROLLED READER
 1740 0CC0 B7 FCF4            STAA   ACIAC            BY DROPPING RTS SIGNAL
 1741 0CC3 86 13              LDAA   #$13             SIGNAL "READER OFF" OR CYCLE THE TTY
 1742 0CC5 BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1743 0CC8 B6 FCF5            LDAA   ACIAR            REMOVE BAD CHARACTERS FROM ACIA INPUT BUFFER
 1744 0CCB B6 FCF5            LDAA   ACIAR            DUE TO READER SHUTDOWN ON TTY
 1745                  *
 1746                  *HAVING A LOAD OF CHARACTERS IN THE BUFFER
 1747                  *WRITE THEM TO THE DISK, WITH READER OFF
 1748                  *
 1749 0CCE CE 1200            LDX    #TRKBF           DEFINE THE START OF THE DATA BUFFER
 1750 0CD1 DF CA              STX    BGBFP            SET THE BUFFER POINTER TO THE START OF THE BUFFER
 1751 0CD3 DE CA       GEND8  LDX    BGBFP            PICK UP THE CURRENT BUFFER POINTER
 1752 0CD5 A6 00              LDAA   0,X              PICK UP A DATA CHARACTER
 1753 0CD7 08                 INX                     MOVE ON TO THE NEXT CHARACTER
 1754 0CD8 DF CA              STX    BGBFP            SAVE THE BUFFER POINTER
 1755 0CDA 81 FF              CMPA   #$FF             AT END OF LINE, START THE READER AGAIN
 1756 0CDC 27 91              BEQ    GEND1            ELSE,
 1757 0CDE 81 1A              CMPA   #ASUB            AT EOM OR TIMEOUT, EXIT
 1758 0CE0 27 05              BEQ    GEND9            ELSE,
 1759 0CE2 BD E80C            JSR    XWRT             WRITE THE CHARACTER TO DISK
 1760 0CE5 20 EC              BRA    GEND8            WHILE CHARACTERS IN THE BUFFER, CONTINUE
 1761                  *
 1762 0CE7 39          GEND9  RTS                     RETURN TO CALLER
 1763                  *
 1764 0CE8 BD EB04     GENDA  JSR    INITR            INITIALIZE HS PAPER TAPE READER
 1765 0CEB BD 0036     GENDB  JSR    PTAPV            GET DATA TO THE END OF TAPE
 1766 0CEE 25 F7              BCS    GEND9            WHILE MORE TAPE
 1767 0CF0 BD E80C            JSR    XWRT             WRITE DATA TO DISK
 1768 0CF3 20 F6              BRA    GENDB            CONTINUE
 1769                  *
 1770                  *
 1771      0CF5        TDUMP  EQU    *
 1772      0CF5        CDUMP  EQU    *
 1773 0CF5 BD 0367            JSR    PRSFL            PARSE THE INPUT FILE NAME
 1774 0CF8 BD 0533            JSR    DFINF            IF THE REQUESTED FILE
 1775 0CFB 4D                 TSTA                    IS NOT FOUND
 1776 0CFC 27 03              BEQ    DUMP1            THEN
 1777 0CFE 7E 06ED            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 1778 0D01 96 6C       DUMP1  LDAA   IBUF1            IF FIRST CHARACTER OF COMMAND
 1779 0D03 81 43              CMPA   #'C              IS NOT A "C" (CASSETTE DUMP)
 1780 0D05 27 2D              BEQ    CDMP1            THEN
 1781 0D07 BD 0DAC            JSR    NULOC            OUTPUT 100 NULLS (10" LEADER ON TAPE)
 1782 0D0A BD 0DAC            JSR    NULOC            OUTPUT 100 NULLS (20" LEADER ON TAPE)
 1783 0D0D BD E809     TDMP1  JSR    XRI              READ A BYTE FROM DISK
 1784 0D10 25 09              BCS    TDMP2            IF NOT END OF FILE, AND
 1785 0D12 81 0D              CMPA   #CR              IF NOT A <CR>
 1786 0D14 27 15              BEQ    TDMP3            THEN
 1787 0D16 BD 0033            JSR    PRICV            PUNCH THIS CHARACTER
 1788 0D19 20 F2              BRA    TDMP1            AND CONTINUE
 1789                  *
 1790 0D1B 86 1A       TDMP2  LDAA   #ASUB            LOAD ASCII "SUB" (EOM MARK)
 1791 0D1D BD 0033            JSR    PRICV            AND PUNCH IT TO TAPE
 1792 0D20 86 0D              LDAA   #CR              LOAD AN ASCII <CR>
 1793 0D22 BD 0033            JSR    PRICV            AND PUNCH IT TO TAPE
 1794 0D25 BD 0DAC            JSR    NULOC            OUTPUT 100 NULLS (10" TRAILER)
 1795 0D28 7E 016E            JMP    WTCMD            WAIT FOR NEW COMMAND
 1796                  *
 1797 0D2B BD 0033     TDMP3  JSR    PRICV            PUNCH THE <CR>
 1798 0D2E 4F                 CLRA                    DEFINE A NULL (ALLOW FOR PUNCH ON/OFF)
 1799 0D2F BD 0033            JSR    PRICV            AND PUNCH IT
 1800 0D32 20 D9              BRA    TDMP1            CONTINUE PUNCHING
 1801                  *
 1802                  *
 1803 0D34 7F 0158     CDMP1  CLR    EOFFL            CLEAR END-OF-FILE FLAG FOR CASSETTE WRITE
 1804 0D37 8D 0E       CDMP2  BSR    DUMRD            READ A RECORD TERMINATED BY EOF OR <CR>
 1805 0D39 7D 0158            TST    EOFFL            IF NOT END OF FILE YET
 1806 0D3C 26 04              BNE    CDMP3            THEN
 1807 0D3E 8D 2C              BSR    DUMWT            WRITE THIS RECORD TO THE CASSETTE
 1808 0D40 20 F5              BRA    CDMP2            CONTINUE
 1809                  *
 1810 0D42 8D 28       CDMP3  BSR    DUMWT            WRITE THE LAST (EOF) RECORD TO CASSETTE
 1811 0D44 7E 016E            JMP    WTCMD            WAIT FOR NEXT COMMAND
