 1547 0B95 DF 04              STX    ISIZE            FOR THE ISIZE SETUP VALUE
 1548 0B97 86 01              LDAA   #$1              DEFINE TRACK NUMBER
 1549 0B99 97 06              STAA   ITRK             AS TRACK 1
 1550 0B9B 7F 0008            CLR    ICNTR            CLEAR THE INPUT BYTE COUNTER
 1551 0B9E 7F 0007            CLR    ISCTR            DEFINE INPUT <UNIT><SECTOR> AS 0
 1552 0BA1 7F 0003            CLR    IUNIT            ON UNIT 0
 1553 0BA4 BD 0C13            JSR    SVIOF            PREPARE FCB, AND SAVE I/O FILE DEFINITIONS
 1554 0BA7 20 B3              BRA    EDIT1            AND CALL IN THE EDITOR (KEYBOARD INPUT ONLY)
