 2022                  *WRITE A SECTOR TO DISK, USING DATA FROM THE CURRENT SECTOR
 2023                  *
 2024 0EBE A6 00       DUWTS  LDAA   $0,X             PICK UP SECTOR WRITE CONTROL BYTE
 2025 0EC0 36                 PSHA                    SAVE IT TO USE AS A WRITE COMMAND AFTER BUFFER LOAD
 2026 0EC1 08                 INX                     STEP OVER THE SECTOR WRITE CONTROL BYTE
 2027 0EC2 86 80              LDAA   #128             DEFINE 128 BYTES IN A SECTOR
 2028 0EC4 B7 0155            STAA   BYTCT            FOR A WRITE BYTE COUNTER
 2029 0EC7 C6 30              LDAB   #$30             DEFINE A WRITE DISK COMMAND
 2030 0EC9 A6 00       DUWT1  LDAA   $0,X             PICK UP CURRENT DATA BYTE FROM BUFFER
 2031 0ECB B7 EC06            STAA   DKDOD            OUTPUT IT TO THE DISK
 2032 0ECE F7 EC02            STAB   DKCOD            STROBE THE DATA IN TO THE DISK BUFFER
 2033 0ED1 08                 INX                     TAKE THE NEXT DATA BYTE
 2034 0ED2 7A 0155            DEC    BYTCT            WHILE 128 BYTES
 2035 0ED5 26 F2              BNE    DUWT1            CONTINUE
 2036 0ED7 32                 PULA                    GET SECTOR WRITE CONTROL BYTE
 2037 0ED8 7E EA3E            JMP    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
 2038                  *AND RETURN TO CALLER
 2039                         SPC    3
 2040                  *READ A TRACK & CHECK FOR CRC ERRORS
 2041                  *
 2042 0EDB 96 0C       DUCRC  LDAA   OSCTR            PICK UP CURRENT SECTOR
 2043 0EDD BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 2044 0EE0 86 06              LDAA   #$6              DEFINE READ DISK FOR CRC COMMAND
 2045 0EE2 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
 2046 0EE5 B6 EC00            LDAA   DKDID            READ DISK STATUS
 2047 0EE8 84 08              ANDA   #$8              IF CRC ERROR NOT ON
 2048 0EEA 26 19              BNE    DUCR2            THEN (FAILURE EXIT, Z = 0)
 2049 0EEC 86 02              LDAA   #$2              INTERLEAVE SECTORS BY TWO DURING
 2050 0EEE 9B 0C              ADDA   OSCTR            CRC READ PASS (LESS CPU TIME)
 2051 0EF0 97 0C              STAA   OSCTR            DEFINE NEXT SECTOR
 2052 0EF2 81 5B              CMPA   #27+$40          IF END OR PAST PASS 1
 2053 0EF4 2B E5              BMI    DUCRC            THEN
 2054 0EF6 81 5C              CMPA   #28+$40          IF NOT END OF PASS 2
 2055 0EF8 27 06              BEQ    DUCR1            THEN
 2056 0EFA 86 42              LDAA   #$42             DEFINE SECTOR 2 ON UNIT 1
 2057 0EFC 97 0C              STAA   OSCTR            FOR PASS 2
 2058 0EFE 20 DB              BRA    DUCRC            BEGIN PASS 2 (READ INTERLEAVED SECTORS)
 2059                  *
 2060 0F00 86 41       DUCR1  LDAA   #$41             DEFINE SECTOR 1 ON UNIT 1
 2061 0F02 97 0C              STAA   OSCTR            FOR NEXT FUNCTION
 2062 0F04 4F                 CLRA                    SET Z = 1 (SUCCESS EXIT)
 2063 0F05 39          DUCR2  RTS                     RETURN TO CALLER
