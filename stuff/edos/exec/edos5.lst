 1460                  *
 1461 0AD9 BD 0533     IPFIL  JSR    DFINF            IF THE REQUESTED FILE
 1462 0ADC 4D                 TSTA                    DOES NOT EXIST
 1463 0ADD 27 21              BEQ    IPFI1            THEN
 1464 0ADF C6 05              LDAB   #$5              FOR THE 5 CHARACTERS
 1465 0AE1 CE 00C0            LDX    #FLNM0           OF THE REQUESTED FILE NAME
 1466 0AE4 BD 03BA            JSR    PRINS            PRINT THE FILE NAME
 1467 0AE7 86 3A              LDAA   #':              DEFINE ASCII COLON
 1468 0AE9 BD F018            JSR    PRINC            PRINT IT
