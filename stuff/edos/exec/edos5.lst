 1816 0D47 CE 1200     DUMRD  LDX    #TRKBF           DEFINE A POINTER TO A LARGE
 1817 0D4A DF CA              STX    BGBFP            BUFFER WORK AREA
 1818                  *
 1819 0D4C BD E809     DUMR1  JSR    XRI              READ A BYTE FROM DISK
 1820 0D4F 25 0C              BCS    DUMR2            IF NOT EOF
 1821 0D51 DE CA              LDX    BGBFP            USE POINTER TO
 1822 0D53 A7 00              STAA   $0,X             STORE CHARACTER IN BUFFER
 1823 0D55 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 1824 0D56 DF CA              STX    BGBFP            AND UPDATE THE POINTER
 1825 0D58 81 0D              CMPA   #CR              IF THE CHARACTER WAS NOT <CR>
 1826 0D5A 26 F0              BNE    DUMR1            CONTINUE
 1827 0D5C 39                 RTS                     ELSE RETURN
 1828                  *
 1829 0D5D 86 1A       DUMR2  LDAA   #ASUB            LOAD AN ASCII "SUB" AS EOM MARK
 1830 0D5F DE CA              LDX    BGBFP            USING THE BUFFER POINTER
 1831 0D61 A7 00              STAA   $0,X             STORE "SUB" IN THE BUFFER
 1832 0D63 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 1833 0D64 86 0D              LDAA   #CR              LOAD AN ASCII <CR>
 1834 0D66 A7 00              STAA   $0,X             STORE "CR" IN THE BUFFER
 1835 0D68 7C 0158            INC    EOFFL            SET END-OF-FILE FLAG
 1836 0D6B 39                 RTS                     AND RETURN
