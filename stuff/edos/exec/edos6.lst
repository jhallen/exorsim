 1925                  *
 1926                  *
 1927                  *
 1928                  *DUPLICATE CONTENTS OF DISK DRIVE 0 TO DISK DRIVE 1  EACH TRACK
 1929                  *IS COPIED IN 3 DISK REVOLUTIONS, STORED IN 3 REVOLUTIONS AND
 1930                  *CHECK READ FOR CRC IN 2 REVOLUTIONS. BUFFER USED IS TRKBF
 1931                  *
 1932      0DE7        DUP    EQU    *
 1933 0DE7 86 01              LDAA   #$1              START ON SECTOR #1
 1934 0DE9 97 07              STAA   ISCTR            FOR THE INPUT FILE
 1935 0DEB 7F 0006            CLR    ITRK             START ON TRACK 0
 1936 0DEE 86 41              LDAA   #$41             SELECT UNIT 1, SECTOR 1
 1937 0DF0 97 0C              STAA   OSCTR            FOR THE OUTPUT FILE
 1938 0DF2 7F 000B            CLR    OTRK             START ON TRACK 0
 1939 0DF5 96 07       DUP1   LDAA   ISCTR            PICK UP INITIAL INPUT SECTOR
 1940 0DF7 BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1941 0DFA BD 0476            JSR    DSKRD            IF DISK IS READY, THEN
 1942 0DFD 96 06              LDAA   ITRK             PICK UP INITIAL INPUT TRACK
 1943 0DFF BD EA2B            JSR    SEEK             SEEK DISK 0 TO TRACK 0
 1944 0E02 CE 1200            LDX    #TRKBF           DEFINE START OF TRACK BUFFER
 1945 0E05 DF CA              STX    BGBFP            IN THE TRACK BUFFER POINTER
 1946 0E07 96 07       DUP2   LDAA   ISCTR            PICK UP CURRENT SECTOR FOR INPUT
 1947 0E09 BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1948 0E0C DE CA              LDX    BGBFP            PICK UP THE CURRENT TRACK BUFFER POINTER
 1949 0E0E BD 0E99            JSR    DUSRD            READ A SECTOR INTO THE TRACK BUFFER
 1950 0E11 DF CA              STX    BGBFP            SAVE THE CURRENT TRACK BUFFER POINTER
 1951 0E13 86 03              LDAA   #$3              INTERLEAVE SECTORS BY 3 (ALLOW PROCESSING TIME)
 1952 0E15 9B 07              ADDA   ISCTR            TO AVOID A 1 REVOLUTION WAIT BETWEEN SECTORS
 1953 0E17 97 07              STAA   ISCTR            (MAINTAIN MINIMUM DISK ACCESS DELAY TIME)
 1954 0E19 C6 02              LDAB   #$2              ASSUME REV 1, START REV 2 @ SECTOR 2
 1955 0E1B 81 1C              CMPA   #28              IF NEXT SECTOR IS 28, END OF REV 1
 1956 0E1D 27 12              BEQ    DUP3             THEN START REV 2
 1957 0E1F 5C                 INCB                    ELSE ASSUME REV 2, START REV 3 @ SECTOR 3
 1958 0E20 81 1D              CMPA   #29              IF NEXT SECTOR IS 29, END OF REV 2
 1959 0E22 27 0D              BEQ    DUP3             THEN START REV 3
 1960 0E24 81 1B              CMPA   #27              IF NEXT SECTOR IS 27, END OF REV 3
 1961 0E26 26 DF              BNE    DUP2             THEN
 1962 0E28 7C 0006            INC    ITRK             TAKE THE NEXT TRACK
 1963 0E2B 86 01              LDAA   #$1              START ON SECTOR 1
 1964 0E2D 97 07              STAA   ISCTR            OF THAT TRACK
 1965 0E2F 20 04              BRA    DUP4             WRITE THE TRACK JUST READ
 1966                  *
 1967 0E31 D7 07       DUP3   STAB   ISCTR            START REV 2 OR 3
 1968 0E33 20 D2              BRA    DUP2             READ THE INTERLEAVED SECTORS
 1969                  *
 1970 0E35 86 05       DUP4   LDAA   #$5              DEFINE A WRITE RETRY COUNT
 1971 0E37 97 C9              STAA   WRTRY            5 ATTEMPTS TO WRITE THE TRACK
 1972 0E39 CE 1200     DUP5   LDX    #TRKBF           START THE BUFFER POINTER
 1973 0E3C DF CA              STX    BGBFP            AT THE BEGINNING OF THE TRACK BUFFER
 1974 0E3E 96 0C              LDAA   OSCTR            PICK UP INITIAL <UNIT><SECTOR>
 1975 0E40 BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1976 0E43 BD 0476            JSR    DSKRD            IF DISK IS READY, THEN
 1977 0E46 96 0B              LDAA   OTRK             PICK UP INITIAL TRACK
 1978 0E48 BD EA2B            JSR    SEEK             SEEK DRIVE 1 TO TRACK 0, SECTOR 1
 1979 0E4B 96 0C       DUP6   LDAA   OSCTR            PICK UP CURRENT <UNIT><SECTOR>
 1980 0E4D BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 1981 0E50 DE CA              LDX    BGBFP            PICK UP THE CURRENT TRACK BUFFER POINTER
 1982 0E52 BD 0EEB            JSR    DUWTS            WRITE A SECTOR TO DISK
 1983 0E55 DF CA              STX    BGBFP            SAVE THE CURRENT TRACK BUFFER POINTER
 1984 0E57 86 03              LDAA   #$3              INTERLEAVE SECTORS BY 3 (ALLOW PROCESSING TIME)
 1985 0E59 9B 0C              ADDA   OSCTR            TO AVOID A 1 REVOLUTION WAIT BETWEEN SECTORS
 1986 0E5B 97 0C              STAA   OSCTR            (MAINTAIN MINIMUM DISK ACCESS DELAY TIME)
 1987 0E5D C6 42              LDAB   #$42             ASSUME REV 1, START REV 2 @ SECTOR 2
 1988 0E5F 81 5C              CMPA   #28+$40          IF NEXT SECTOR IS 28, END OF REV 1
 1989 0E61 27 0F              BEQ    DUP7             THEN START REV 2
 1990 0E63 5C                 INCB                    ELSE ASSUME REV 2, START REV 3 @ SECTOR 3
 1991 0E64 81 5D              CMPA   #29+$40          IF NEXT SECTOR IS 29, END OF REV 2
 1992 0E66 27 0A              BEQ    DUP7             THEN START REV 3
 1993 0E68 81 5B              CMPA   #27+$40          IF NEXT SECTOR IS 27, END OF REV 3
 1994 0E6A 26 DF              BNE    DUP6             THEN
 1995 0E6C 86 41              LDAA   #$41             START <UNIT><SECTOR> AT
 1996 0E6E 97 0C              STAA   OSCTR            DRIVE 1, SECTOR 0 AGAIN
 1997 0E70 20 04              BRA    DUP8             CHECK CRC ON TRACK JUST WRITTEN
 1998                  *
 1999 0E72 D7 0C       DUP7   STAB   OSCTR            START REV 2 OR 3
 2000 0E74 20 D5              BRA    DUP6             WRITE INTERLEAVED SECTORS
 2001                  *
 2002 0E76 BD 0F08     DUP8   JSR    DUCRC            CHECK READ FOR CRC, IF FAILURE
 2003 0E79 27 0F              BEQ    DUP9             THEN
 2004 0E7B 86 41              LDAA   #$41             START <UNIT><SECTOR> AT
 2005 0E7D 97 0C              STAA   OSCTR            DRIVE 1, SECTOR 0 AGAIN
 2006 0E7F BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
 2007 0E82 7A 00C9            DEC    WRTRY            DECREMENT WRITE RETRY COUNTER, IF TRIES RUN OUT
 2008 0E85 26 B2              BNE    DUP5             THEN (ELSE TRY TO WRITE THE TRACK AGAIN)
 2009 0E87 7E 043C            JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 2010                  *
 2011 0E8A 7C 000B     DUP9   INC    OTRK             TAKE THE NEXT TRACK
 2012 0E8D 96 0B              LDAA   OTRK             IF THE NEXT TRACK
 2013 0E8F 81 4D              CMPA   #77              IS (LAST TRACK)+1
 2014 0E91 26 03              BNE    DUPA             THEN
 2015 0E93 7E 016E            JMP    WTCMD            WAIT FOR NEXT COMMAND
 2016                  *
 2017 0E96 7E 0DF5     DUPA   JMP    DUP1             ELSE START ON THE NEXT TRACK
 2018                  *
 2019                  *
 2020                  *READ A DISK SECTOR TO TRACK INPUT BUFFER,  IF A READ ERROR
 2021                  *PERSISTS, USE THE DATA READ ON THE FIFTH TRY
 2022                  *
 2023 0E99 86 05       DUSRD  LDAA   #$5              DEFINE A RETRY COUNT OF
 2024 0E9B B7 0155            STAA   TRYCT            5 TRIES TO READ DATA WITH ERRORS
 2025 0E9E 86 02       DUSR1  LDAA   #$2              DEFINE DISK READ COMMAND
 2026 0EA0 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
 2027 0EA3 B6 EC00            LDAA   DKDID            READ DISK STATUS
 2028 0EA6 84 08              ANDA   #$8              IF CRC ERROR
 2029 0EA8 27 08              BEQ    DUSR2            THEN
 2030 0EAA BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
 2031 0EAD 7A 0155            DEC    TRYCT            RECORD FAILED READ TRY, WHILE COUNT
 2032 0EB0 26 EC              BNE    DUSR1            TRY AGAIN, ELSE
 2033 0EB2 86 04       DUSR2  LDAA   #$4              DEFINE WRITE DATA COMMAND
 2034 0EB4 A7 00              STAA   $0,X             ASSUME USABLE SECTOR (NOT "DD" MARK)
 2035 0EB6 B6 EC00            LDAA   DKDID            IF THIS SECTOR READ AS "DD"
 2036 0EB9 84 80              ANDA   #$80             INDICATED ON "DD" STATUS BIT
 2037 0EBB 27 04              BEQ    DUSR3            THEN
 2038 0EBD 86 0E              LDAA   #$E              DEFINE WRITE "DD" COMMAND
 2039 0EBF A7 00              STAA   $0,X             PASS COMMAND TO WRITE ROUTINE
 2040 0EC1 08          DUSR3  INX                     STEP OVER THE SECTOR COMMAND BYTE IN THE BUFFER
 2041 0EC2 86 80              LDAA   #128             DEFINE BYTE COUNT FOR A SECTOR = 128
 2042 0EC4 B7 0155            STAA   BYTCT            INITIALIZE READ DATA BYTE COUNTER
 2043 0EC7 C6 40              LDAB   #$40             DEFINE READ DATA COMMAND
 2044 0EC9 86 3C       DUSR4  LDAA   #$3C             DEFINE COMMAND CONTROL
 2045 0ECB B7 EC03            STAA   DKCOC            ISSUE COMMAND CONTROL
 2046 0ECE F7 EC02            STAB   DKCOD            ISSUE COMMAND DEFINED IN B REG (READ DATA)
 2047 0ED1 B6 EC00            LDAA   DKDID            LOAD DATA READ FROM DISK BUFFER
 2048 0ED4 A7 00              STAA   $0,X             STORE DATA IN TRKBF
 2049 0ED6 08                 INX                     TAKE THE NEXT LOCATION IN TRKBF
 2050 0ED7 86 2C              LDAA   #$2C             DEFINE RESET DRIVE COMMAND
 2051 0ED9 B7 EC03            STAA   DKCOC            ISSUE RESET DRIVE
 2052 0EDC F7 EC02            STAB   DKCOD            ISSUE COMMAND DEFINED IN B REG (READ DATA)
 2053 0EDF 7F EC02            CLR    DKCOD            CLEAR THE COMMAND REGISTER
 2054 0EE2 7A 0155            DEC    BYTCT            COUNT OFF THIS BYTE, WHILE 128 BYTES
 2055 0EE5 26 E2              BNE    DUSR4            CONTINUE
 2056 0EE7 BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
 2057 0EEA 39                 RTS                     RETURN TO CALLER
 2058                  *
 2059                  *
 2060                  *WRITE A SECTOR TO DISK, USING DATA FROM THE CURRENT SECTOR
 2061                  *
 2062 0EEB A6 00       DUWTS  LDAA   $0,X             PICK UP SECTOR WRITE CONTROL BYTE
 2063 0EED 36                 PSHA                    SAVE IT TO USE AS A WRITE COMMAND AFTER BUFFER LOAD
 2064 0EEE 08                 INX                     STEP OVER THE SECTOR WRITE CONTROL BYTE
 2065 0EEF 86 80              LDAA   #128             DEFINE 128 BYTES IN A SECTOR
 2066 0EF1 B7 0155            STAA   BYTCT            FOR A WRITE BYTE COUNTER
 2067 0EF4 C6 30              LDAB   #$30             DEFINE A WRITE DISK COMMAND
 2068 0EF6 A6 00       DUWT1  LDAA   $0,X             PICK UP CURRENT DATA BYTE FROM BUFFER
 2069 0EF8 B7 EC06            STAA   DKDOD            OUTPUT IT TO THE DISK
 2070 0EFB F7 EC02            STAB   DKCOD            STROBE THE DATA IN TO THE DISK BUFFER
 2071 0EFE 08                 INX                     TAKE THE NEXT DATA BYTE
 2072 0EFF 7A 0155            DEC    BYTCT            WHILE 128 BYTES
 2073 0F02 26 F2              BNE    DUWT1            CONTINUE
 2074 0F04 32                 PULA                    GET SECTOR WRITE CONTROL BYTE
 2075 0F05 7E EA3E            JMP    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
 2076                  *AND RETURN TO CALLER
 2077                         SPC    3
 2078                  *READ A TRACK & CHECK FOR CRC ERRORS
 2079                  *
 2080 0F08 96 0C       DUCRC  LDAA   OSCTR            PICK UP CURRENT SECTOR
 2081 0F0A BD EA22            JSR    XUSP             TRANSMIT PHYSICAL <UNIT><SECTOR> TO DISK
 2082 0F0D 86 06              LDAA   #$6              DEFINE READ DISK FOR CRC COMMAND
 2083 0F0F BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
 2084 0F12 B6 EC00            LDAA   DKDID            READ DISK STATUS
 2085 0F15 84 08              ANDA   #$8              IF CRC ERROR NOT ON
 2086 0F17 26 19              BNE    DUCR2            THEN (FAILURE EXIT, Z = 0)
 2087 0F19 86 02              LDAA   #$2              INTERLEAVE SECTORS BY TWO DURING
 2088 0F1B 9B 0C              ADDA   OSCTR            CRC READ PASS (LESS CPU TIME)
 2089 0F1D 97 0C              STAA   OSCTR            DEFINE NEXT SECTOR
 2090 0F1F 81 5B              CMPA   #27+$40          IF END OR PAST PASS 1
 2091 0F21 2B E5              BMI    DUCRC            THEN
 2092 0F23 81 5C              CMPA   #28+$40          IF NOT END OF PASS 2
 2093 0F25 27 06              BEQ    DUCR1            THEN
 2094 0F27 86 42              LDAA   #$42             DEFINE SECTOR 2 ON UNIT 1
 2095 0F29 97 0C              STAA   OSCTR            FOR PASS 2
 2096 0F2B 20 DB              BRA    DUCRC            BEGIN PASS 2 (READ INTERLEAVED SECTORS)
 2097                  *
 2098 0F2D 86 41       DUCR1  LDAA   #$41             DEFINE SECTOR 1 ON UNIT 1
 2099 0F2F 97 0C              STAA   OSCTR            FOR NEXT FUNCTION
 2100 0F31 4F                 CLRA                    SET Z = 1 (SUCCESS EXIT)
 2101 0F32 39          DUCR2  RTS                     RETURN TO CALLER
