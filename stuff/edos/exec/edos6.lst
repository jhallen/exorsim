  318 0335 BD 03CB     USCMD  JSR    CRLF             ESTABLISH NEW LINE ON CONSOLE
  319 0338 86 21              LDAA   #'!              PRINT AN ASCII "!"
  320 033A BD F018            JSR    PRINC            USER PROMPT CHARACTER
  321 033D CE 006C            LDX    #IBUF1           SET POINTER TO INPUT BUFFER START
  322 0340 DF BC              STX    BFPT1            INITIALIZE POINTER COPY TO BUFFER START
  323 0342 BD 03CF     USCM1  JSR    ECHOC            GET A CONSOLE INPUT CHARACTER
  324 0345 81 7F              CMPA   #$7F             IF NOT AN ASCII RUBOUT OR "BREAK"
  325 0347 27 15              BEQ    USCM3            AND
  326 0349 4D                 TSTA                    NOT AN ASCII NULL
  327 034A 27 1F              BEQ    USCM4            THEN
  328 034C A7 00              STAA   $0,X             STORE THE CHARACTER
  329 034E 08                 INX                     STEP ON TO THE NEXT BUFFER LOCATION
  330 034F 8C 00BC            CPX    #IBUF1+80        IF BUFFER OVERFLOW
  331 0352 26 03              BNE    USCM2            THEN
  332 0354 7E 0183            JMP    ERRM             TELL USER FORMAT ERROR, WAIT FOR NEW COMMAND
  333 0357 81 0D       USCM2  CMPA   #CR              IF A <CR> CHARACTER
  334 0359 26 E7              BNE    USCM1            THEN
  335 035B DF BE              STX    BFND1            COMMAND ENDED, COPY END POINT (NOT USED!)
  336 035D 39                 RTS                     RETURN THE COMPLETE COMMAND STRING
  337                  *
  338                  *THIS ROUTINE DELETES CHARACTERS FROM THE COMMAND INPUT BUFFER
  339                  *ECHOING THE CHARACTERS AS THEY ARE DELETED FROM THE BUFFER
  340                  *
  341 035E 8C 006C     USCM3  CPX    #IBUF1           RUBOUT FOUND, IF BUFFER EMPTY
  342 0361 27 D2              BEQ    USCMD            ISSUE NEW PROMPT, START AGAIN
  343 0363 09                 DEX                     ELSE BACK UP POINTER
  344 0364 A6 00              LDAA   $0,X             GET THROWN-OUT CHARACTER
  345 0366 BD F018            JSR    PRINC            AND PRINT IT
  346 0369 20 D7              BRA    USCM1            GET NEXT INPUT CHARACTER
  347                  *
  348 036B 7E 016E     USCM4  JMP    WTCMD            WAIT FOR NEXT USER COMMAND INPUT
  349                  *
  350                  *
  351                  *THIS ROUTINE PARSES A SINGLE COMMAND OR FILE NAME AND
  352                  *LEAVES IT IN FLNM0-4.  IF A UID WAS SPECIFIED, IT IS LEFT IN FLNM5.
  353                  *
  354 036E CE 00C0     PRSFL  LDX    #FLNM0           FILL FLNM0-4 WITH
  355 0371 86 20              LDAA   #SPC             ASCII SPACE CHARACTERS
  356 0373 C6 05              LDAB   #$5              AS A DEFAULT VALUE
  357 0375 A7 00       PRSF1  STAA   $0,X             STORE A SPACE CHARACTER
  358 0377 08                 INX                     STEP ON TO THE NEXT POSITION
  359 0378 5A                 DECB                    WHILE FLNM0 TO FLNM4
  360 0379 26 FA              BNE    PRSF1            CONTINUE
  361 037B 7F 00C5            CLR    FLNM5            SET DEFAULT UNIT ID = 0 (SYS DISK)
  362 037E CE 00C0            LDX    #FLNM0           START TO TRANSFER IN A COMMAND OR FILE NAME
  363 0381 BD 03A6     PRSF2  JSR    NXITM            GET A CHARACTER FROM THE STRING
  364 0384 81 3A              CMPA   #':              IF IT IS ASCII ":"
  365 0386 26 14              BNE    NOUID            THEN
  366 0388 BD 03A6            JSR    NXITM            GET THE NEXT CHARACTER
  367 038B 80 30              SUBA   #'0              STRIP DECIMAL ASCII TO BINARY
  368 038D 16                 TAB                     COPY THE RESULT IN B
  369 038E 84 FC              ANDA   #$FC             IF INTEGER RESULT IS .LE. 3
  370 0390 26 07              BNE    UIDER            THEN
  371 0392 D7 C5              STAB   FLNM5            ACCEPT & STORE UNIT ID
  372 0394 BD 03A6     PRSF3  JSR    NXITM            GET DELIMITER (COMMA)
  373 0397 20 FB              BRA    PRSF3            OR TERMINATOR <CR>
  374                  *
  375 0399 7E 0183     UIDER  JMP    ERRM             TELL USER FORMAT ERROR, TRY AGAIN
  376                  *
  377 039C 8C 00C5     NOUID  CPX    #FLNM5           IF ROOM IN FIELD
  378 039F 27 E0              BEQ    PRSF2            THEN
  379 03A1 A7 00              STAA   $0,X             STORE THE CHARACTER
  380 03A3 08                 INX                     STEP OVER THE LOCATION
  381 03A4 20 DB              BRA    PRSF2            GET THE NEXT CHARACTER
  382                  *
  383                  *THIS ROUTINE PASSES SINGLE CHARACTERS BACK TO PRSFL.  WHEN A DELIMITER
  384                  *(COMMA) OR TERMINATOR <CR> IS FOUND, PRSFL IS TERMINATED (ERSATZ RTS)
  385                  *
  386 03A6 FF 03BF     NXITM  STX    ITMDX            SAVE CURRENT INDEX REGISTER
  387 03A9 DE BC              LDX    BFPT1            PICK UP SCAN POINTER
  388 03AB A6 00              LDAA   $0,X             PICK UP A CHARACTER
  389 03AD 81 0D              CMPA   #CR              IF NOT AN ASCII <CR>
  390 03AF 27 0B              BEQ    NXIT1            THEN
  391 03B1 08                 INX                     STEP POINTER TO NEXT CHARACTER
  392 03B2 DF BC              STX    BFPT1            STORE THE SCAN POINTER
  393 03B4 81 2C              CMPA   #',              IF NOT A COMMA
  394 03B6 27 04              BEQ    NXIT1            THEN
  395 03B8 FE 03BF            LDX    ITMDX            RESTORE INDEX REGISTER
  396 03BB 39                 RTS                     RETURN THE CHARACTER
  397                  *
  398 03BC 31          NXIT1  INS                     IF CHARACTER COMMA OR <CR>
  399 03BD 31                 INS                     DELETE RETURN ADDRESS
  400 03BE 39                 RTS                     TERMINATE & RETURN FROM PRSFL
  401                  *
  402 03BF             ITMDX  RMB    2                NXITM INDEX SAVE LOCATION
  403                  *
  404                  *
  405                  *THIS ROUTINE PRINTS OUT A STRING OF ASCII CHARACTERS
  406                  *START ADDRESS IS IN X, NUMBER OF CHARACTERS IN B
  407                  *
  408 03C1 A6 00       PRINS  LDAA   $0,X             GET A CHARACTER
  409 03C3 BD F018            JSR    PRINC            PRINT IT OUT
  410 03C6 08                 INX                     STEP TO NEXT CHARACTER
  411 03C7 5A                 DECB                    WHILE CHARACTERS
  412 03C8 26 F7              BNE    PRINS            CONTINUE
  413 03CA 39                 RTS                     RETURN TO CALLER
  414                  *
  415                  *
  416                  *THIS ROUTINE PRODUCES <CR> <LF> ON THE CONSOLE
  417                  *(ESTABLISH A NEW LINE FOR THE NEXT FUNCTION)
  418                  *
  419 03CB 86 0D       CRLF   LDAA   #CR              DEFINE AN ASCII <CR>
  420 03CD 20 09              BRA    ECHO1            BORROW THE ECHO FUNCTION
  421                  *
  422                  *THIS ROUTINE ECHOS INPUT CHARACTERS, EXCEPT RUBOUT OR "BREAK"
  423                  *THE PARITY BIT IS STRIPPED, AND <CR> IS AMPLIFIED TO <CR> <LF>
  424                  *THE INPUT CHARACTER IS PASSED THROUGH THIS ROUTINE
  425                  *
  426 03CF BD 03E9     ECHOC  JSR    GETCH            GET AN INPUT CHARACTER
  427 03D2 84 7F              ANDA   #$7F             STRIP OFF THE PARITY BIT
  428 03D4 81 7F              CMPA   #$7F             IF NOT A RUBOUT OR "BREAK"
  429 03D6 27 10              BEQ    ECHO2            THEN
  430 03D8 36          ECHO1  PSHA                    SAVE THE CHARACTER
  431 03D9 BD F018            JSR    PRINC            PRINT THE CHARACTER
  432 03DC 32                 PULA                    RESTORE THE CHARACTER
  433 03DD 81 0D              CMPA   #CR              IF IT IS ASCII <CR>
  434 03DF 26 07              BNE    ECHO2            THEN
  435 03E1 36                 PSHA                    SAVE THE CHARACTER AGAIN
  436 03E2 86 0A              LDAA   #LF              DEFINE AN ASCII <LF>
  437 03E4 BD F018            JSR    PRINC            AND DO A CONSOLE LINE FEED
  438 03E7 32                 PULA                    RESTORE THE CHARACTER
  439 03E8 39          ECHO2  RTS                     RETURN TO CALLER
  440                  *
  441                  *
  442                  *THIS ROUTINE LOOPS ON THE ACIA STATUS REGISTER DONE BIT WAITING FOR
  443                  *A CHARACTER.  THE CPU WAITS HERE UNTIL A CHARACTER IS READY.  WHEN
  444                  *A CHARACTER IS PRESENTED, IT IS RETURNED TO CALLER IN A.
  445                  *
  446 03E9 B6 FCF4     GETCH  LDAA   ACIAS            READ THE ACIA STATUS
  447 03EC 47                 ASRA                    IF CHARACTER IS AVAILABLE
  448 03ED 24 FA              BCC    GETCH            THEN
  449 03EF B6 FCF5            LDAA   ACIAR            READ THE CHARACTER
  450 03F2 0C                 CLC                     CLEAR THE "C" BIT
  451 03F3 39                 RTS                     RETURN THE CHARACTER
  452                  *
  453                  *
  454                  *THIS ROUTINE PERFORMS BINARY TO HEX CONVERSION,
  455                  *AND PRINTS THE RESULT USING THE SWITCHED PRINT
  456                  *VECTOR TO SELECT THE OUTPUT DEVICE.
  457                  *
  458 03F4 97 C9       PRBIN  STAA   HDIGT            COPY THE BINARY DATA
  459 03F6 44                 LSRA                    SHIFT THE 4
  460 03F7 44                 LSRA                    MOST SIGNIFICANT
  461 03F8 44                 LSRA                    BITS INTO A
  462 03F9 44                 LSRA                    BINARY VALUE
  463 03FA BD 0404            JSR    PRBN1            PRINT THE VALUE(H)
  464 03FD 96 C9              LDAA   HDIGT            GET THE BINARY DATA
  465 03FF 84 0F              ANDA   #$0F             STRIP OFF THE HIGH DIGIT
  466 0401 7E 0404            JMP    PRBN1            PRINT THE VALUE(L) & RETURN
  467                  *
  468 0404 81 0A       PRBN1  CMPA   #$0A             IF .GE. 9
  469 0406 2B 02              BMI    PRBN2            THEN
  470 0408 8B 07              ADDA   #$7              SKIP OVER : TO @
  471 040A 8B 30       PRBN2  ADDA   #'0              CONVERT TO ASCII (HEX)
  472 040C 7E 0030            JMP    PRNVC            PRINT, USING SWITCHED PRINT & RETURN
  473                  *
  474                  *
  475                  *THIS ROUTINE READS A FULL DISK SECTOR FROM THE DEFINED
  476                  *UNIT/TRACK/SECTOR, LEAVING THE RESULT BEGINNING AT THE
  477                  *ADDRESS IN X.  SUCCESS RETURN IS A = 0
  478                  *
  479 040F DF CA       RED11  STX    SECP1            SAVE INDEX REGISTER
  480 0411 37                 PSHB                    SAVE DEFINED TRACK
  481 0412 BD EA03            JSR    XUS              TRANSMIT <UNIT><SECTOR> TO DISK
  482 0415 BD 0476            JSR    DSKRD            IF DISK IS READY, THEN
  483 0418 32                 PULA                    GET DEFINED TRACK
  484 0419 BD EA2B            JSR    SEEK             SEEK SELECTED UNIT TO DEFINED TRACK
  485 041C 86 05              LDAA   #$5              SET RETRY COUNT FOR 5
  486 041E B7 0155            STAA   TRYCT            ATTEMPTED RETRIES ON READ ERROR
  487 0421 86 02       RED12  LDAA   #$2              DEFINE READ COMMAND
  488 0423 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  489 0426 B6 EC00            LDAA   DKDID            READ THE DISK STATUS
  490 0429 84 80              ANDA   #$80             IF DELETED DATA (DD), REPORT IT
  491 042B 26 18              BNE    RED14            ELSE
  492 042D B6 EC00            LDAA   DKDID            READ THE DISK STATUS
  493 0430 84 08              ANDA   #$08             IF CRC ERROR
  494 0432 27 17              BEQ    RED15            THEN
  495 0434 BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
  496 0437 7A 0155            DEC    TRYCT            DECREMENT TRY COUNTER
  497 043A 26 E5              BNE    RED12            THEN
  498 043C F6 02DD     MEDER  LDAB   MEDEM            GET CHARACTER COUNT AND POINTER
  499 043F CE 02DE            LDX    #MEDEM+1         FOR "MEDIA ERROR" MESSAGE
  500 0442 7E 0189            JMP    MSWTC            PRINT IT & WAIT FOR COMMAND INPUT
  501                  *
  502 0445 BD EA38     RED14  JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
  503 0448 86 80              LDAA   #$80             DEFINE OPERATION RESULT NON-ZERO, MINUS
  504 044A 39                 RTS                     RETURN TO CALLER (FAILED)
  505                  *
  506 044B DE CA       RED15  LDX    SECP1            PICK UP THE INDEX POINTER
  507 044D 86 80              LDAA   #$80             DEFINE COUNT OF BYTES IN A FULL SECTOR
  508 044F B7 0155            STAA   BYTCT            FOR A COUNT (128 BYTES)
  509 0452 86 3C       RED16  LDAA   #$3C             DEFINE DISK COMMAND MODE
  510 0454 B7 EC03            STAA   DKCOC            SET DISK TO COMMAND MODE
  511 0457 86 40              LDAA   #$40             DEFINE READ DATA COMMAND
  512 0459 B7 EC02            STAA   DKCOD            COMMAND DISK TO READ
  513 045C B6 EC00            LDAA   DKDID            READ THE DATA FROM THE IDISK
  514 045F A7 00              STAA   $00,X            STORE AWAY READ BYTE
  515 0461 86 2C              LDAA   #$2C             DEFINE RESET COMMAND MODE
  516 0463 B7 EC03            STAA   DKCOC            RESET DISK FROM COMMAND MODE
  517 0466 86 40              LDAA   #$40             DEFINE READ DATA COMMAND
  518 0468 B7 EC02            STAA   DKCOD            STROBE IN RESET COMMAND MODE
  519 046B 7F EC02            CLR    DKCOD            CLEAR COMMAND OUT OF PIA
  520 046E 08                 INX                     TAKE THE NEXT BYTE
  521 046F 7A 0155            DEC    BYTCT            WHILE BYTES
  522 0472 26 DE              BNE    RED16            CONTINUE
  523 0474 4F                 CLRA                    DEFINE OPERATION RESULT ZERO (SUCCESS)
  524 0475 39                 RTS                     RETURN TO CALLER (SUCCESS)
  525                  *
  526                  *
  527                  *THIS ROUTINE CHECKS ON DISK READY FOR USE.  IF READY,
  528                  *RETURNS TO CALLER, IF NOT READY,  ABORTS OPERATION
  529                  *PRINTS "DISK NOT READY" & WAITS FOR COMMAND
  530                  *
  531 0476 B6 EC00     DSKRD  LDAA   DKDID            READ DISK STATUS REGISTER
  532 0479 84 20              ANDA   #$20             IF SELECTED DISK READY
  533 047B 26 01              BNE    DSKR1            THEN
  534 047D 39                 RTS                     RETURN, ELSE
  535 047E F6 02CE     DSKR1  LDAB   DKNRM            GET CHARACTER COUNT AND POINTER
  536 0481 CE 02CF            LDX    #DKNRM+1         FOR "DISK NOT READY" MESSAGE
  537 0484 7E 0189            JMP    MSWTC            PRINT IT, AND WAIT FOR COMMAND INPUT
  538                  *
  539                  *
  540                  *THIS ROUTINE WRITES DATA TO DISK.  DATA IS POINTED TO
  541                  *BY X REGISTER. A FULL SECTOR OF 128 BYTES IS ASSUMED AND
  542                  *WRITTEN.  A WRITE FAILURE RETURNS A = 1, SUCCESS - A = 0.
  543                  *
  544 0487 DF CA       WRTSE  STX    SECP1            SAVE THE DATA POINTER
  545 0489 37                 PSHB                    SAVE THE SELECTED TRACK
  546 048A BD EA03            JSR    XUS              TRANSMIT <UNIT><SECTOR> TO DISK
  547 048D BD 0476            JSR    DSKRD            IF DISK IS READY, THEN
  548 0490 32                 PULA                    GET THE SELECTED TRACK
  549 0491 BD EA2B            JSR    SEEK             SEEK TO THE SELECTED TRACK
  550 0494 86 05              LDAA   #$5              SET TRY COUNT FOR 5
  551 0496 B7 0155            STAA   TRYCT            ATTEMPTED RETRIES ON READ ERROR
  552 0499 DE CA              LDX    SECP1            PICK UP THE DATA POINTER
  553 049B C6 80              LDAB   #128             DEFINE A SECTOR = 128 DECIMAL BYTES
  554                  *
  555 049D A6 00       WRTS1  LDAA   0,X              PICK UP A DATA BYTE
  556 049F B7 EC06            STAA   DKDOD            LOAD DATA TO BUFFER
  557 04A2 86 30              LDAA   #$30             DEFINE LOAD COMMAND
  558 04A4 B7 EC02            STAA   DKCOD            COMMAND BUFFER TO LOAD
  559 04A7 08                 INX                     STEP TO THE NEXT DATA BYTE
  560 04A8 5A                 DECB                    WHILE SECTOR BYTES
  561 04A9 26 F2              BNE    WRTS1            CONTINUE
  562                  *
  563 04AB 86 04       WRTS2  LDAA   #$04             DEFINE WRITE COMMAND
  564 04AD BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  565 04B0 86 06              LDAA   #$06             ASK DISK FOR STATUS
  566 04B2 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  567 04B5 B6 EC00            LDAA   DKDID            READ THE REQUESTED STATUS
  568 04B8 84 08              ANDA   #$08             IF THERE WAS A CRC ERROR
  569 04BA 27 0F              BEQ    WRTS3            THEN (SUCCESS EXIT, A = 0)
  570 04BC BD EA38            JSR    RFLAG            RESET ERROR FLAG ON DISK I/F
  571 04BF 7A 0155            DEC    TRYCT            IF RETRY COUNT RUN OUT
  572 04C2 26 E7              BNE    WRTS2            THEN
  573 04C4 86 0E              LDAA   #$0E             ASK DISK TO MARK THIS SECTOR = DD
  574 04C6 BD EA3E            JSR    LOOP             ISSUE COMMAND TO DISK (LOOP ON BUSY)
  575 04C9 86 01              LDAA   #1               FAILURE EXIT, SET A .NE. 0
  576 04CB 39          WRTS3  RTS                     RETURN TO CALLER
  577                  *
  578                  *
  579                  *THIS ROUTINE SEARCHES THE DEFINED DISK DIRECTORY FOR A FILE NAME.
  580                  *IF FOUND, X POINTS TO THE FCB OF THAT FILE IN THE BUFFER, AND A = 0.
  581                  *
  582 04CC 0C          FNDFL  CLC                     CLEAR THE C BIT FOR SHIFT
  583 04CD 96 C5              LDAA   FLNM5            PICK UP CURRENT UNIT ID
  584 04CF 46                 RORA                    SHIFT UID BITS 1,0
  585 04D0 46                 RORA                    INTO BITS 7,6 OF RESULT
  586 04D1 46                 RORA                    BIT 7 BECOMES OLD 1, 6 BECOMES OLD 0
  587 04D2 8A 04              ORAA   #4               START AT SECTOR 4
  588 04D4 B7 0150            STAA   USECT            INITIALIZE SEARCH SECTOR VALUE
  589 04D7 B6 0150     FNDF1  LDAA   USECT            PICK UP SEARCH SECTOR VALUE
  590 04DA 84 3F              ANDA   #$3F             STRIP OFF UID
  591 04DC 81 1B              CMPA   #$1B             IF NOT RUN OUT OF SECTORS
  592 04DE 27 42              BEQ    FNDFX            THEN (FAILURE EXIT A .NE. 0)
  593 04E0 CE 00D0            LDX    #SECB1           DEFINE DISK SECTOR BUFFER #1
  594 04E3 B6 0150            LDAA   USECT            PICK UP SEARCH SECTOR VALUE
  595 04E6 5F                 CLRB                    ON TRACK 0
  596 04E7 BD 040F            JSR    RED11            READ A DISK SECTOR INTO BUFFER
  597 04EA 4D                 TSTA                    IF NOT SUCCESSFUL
  598 04EB 27 05              BEQ    FNDF2            THEN
  599 04ED 7C 0150            INC    USECT            TRY THE NEXT SECTOR
  600 04F0 20 E5              BRA    FNDF1            WHILE SECTORS LAST
  601 04F2 CE 00D0     FNDF2  LDX    #SECB1           START AT BEGINNING OF BUFFER
  602 04F5 DF CE              STX    SESP1            INITIALIZE SCAN POINTER
  603 04F7 DE CE       FNDF3  LDX    SESP1            PICK UP SCAN POINTER
  604 04F9 A6 05              LDAA   $5,X             PICK UP THIS FILE'S ATTRIBUTES
  605 04FB 81 FF              CMPA   #$FF             IF THIS IS NOT THE END OF DIRECTORY
  606 04FD 27 23              BEQ    FNDFX            AND (FAILURE EXIT A .NE. 0)
  607 04FF 81 80              CMPA   #$80             IF THIS IS NOT A DELETED FILE
  608 0501 27 20              BEQ    FNDF4            AND
  609 0503 A6 00              LDAA   $0,X             THE FIRST CHARACTER EQUALS
  610 0505 91 C0              CMPA   FLNM0            THE FIRST SEARCH CHARACTER
  611 0507 26 1A              BNE    FNDF4            AND
  612 0509 A6 01              LDAA   $1,X             THE SECOND CHARACTER EQUALS
  613 050B 91 C1              CMPA   FLNM1            THE SECOND SEARCH CHARACTER
  614 050D 26 14              BNE    FNDF4            AND
  615 050F A6 02              LDAA   $2,X             THE THIRD CHARACTER EQUALS
  616 0511 91 C2              CMPA   FLNM2            THE THIRD SEARCH CHARACTER
  617 0513 26 0E              BNE    FNDF4            AND
  618 0515 A6 03              LDAA   $3,X             THE FOURTH CHARACTER EQUALS
  619 0517 91 C3              CMPA   FLNM3            THE FOURTH SEARCH CHARACTER
  620 0519 26 08              BNE    FNDF4            AND
  621 051B A6 04              LDAA   $4,X             THE FIFTH CHARACTER EQUALS
  622 051D 91 C4              CMPA   FLNM4            THE FIFTH SEARCH CHARACTER
  623 051F 26 02              BNE    FNDF4            THEN
  624 0521 4F                 CLRA                    FILE NAME IS FOUND (SUCCESS EXIT A = 0)
  625 0522 39          FNDFX  RTS                     RETURN TO CALLER
  626                  *
  627 0523 86 0B       FNDF4  LDAA   #11              DEFINE DIRECTORY ENTRY SIZE (11 BYTES / ENTRY)
  628 0525 5F                 CLRB                    ALLOWING A HIGH BYTE OF 0
  629 0526 9B CF              ADDA   SESP1+LBYT       ADD ENTRY SIZE TO CURRENT
  630 0528 D9 CE              ADCB   SESP1            BUFFER SCAN POINTER (2 BYTE ADD)
  631 052A 97 CF              STAA   SESP1+LBYT       UPDATE THE BUFFER SCAN POINTER
  632 052C D7 CE              STAB   SESP1            MODULO <ENTRY SIZE>
  633 052E DE CE              LDX    SESP1            IF THE BUFFER HAS
  634 0530 8C 0149            CPX    #SECB1+121       NO MORE DIRECTORY ENTRIES
  635 0533 26 C2              BNE    FNDF3            THEN
  636 0535 7C 0150            INC    USECT            TRY THE NEXT SECTOR
  637 0538 20 9D              BRA    FNDF1            AND KEEP LOOKING
  638                  *
  639                  *
  640                  *THIS ROUTINE SETS UP AN INPUT FILE ON THE FILE DEFINITION LOCATIONS.
  641                  *IF NO FILE, FAILURE IS REPORTED.  SUCCESS - A = 0, FAILURE - A .NE. 0
  642                  *
  643 053A BD 04CC     DFINF  JSR    FNDFL            LOOK FOR THIS FILE NAME IN THE DIRECTORY
  644 053D 4D                 TSTA                    IF IT DOES NOT EXIST
  645 053E 27 01              BEQ    DFIN1            THEN
  646 0540 39                 RTS                     FAILURE EXIT A .NE. 0
  647 0541 DE CE       DFIN1  LDX    SESP1            GET FILE CONTROL BLOCK ADDRESS
  648 0543 E6 06              LDAB   $6,X             USE DESCRIPTOR "TRACK"
  649 0545 D7 06              STAB   ITRK             TO DEFINE ITRK
  650 0547 E6 08              LDAB   $8,X             USE DESCRIPTOR SIZE(H)
  651 0549 D7 04              STAB   ISIZE            TO DEFINE ISIZE(H)
  652 054B E6 09              LDAB   $9,X             USE DESCRIPTOR SIZE(L)
  653 054D D7 05              STAB   ISIZE+1          TO DEFINE ISIZE(L)
  654 054F 7F 0008            CLR    ICNTR            CLEAR INPUT FILE BYTE COUNTER
  655 0552 D6 C5              LDAB   FLNM5            PICK UP CURRENT UNIT ID
  656 0554 0C                 CLC                     CLEAR "C" FOR SHIFTING
  657 0555 56                 RORB                    SHIFT UID BITS 1,0
  658 0556 56                 RORB                    INTO BITS 7,6
  659 0557 56                 RORB                    7 BECOMES OLD 1, 6 BECOMES OLD 0
  660 0558 EA 07              ORAB   $7,X             OR IN SECTOR NUMBER FROM DESCRIPTOR
  661 055A 5A                 DECB                    MINUS ONE
  662 055B D7 07              STAB   ISCTR            STORE IN ISCTR
  663 055D 0C                 CLC                     CLEAR "C" FOR REVERSE SHIFT
  664 055E 59                 ROLB                    SHIFT UID BITS BACK INTO BITS 1,0
  665 055F 59                 ROLB                    SECTOR NUMBER GOES INTO
  666 0560 59                 ROLB                    BITS 6-2 OF RESULT
  667 0561 D7 03              STAB   IUNIT            STORE COMBINED RESULT IN IUNIT
  668 0563 4F                 CLRA                    CLEAR A, SIGNALING SUCCESS
  669 0564 39                 RTS                     RETURN TO CALLER
  670                  *
  671                  *
  672                  *
  673                  *
  674                  *THIS ROUTINE IS SIMILAR TO DFINF.  IF CALLED, IT WOULD DEFINE AN
  675                  *OUTPUT FILE IN THE OUTPUT FILE DEFINITION LOCATIONS.  IT DOES NOT
  676                  *APPEAR TO BE USED.  AN EXISTING FILE WILL BE PRECISELY OVERWRITTEN
  677                  *IF IT IS CALLED, WITH NO CHANGE IN FILE SIZE.
  678                  *
  679 0565 BD 04CC     DFOFL  JSR    FNDFL            LOOK FOR THIS FILE NAME IN THE DIRECTORY
  680 0568 4D                 TSTA                    IF IT DOES NOT EXIST
  681 0569 27 01              BEQ    DFOF1            THEN
  682 056B 39                 RTS                     FAILURE EXIT A .NE. 0
  683 056C DE CE       DFOF1  LDX    SESP1            GET FILE CONTROL BLOCK ADDRESS
  684 056E E6 06              LDAB   $6,X             USE DESCRIPTOR "TRACK"
  685 0570 D7 0B              STAB   OTRK             TO DEFINE OTRK
  686 0572 E6 08              LDAB   $8,X             USE DESCRIPTOR "SIZE"
  687 0574 A6 09              LDAA   $9,X             (2 BYTES)
  688 0576 80 01              SUBA   #$1              MINUS 1 SECTOR
  689 0578 C2 00              SBCB   #$0              (2 BYTES)
  690 057A D7 09              STAB   OSIZE            TO DEFINE OSIZE
  691 057C 97 0A              STAA   OSIZE+LBYT       (2 BYTES)
  692 057E 7F 000D            CLR    OCNTR            CLEAR OUTPUT FILE BYTE COUNTER
  693 0581 D6 C5              LDAB   FLNM5            PICK UP UNIT I/D
  694 0583 D7 02              STAB   OUNIT            AND DEFINE OUNIT
  695 0585 0C                 CLC                     CLEAR "C" FOR SHIFTING
  696 0586 56                 RORB                    SHIFT UID BITS 1,0
  697 0587 56                 RORB                    INTO BITS 7,6
  698 0588 56                 RORB                    7 BECOMES OLD 1, 6 BECOMES OLD 0
  699 0589 EA 07              ORAB   $7,X             OR IN SECTOR NUMBER FROM DESCRIPTOR
  700 058B D7 0C              STAB   OSCTR            WHICH DEFINES OSCTR
  701 058D 4F                 CLRA                    CLEAR A, SIGNALLING SUCCESS
  702 058E 39                 RTS                     RETURN TO CALLER
  703                  *
  704                  *
  705                  *
  706                  *THIS ROUTINE ATTEMPTS TO CREATE A FILE ENTRY IN THE DIRECTORY
  707                  *VARIOUS RETURN FLAGS EXIST. THEY ARE ASSIGNED AS FOLLOWS:
  708                  *A = 0 SUCCESS, FILE CREATED IN DIRECTORY
  709                  *A = 1 FAILURE, NO ROOM LEFT IN DIRECTORY
  710                  *A = 2 FAILURE, THIS FILE NAME ALREADY EXISTS
  711                  *A = 3 FAILURE, NOT ENOUGH ROOM ON THE DISK
  712                  *
  713 058F BD 04CC     CREAF  JSR    FNDFL            SEARCH FOR FILE NAME (DUPLICATE) IN DIRECTORY
  714 0592 4D                 TSTA                    IF DUPLICATE FILE NAME IS FOUND
  715 0593 26 03              BNE    CREA1            THEN
  716 0595 86 02              LDAA   #$2              DEFINE FLAG VALUE = DUPLICATE FILE
  717 0597 39                 RTS                     AND RETURN (FAILURE)
  718 0598 81 FF       CREA1  CMPA   #$FF             IF DIRECTORY IS FULL (NO EOD MARK)
  719 059A 27 03              BEQ    CREA2            THEN
  720 059C 86 01              LDAA   #$1              DEFINE FLAG VALUE = NO ROOM
  721 059E 39                 RTS                     AND RETURN (FAILURE)
  722 059F DE CE       CREA2  LDX    SESP1            LOAD SCAN POINTER
  723 05A1 86 1A              LDAA   #26              THERE ARE 26 SECTORS PER TRACK
  724 05A3 B7 0155            STAA   SECCT            PREPARE TO COUNT BY <SECTOR><TRACK>
  725 05A6 4F                 CLRA                    STARTING FROM
  726 05A7 5F                 CLRB                    0, COUNT OFF SECTOR MODULUS
  727 05A8 AB 06       CREA3  ADDA   $6,X             TIMES THE TRACKS
  728 05AA C9 00              ADCB   #$0              ALREADY USED
  729 05AC 7A 0155            DEC    SECCT            GIVING THE NO. OF SECTORS
  730 05AF 26 F7              BNE    CREA3            ALREADY USED (TO THIS TRACK)
  731 05B1 AB 07              ADDA   $7,X             THEN ADD THE SECTORS ALREADY USED ON
  732 05B3 C9 00              ADCB   #$0              THIS TRACK, GIVING SECTORS USED (TOTAL)
  733 05B5 B7 0156            STAA   SECCT+1          PUT AWAY THE CALCULATED
  734 05B8 F7 0155            STAB   SECCT            NUMBER OF SECTORS ALREADY USED
  735 05BB CE 07D0            LDX    #2000            THERE ARE 2000 SECTORS AVAILABLE ON THE DISK
  736 05BE DF CA              STX    SECAV            CALCULATE
  737 05C0 D6 CA              LDAB   SECAV            THAT THE
  738 05C2 96 CB              LDAA   SECAV+1          AVAILABLE SECTORS
  739 05C4 B0 0156            SUBA   SECCT+1          MINUS THE USED
  740 05C7 F2 0155            SBCB   SECCT            SECTORS GIVES THE FREE SECTORS
  741 05CA D7 CA              STAB   SECAV            SAVE THE NEW
  742 05CC 97 CB              STAA   SECAV+1          FREE SECTORS
  743 05CE 90 C8              SUBA   FILRQ+1          SUBTRACT THE NEW FILE'S SECTOR REQUIREMENT
  744 05D0 D2 C7              SBCB   FILRQ            IF NOT ENOUGH SECTORS ARE FREE
  745 05D2 2A 05              BPL    CREA4            THEN
  746 05D4 DE CA              LDX    SECAV            DEFINE HOW MANY SECTORS ARE AVAILABLE
  747 05D6 86 03              LDAA   #$3              FLAG "NOT ENOUGH ROOM ON DISK"
  748 05D8 39                 RTS                     RETURN TO CALLER (FAILURE)
  749                  *
  750                  *FILE IS PERMISSIBLE, CREATE THE DIRECTORY ENTRY
  751                  *
  752 05D9 DE CE       CREA4  LDX    SESP1            PICK UP THE POINTER TO CURRENT E.O.D. FCB
  753 05DB 96 C0              LDAA   FLNM0            CONVERT THE CURRENT END-OF-DIRECTORY
  754 05DD A7 00              STAA   $0,X             FILE CONTROL BLOCK INTO A DIRECTORY
  755 05DF 96 C1              LDAA   FLNM1            ENTRY FOR THE REQUESTED FILE
  756 05E1 A7 01              STAA   $1,X             BY TRANSFERRING THE REQUESTED
  757 05E3 96 C2              LDAA   FLNM2            FILE NAME INTO THE CURRENT FCB
  758 05E5 A7 02              STAA   $2,X             AS IT RESIDES IN THE SECTOR BUFFER.
  759 05E7 96 C3              LDAA   FLNM3            (A NEW END-OF-DIRECTORY
  760 05E9 A7 03              STAA   $3,X             FILE CONTROL BLOCK MUST BE
  761 05EB 96 C4              LDAA   FLNM4            CREATED TO REPLACE THIS ONE)
  762 05ED A7 04              STAA   $4,X             LAST NAME CHARACTER, NOW
  763                  *
  764 05EF 96 C6       WTNDX  LDAA   FILAT            LOAD REQUESTED FILE ATTRIBUTE
  765 05F1 A7 05              STAA   5,X              INTO "ATTRIBUTE" IN FCB
  766 05F3 D6 C7              LDAB   FILRQ            PICK UP REQUESTED FILE SIZE
  767 05F5 96 C8              LDAA   FILRQ+1          IN SECTORS TO BE WRITTEN
  768 05F7 8B 01              ADDA   #1               ADD 1, TO ALLOW FOR A POSSIBLE
  769 05F9 C9 00              ADCB   #0               SECTOR OVERFLOW
  770 05FB E7 08              STAB   8,X              SET THIS ALLOCATION INTO THE
  771 05FD A7 09              STAA   9,X              FILE LENGTH IN FCB TEMPLATE
  772 05FF E6 06              LDAB   6,X              LOAD START TRACK FROM OLD FCB
  773 0601 A6 07              LDAA   7,X              LOAD START SECTOR FROM OLD FCB
  774 0603 F7 0153            STAB   STRAK            SAVE THE TRACK
  775 0606 B7 0154            STAA   STSEC            SAVE THE SECTOR
  776 0609 DE C7              LDX    FILRQ            IF THE SECTORS REQUIRED
  777 060B 8C 0000            CPX    #$0              ARE DEFINED AS 0
  778 060E 26 07              BNE    WTND1            THEN
  779 0610 08                 INX                     ALLOCATE ONE SECTOR
  780 0611 DF C7              STX    FILRQ            AS A MINIMUM REQUEST
  781 0613 DE CE              LDX    SESP1            GET THE SECTOR BUFFER POINTER
  782 0615 20 D8              BRA    WTNDX            ALLOCATE THE 1 SECTOR MINIMUM
  783                  *
  784 0617 8C 0000     WTND1  CPX    #$0              IF ALLOCATION IS NOT COMPLETE
  785 061A 27 0B              BEQ    WTND3            THEN
  786 061C 4C                 INCA                    TAKE THE NEXT SECTOR
  787 061D 81 1B              CMPA   #27              IF NO MORE SECTORS
  788 061F 26 03              BNE    WTND2            THEN
  789 0621 5C                 INCB                    TAKE THE NEXT TRACK
  790 0622 86 01              LDAA   #$1              SECTOR NUMBER 1
  791 0624 09          WTND2  DEX                     COUNT OFF THIS SECTOR, IF ALL GONE
  792 0625 26 F0              BNE    WTND1            THEN
  793 0627 F7 0151     WTND3  STAB   CRTRK            SAVE THE NEW START TRACK
  794 062A B7 0152            STAA   CRSEC            AND NEW START SECTOR
  795 062D DE CE              LDX    SESP1            IF NEW FCB & EOD FCB
  796 062F 8C 013E            CPX    #SECB1+110       WILL NOT FIT IN THIS SECTOR
  797 0632 26 26              BNE    WTND6            THEN
  798                  *
  799 0634 5F          WTND4  CLRB                    SELECT TRACK 0
  800 0635 B6 0150            LDAA   USECT            USING THE CURRENT SECTOR
  801 0638 CE 00D0            LDX    #SECB1           AND SECTOR BUFFER
  802 063B BD 0487            JSR    WRTSE            WRITE THE SECTOR BUFFER TO DISK
  803 063E 4D                 TSTA                    IF WRITE WAS NOT SUCCESSFUL
  804 063F 27 0F              BEQ    WTND5            THEN
  805 0641 7C 0150            INC    USECT            TAKE THE NEXT SECTOR
  806 0644 F6 0150            LDAB   USECT            IF THIS SECTOR
  807 0647 C4 3F              ANDB   #$3F             WITH THE UNIT ID STRIPPED
  808 0649 C1 1B              CMPB   #27              IS THE LAST SECTOR
  809 064B 26 E7              BNE    WTND4            THEN
  810 064D 7E 043C            JMP    MEDER            REPORT "MEDIA ERROR" & WAIT FOR NEW COMMAND
  811                  *
  812                  *CURRENT SECTOR HAS NO ROOM FOR EOD, OPEN NEXT SECTOR
  813                  *
  814 0650 CE 00D0     WTND5  LDX    #SECB1           INITIALIZE THE SECTOR BUFFER POINTER
  815 0653 DF CE              STX    SESP1            TO THE START OF THE SECTOR BUFFER
  816 0655 7C 0150            INC    USECT            TAKE THE NEXT SECTOR
  817 0658 20 0B              BRA    WTND7            AND PUT AN E.O.D. FCB THERE
  818                  *
  819                  *PUT AN E.O.D. FILE CONTROL BLOCK IN THE CURRENT SECTOR
  820                  *
  821 065A 5F          WTND6  CLRB                    DEFINE THE NUMBER OF
  822 065B 86 0B              LDAA   #11              BYTES IN A FILE CONTROL BLOCK = 11
  823 065D 9B CF              ADDA   SESP1+LBYT       USE THIS NUMBER TO
  824 065F D9 CE              ADCB   SESP1            STEP OVER THE CURRENT
  825 0661 97 CF              STAA   SESP1+LBYT       FILE CONTROL BLOCK
  826 0663 D7 CE              STAB   SESP1            AND ACCESS THE NEXT ONE
  827 0665 DE CE       WTND7  LDX    SESP1            LOAD SECTOR BUFFER POINTER
  828 0667 C6 05              LDAB   #$5              CREATE A FILE NAME OF FIVE
  829 0669 86 2A              LDAA   #'*              ASCII ASTERISK CHARACTERS
  830                  *
  831 066B A7 00       WTND8  STAA   0,X              STORE A CHARACTER
  832 066D 08                 INX                     IN THE NAME FIELD
  833 066E 5A                 DECB                    WHILE NAME FIELD
  834 066F 26 FA              BNE    WTND8            CONTINUE
  835                  *
  836 0671 86 FF              LDAA   #$FF             DEFINE ATTRIBUTE CHARACTER AS
  837 0673 A7 00              STAA   0,X              END OF DIRECTORY MARK
  838 0675 08                 INX                     IN THE ATTRIBUTE FIELD
  839 0676 B6 0151            LDAA   CRTRK            SET THIS FILE'S START TRACK
  840 0679 A7 00              STAA   0,X              AS "TRACK"
  841 067B 08                 INX                     IN THE TRACK FIELD
  842 067C B6 0152            LDAA   CRSEC            SET THIS FILE'S START SECTOR
  843 067F A7 00              STAA   0,X              AS "SECTOR"
  844 0681 5F          WTND9  CLRB                    SELECT TRACK 0
  845 0682 B6 0150            LDAA   USECT            USING THE CURRENT SECTOR
  846 0685 84 3F              ANDA   #$3F             MASK OFF THE UNIT ID
  847 0687 81 1B              CMPA   #27              IF SECTORS HAVE RUN OUT
  848 0689 26 03              BNE    WTNDA            THEN
  849 068B 7E 043C     MEDE1  JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
  850                  *
  851 068E B6 0150     WTNDA  LDAA   USECT            USING THE CURRENT SECTOR
  852 0691 CE 00D0            LDX    #SECB1           AND THE CURRENT SECTOR BUFFER LOAD
  853 0694 BD 0487            JSR    WRTSE            WRITE THIS SECTOR TO DISK
  854 0697 4D                 TSTA                    IF THE WRITE WAS SUCCESFUL
  855 0698 26 01              BNE    WTNDB            THEN
  856 069A 39                 RTS                     RETURN TO CALLER (SUCCESS)
  857                  *
  858 069B 7C 0150     WTNDB  INC    USECT            TAKE THE NEXT SECTOR
  859 069E 20 E1              BRA    WTND9            AND TRY AGAIN
  860                  *
  861                  *
  862                  *
  863                  *
  864                  *THIS ROUTINE CLOSES ANY OPEN FILES, AND RETURNS TO
  865                  *LOOK FOR THE NEXT USER INPUT COMMAND STRING
  866                  *
  867 06A0 0F          FLCLS  SEI                     RUN THE CPU NON-INTERRUPTABLE
  868 06A1 8E 006B            LDS    #EXSTK           REINITIALIZE EDOS STACK
  869 06A4 7D 0001            TST    OFILE            IF THERE IS NO OUTPUT FILE CURRENTLY OPEN
  870 06A7 26 03              BNE    FLCL2            THEN
  871 06A9 7E 016E     FLCL1  JMP    WTCMD            WAIT FOR NEW COMMAND
  872                  *
  873 06AC 7D 000D     FLCL2  TST    OCNTR            IF WRITE BUFFER IS NOT FULL
  874 06AF 27 06              BEQ    FLCL3            THEN
  875 06B1 4F                 CLRA                    USING NULL FILL CHARACTERS
  876 06B2 BD E80C            JSR    XWRT             PAD BUFFER
  877 06B5 20 F5              BRA    FLCL2            UNTIL FULL
  878                  *
  879 06B7 CE 0000     FLCL3  LDX    #0               CREATE A NULL FILE NAME
  880 06BA DF C0              STX    FLNM0            (PREVENTING A MATCH
  881 06BC DF C2              STX    FLNM2            THEREBY FINDING
  882 06BE DF C3              STX    FLNM3            END OF DIRECTORY)
  883 06C0 96 02              LDAA   OUNIT            DEFINE NULL FILE AS ON THE CURRENT UNIT
  884 06C2 97 C5              STAA   FLNM5            (LOOK FOR EOD ON UNIT HAVING OPEN FILE)
  885 06C4 4F                 CLRA                    DEFINE AN ATTRIBUTE OF 0
  886 06C5 97 C6              STAA   FILAT            IN THE ATTRIBUTE LOCATION
  887 06C7 BD 04CC            JSR    FNDFL            TURN TO LAST ENTRY IN DIRECTORY
  888 06CA 81 FF              CMPA   #$FF             IF IT IS END OF DIRECTORY MARK
  889 06CC 26 BD              BNE    MEDE1            THEN
  890 06CE DE CE              LDX    SESP1            AT CURRENT SCAN POSITION IN SECTOR BUFFER
  891 06D0 A6 09              LDAA   9,X              GET THE "FREE SPACE" VALUE FROM
  892 06D2 E6 08              LDAB   8,X              THE CURRENT EOD RECORD
  893 06D4 80 01              SUBA   #1               SUBTRACT ONE SECTOR
  894 06D6 C2 00              SBCB   #0               TO BE HELD AS A SPARE
  895 06D8 90 0A              SUBA   OSIZE+LBYT       SUBTRACT SIZE OF FILE JUST
  896 06DA D2 09              SBCB   OSIZE            WRITTEN (FILE NOW BEING CLOSED)
  897 06DC 97 C8              STAA   FILRQ+1          STORE SIZE OF NEW FREE SPACE
  898 06DE D7 C7              STAB   FILRQ            (NUMBER OF SECTORS NOW AVAILABLE ON DISK)
  899 06E0 BD 05EF            JSR    WTNDX            REWRITE THE DISK DIRECTORY
  900 06E3 20 C4              BRA    FLCL1            RETURN TO MONITOR, WAIT FOR NEXT COMMAND
  901                  *
  902                  *THIS ROUTINE LOADS A USER OBJECT FILE, OR PROGRAM FROM
  903                  *THE DISK.  IF REQUIRED, THE USER MUST START IT, USING MAID
  904                  *
  905 06E5 CE E815     LOAD   LDX    #PROG            LOAD VECTOR TO PROGRAM LOADER IN EDOS ROM
  906 06E8 FF 0701            STX    LOADV            MODIFY JUMP INSTRUCTION FOR PROGRAM LOADER
  907 06EB BD 036E     LOAD1  JSR    PRSFL            PARSE FILE NAME TO BE LOADED
  908 06EE BD 053A            JSR    DFINF            SET UP POINTERS TO FILE
  909 06F1 4D                 TSTA                    IF FILE DOES NOT EXIST (DEFINITION FAILED)
  910 06F2 27 09              BEQ    LOAD2            THEN
  911 06F4 F6 0293     NOSFL  LDAB   NOSFM            DEFINE CHARACTER COUNT AND POINTER
  912 06F7 CE 0294            LDX    #NOSFM+1         FOR "NO SUCH FILE" MESSAGE
  913 06FA 7E 0189            JMP    MSWTC            PRINT IT & WAIT FOR NEW COMMAND
  914                  *
  915 06FD 8E FF8A     LOAD2  LDS    #EXBST           SWITCH TO EXBUG STACK SPACE
  916 0700 7E E815            JMP    PROG             PULL IN THE PROGRAM, START EXBUG
  917      0701        LOADV  EQU    *-2              SELF-MODIFIED JUMP ADDRESS FOR LOADER FUNCTION
  918                  *
  919                  *PULL IN RELOCATING LOADER & START IT RUNNING (SYSTEM FUNCTION)
  920                  *
  921 0703 CE E824     RLOAD  LDX    #EDITR           LOAD VECTOR FOR LOAD & GO LOADER (START = 20)
  922 0706 FF 0701            STX    LOADV            MODIFY JUMP INSTRUCTION FOR LOAD & GO
  923 0709 CE 006C            LDX    #IBUF1           BACK UP TO GET FILENAME "RLOAD"
  924 070C DF BC              STX    BFPT1            REDO THE COMMAND AS A FILENAME
  925 070E 7E 06EB            JMP    LOAD1            USING PRSFL,DFINF & LOADER
  926                  *
  927                  *
  928                  *THIS GROUP OF ROUTINES LIST A FILE, USING VARIOUS OUTPUT DEVICES
  929                  *
  930 0711 CE F018     CLIST  LDX    #PRINC           DEFINE CONSOLE O/P ROUTINE
  931 0714 20 03              BRA    LIST1            LIST THE FILE USING IT
  932 0716 CE EAB0     PLIST  LDX    #LPTC            DEFINE LINE PRINTER O/P ROUTINE
  933 0719 DF 31       LIST1  STX    PRNVC+1          STORE SELECTED O/P ROUTINE ADDRESS
  934 071B 7F 0F33            CLR    NULCT            CLEAR NULL COUNTER
  935 071E BD 036E            JSR    PRSFL            LOAD FILE NAME AND UID TO FLNM0-5
  936 0721 BD 053A            JSR    DFINF            FIND AND DEFINE FILE FOR READ
  937 0724 4D                 TSTA                    IF NO FILE FOUND
  938 0725 27 03              BEQ    LIST2            THEN
  939 0727 7E 06F4            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
  940 072A BD E809     LIST2  JSR    XRI              READ A 8-BIT BYTE FROM DISK
  941 072D 25 0C              BCS    LIST4            IF NOT EOF, THEN
  942 072F 84 7F              ANDA   #$7F             STRIP THE PARITY BIT
  943 0731 27 0B              BEQ    LIST5            IF NOT A NULL, THEN
  944 0733 7F 0F33            CLR    NULCT            CLEAR NULL COUNTER
  945 0736 BD 0030     LIST3  JSR    PRNVC            OUTPUT THE CHARACTER ON THE DEFINED DEVICE
  946 0739 20 EF              BRA    LIST2            READ THE NEXT BYTE
  947                  *
  948 073B 7E 016E     LIST4  JMP    WTCMD            WAIT FOR NEW COMMAND
  949                  *
  950 073E 7D 0F33     LIST5  TST    NULCT            IF PREVIOUS CHAR NOT NULL
  951 0741 26 E7              BNE    LIST2            THEN
  952 0743 7C 0F33            INC    NULCT            RECORD THIS NULL
  953 0746 20 EE              BRA    LIST3            AND PRINT IT
  954                  *
  955                  *
  956                  *THIS FUNCTION ALLOWS THE USER TO CHANGE FILE ATTRIBUTES
  957                  *
  958 0748 BD 036E     ATTR   JSR    PRSFL            LOAD FILE NAME & UID TO FLNM0-5
  959 074B BD 04CC            JSR    FNDFL            FIND THE REFERENCED FILE DIRECTORY ENTRY
  960 074E 4D                 TSTA                    IF NO SUCH FILE EXISTS
  961 074F 27 03              BEQ    ATTR1            THEN
  962 0751 7E 06F4            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
  963 0754 BD 036E     ATTR1  JSR    PRSFL            LOAD NEW ATTRIBUTE TO FLNM0
  964 0757 CE 00C0            LDX    #FLNM0           POINT X TO THE NEW ATTRIBUTE (FLNM0)
  965 075A BD 076D            JSR    CONHX            CONVERT INPUT ATTRIBUTE STRING TO BINARY
  966 075D DE CE              LDX    SESP1            RESTORE THE SECTOR BUFFER POINTER
  967 075F 96 CB              LDAA   BINLO            GET THE CONVERTED NEW ATTRIBUTE
  968 0761 81 FF              CMPA   #$FF             END-OF-DIRECTORY IS FORBIDDEN, IF ANYTHING ELSE
  969 0763 27 05              BEQ    ATTR2            THEN
  970 0765 A7 05              STAA   $5,X             STORE THE NEW ATTRIBUTE IN THE FCB
  971 0767 7E 07F0            JMP    RENA4            AND REWRITE THE SECTOR TO DISK
  972                  *
  973 076A 7E 0183     ATTR2  JMP    ERRM             CAN'T ALLOW BLOCKING OFF THE DISK, ERROR!!!
  974                  *
  975                  *
  976                  *THIS ROUTINE CONVERTS ASCII TO HEX
  977                  *
  978 076D 7F 00CA     CONHX  CLR    BINHI            CLEAR OUT THE BINARY SCRATCH
  979 0770 7F 00CB            CLR    BINLO            LOCATIONS, PREPARING TO PACK IN HEX DIGITS
  980 0773 A6 00       CONH1  LDAA   $0,X             PICK UP THE CURRENT DIGIT
  981 0775 BD 0780            JSR    CNHXS            CONVERT & PACK A HEX DIGIT
  982 0778 24 03              BCC    CONH2            IF HEX - BIN CONVERSION TERMINATED, THEN
  983 077A DE CC              LDX    BFOP2            PICK UP X FROM BFOP2
  984 077C 39                 RTS                     AND RETURN, CONVERSION COMPLETE
  985                  *
  986 077D 08          CONH2  INX                     ELSE POINT TO THE NEXT DIGIT
  987 077E 20 F3              BRA    CONH1            WHILE DIGITS, CONTINUE
  988                  *
  989 0780 80 30       CNHXS  SUBA   #'0              IF .GE. ASCII 0
  990 0782 25 26              BCS    CNHS2            AND
  991 0784 8B E9              ADDA   #$E9             .LE. ASCII F
  992 0786 25 22              BCS    CNHS2            THEN
  993 0788 8B 06              ADDA   #$6              IF .LT. ASCII A
  994 078A 2A 04              BPL    CNHS1            CHECK
  995 078C 8B 07              ADDA   #$7              IF NOT ASCII : TO @
  996 078E 25 1A              BCS    CNHS2            THEN
  997 0790 8B 0A       CNHS1  ADDA   #$A              COMPLETE BINARY CONVERSION
  998 0792 0C                 CLC                     (CLEAR C TO PATCH ERROR)
  999 0793 25 15              BCS    CNHS2            (PROGRAM ERROR-BRANCH NEVER TAKEN)
 1000 0795 97 C9              STAA   HDIGT            SAVE THE 4-BIT HEX DIGIT
 1001 0797 D6 CA              LDAB   BINHI            PICK UP THE BINARY
 1002 0799 96 CB              LDAA   BINLO            STRING IN PROCESS
 1003 079B 48                 ASLA                    SHIFT IN A 0 BIT
 1004 079C 59                 ROLB                    4 TIMES, DOUBLE
 1005 079D 48                 ASLA                    PRECISION, TO
 1006 079E 59                 ROLB                    PREPARE A HOLE
 1007 079F 48                 ASLA                    FOR THE NEW HEX DIGIT
 1008 07A0 59                 ROLB                    THE PACK IS RIGHT JUSTIFIED
 1009 07A1 48                 ASLA                    IF MORE THAN 4 DIGITS ARE
 1010 07A2 59                 ROLB                    INPUT, THE 4 LEAST SIGNIFICANT WILL BE USED
 1011 07A3 9B C9              ADDA   HDIGT            PACK IN 4 BIT BINARY
 1012 07A5 D7 CA              STAB   BINHI            STORE PACKED BINARY (H)
 1013 07A7 97 CB              STAA   BINLO            STORE PACKED BINARY (L)
 1014 07A9 0C                 CLC                     CLEAR C SHOWING SUCCESS (PACK STILL IN PROGRESS)
 1015 07AA 39          CNHS2  RTS                     RETURN TO CALLER
 1016                  *
 1017                  *
 1018                  *THIS FUNCTION RENAMES AN EXISTING FILE.  THE ONLY EFFECT
 1019                  *IS TO CHANGE THE NAME FIELD IN THE SPECIFIED FILE'S FCB.
 1020                  *
 1021 07AB BD 036E     RENAM  JSR    PRSFL            PARSE OLD FILE NAME
 1022 07AE 96 C5              LDAA   FLNM5            AND ACCEPT THE UNIT NUMBER
 1023 07B0 97 C9              STAA   UNUMB            COMMIT TO THIS UNIT NUMBER
 1024 07B2 BD 036E            JSR    PRSFL            PARSE NEW FILE NAME
 1025 07B5 96 C9              LDAA   UNUMB            BUT USE OLD UNIT NUMBER
 1026 07B7 97 C5              STAA   FLNM5            TO FORCE CONSISTENT FILE UID
 1027 07B9 BD 04CC            JSR    FNDFL            LOOK TO SEE IF THIS NAME ALREADY EXISTS
 1028 07BC 4D                 TSTA                    IF IT DOES NOT EXIST
 1029 07BD 27 60              BEQ    DUPNM            THEN
 1030 07BF CE 006C            LDX    #IBUF1           START ACTION PASS ON COMMAND STRING
 1031 07C2 DF BC              STX    BFPT1            REINITIALIZE COMMAND STRING POINTER
 1032 07C4 BD 036E            JSR    PRSFL            STEP OVER "RENAM" COMMAND
 1033 07C7 BD 036E            JSR    PRSFL            PARSE THE FILE NAME TO BE CHANGED
 1034 07CA BD 04CC            JSR    FNDFL            FIND THE FILE TO BE CHANGED
 1035 07CD 4D                 TSTA                    IF IT DOES NOT EXIST
 1036 07CE 27 03              BEQ    RENA2            THEN
 1037 07D0 7E 06F4     RENA1  JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 1038                  *
 1039 07D3 BD 036E     RENA2  JSR    PRSFL            PARSE THE NEW FILE NAME
 1040 07D6 DE CE              LDX    SESP1            POINT TO THE FILE FCB IN SECTOR BUFFER #1
 1041 07D8 96 C0              LDAA   FLNM0            IF THE FIRST CHARACTER OF THE NEW NAME
 1042 07DA 81 20              CMPA   #SPC             IS A SPACE, THE NEW NAME IS ILLEGAL
 1043 07DC 27 F2              BEQ    RENA1            ELSE,
 1044 07DE A7 00              STAA   $0,X             STORE THE FIRST CHARACTER IN THE FCB
 1045 07E0 96 C1              LDAA   FLNM1            GET THE SECOND CHARACTER
 1046 07E2 A7 01              STAA   $1,X             STORE THE SECOND CHARACTER IN THE FCB
 1047 07E4 96 C2              LDAA   FLNM2            GET THE THIRD CHARACTER
 1048 07E6 A7 02              STAA   $2,X             STORE THE THIRD CHARACTER IN THE FCB
 1049 07E8 96 C3              LDAA   FLNM3            GET THE FOURTH CHARACTER
 1050 07EA A7 03              STAA   $3,X             STORE THE FOURTH CHARACTER IN THE FCB
 1051 07EC 96 C4              LDAA   FLNM4            GET THE FIFTH CHARACTER
 1052 07EE A7 04              STAA   $4,X             STORE THE FIFTH CHARACTER IN THE FCB
 1053 07F0 5F          RENA4  CLRB                    SELECT TRACK 0
 1054 07F1 B6 0150            LDAA   USECT            LOAD <UNIT><SECTOR> SET BY FNDFL
 1055 07F4 CE 00D0            LDX    #SECB1           RESET X TO POINT TO THE START OF THE SECTOR BUFFER
 1056 07F7 BD 0487            JSR    WRTSE            REWRITE THE SECTOR TO THE DISK DIRECTORY
 1057 07FA 4D                 TSTA                    IF WRITE OF SECTOR WAS SUCCESSFUL
 1058 07FB 26 01              BNE    RENA5            THEN
 1059 07FD 39                 RTS                     RETURN TO CALLER (SUCCESS)
 1060                  *
 1061 07FE 7E 043C     RENA5  JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 1062                  *
 1063                  *
 1064                  *THIS FUNCTION CREATES A FILE DIRECTORY ENTRY OF REQUESTED
 1065                  *SIZE, APPENDING IT TO THE END OF EXISTING FILES.  ANY DATA
 1066                  *PRESENT IN THE FILE AREA REMAINS UNCHANGED, ONLY THE DIRECTORY
 1067                  *AREA IS ALTERED.
 1068                  *
 1069 0801 7F 00C6     CREAT  CLR    FILAT            DEFINE CREATED FILE ATTRIBUTE = 0
 1070 0804 BD 036E            JSR    PRSFL            PARSE FILE NAME (NEXT ITEM IS SIZE IN HEX)
 1071 0807 DE BC              LDX    BFPT1            POINT TO THE NEXT ITEM
 1072 0809 BD 076D            JSR    CONHX            AND CONVERT THE HEX TO BINARY
 1073 080C DE CA              LDX    BINHI            AN ATTEMPT TO CREATE A FILE OF 0 SIZE
 1074 080E 27 21              BEQ    FERR1            IS FORBIDDEN, ELSE
 1075 0810 DF C7              STX    FILRQ            DEFINE THE REQUESTED FILE SIZE
 1076 0812 BD 058F            JSR    CREAF            CREATE THE NEW FILE DIRECTORY ENTRY
 1077 0815 4D                 TSTA                    IF SUCCESSFUL IN CREATING THE NEW FILE
 1078 0816 26 03              BNE    ERTYP            THEN
 1079 0818 7E 016E            JMP    WTCMD            WAIT FOR NEW COMMAND
 1080                  *
 1081 081B 81 02       ERTYP  CMPA   #$2              IF A = 2
 1082 081D 26 09              BNE    NRMMS            THEN
 1083 081F F6 02A0     DUPNM  LDAB   DUNMM            LOAD CHARACTER COUNT
 1084 0822 CE 02A1            LDX    #DUNMM+1         AND POINTER FOR "DUPLICATE NAME"
 1085 0825 7E 0189            JMP    MSWTC            PRINT "DUPL NAME" & WAIT FOR NEW COMMAND
 1086                  *
 1087 0828 F6 02AA     NRMMS  LDAB   NORMM            LOAD CHARACTER COUNT
 1088 082B CE 02AB            LDX    #NORMM+1         AND POINTER FOR "NO ROOM"
 1089 082E 7E 0189            JMP    MSWTC            PRINT "NO ROOM" & WAIT FOR NEW COMMAND
 1090                  *
