 1450 0AC4 81 49              CMPA   #'I              IF NOT AN INPUT FILE
 1451 0AC6 27 19              BEQ    IPFIL            AND
 1452 0AC8 81 4F              CMPA   #'O              IF NOT AN OUTPUT FILE
 1453 0ACA 27 53              BEQ    OPFIL            THEN
 1454 0ACC F6 0326            LDAB   OFLCM            A LISTING FILE IS IN CONFLICT
 1455 0ACF CE 0327            LDX    #OFLCM+1         DEFINE "OFILE CONFLICT"
 1456 0AD2 7E 0189            JMP    MSWTC            PRINT "OFILE CONFLICT" & WAIT FOR NEW COMMAND
 1457                  *
 1458                  *DEFINE A ALL "0" ENTRY IN BUFFER, UNUSED LIST OR OBJECT FILES
 1459                  *
 1460 0AD5 4F          ZERFL  CLRA                    DEFINE VALUE OF "0"
 1461 0AD6 FE 0159            LDX    TKBFP            USING THE CURRENT BUFFER POINTER
 1462 0AD9 A7 00              STAA   $0,X             BUILD A
 1463 0ADB A7 01              STAA   $1,X             RECORD OF
 1464 0ADD A7 02              STAA   $2,X             000
 1465 0ADF 20 CD              BRA    LSFI6            FINISH THE RECORD & EXIT
 1466                  *
 1467                  *
 1468                  *DEFINE & SET UP AN INPUT FILE
 1469                  *
 1470 0AE1 BD 053A     IPFIL  JSR    DFINF            IF THE REQUESTED FILE
 1471 0AE4 4D                 TSTA                    DOES NOT EXIST
 1472 0AE5 27 21              BEQ    IPFI1            THEN
 1473 0AE7 C6 05              LDAB   #$5              FOR THE 5 CHARACTERS
 1474 0AE9 CE 00C0            LDX    #FLNM0           OF THE REQUESTED FILE NAME
 1475 0AEC BD 03C1            JSR    PRINS            PRINT THE FILE NAME
 1476 0AEF 86 3A              LDAA   #':              DEFINE ASCII COLON
 1477 0AF1 BD F018            JSR    PRINC            PRINT IT
 1478 0AF4 96 C5              LDAA   FLNM5            GET CURRENT UID
 1479 0AF6 8B 30              ADDA   #'0              CONVERT TO ASCII NUMBER
 1480 0AF8 BD F018            JSR    PRINC            PRINT IT
 1481 0AFB F6 02E9            LDAB   NOEXM            DEFINE CHARACTER COUNT
 1482 0AFE CE 02EA            LDX    #NOEXM+1         AND PONTER FOR " NON EXISTENT"
 1483 0B01 BD 03C1            JSR    PRINS            PRINT " NON EXISTENT"
 1484 0B04 BD 03CB            JSR    CRLF             PRINT <CR><LF>
 1485 0B07 39                 RTS                     RETURN TO CALLER
 1486                  *
 1487 0B08 FE 0159     IPFI1  LDX    APARS            LOAD POINTER TO STRING BUFFER
 1488 0B0B 96 06              LDAA   ITRK             GET THE START TRACK OF THE FILE
 1489 0B0D A7 00              STAA   $0,X             AND STORE IT IN THE BUFFER
 1490 0B0F 96 07              LDAA   ISCTR            GET THE DRIVE & SECTOR OF THE FILE
 1491 0B11 A7 01              STAA   $1,X             AND STORE IT IN THE BUFFER
 1492 0B13 96 04              LDAA   ISIZE            LOAD THE SIZE HIGH BYTE
 1493 0B15 A7 02              STAA   $2,X             AND STORE IT IN THE BUFFER
 1494 0B17 96 05              LDAA   ISIZE+LBYT       LOAD THE SIZE LOW BYTE
 1495 0B19 A7 03              STAA   $3,X             AND STORE IT IN THE BUFFER
 1496 0B1B 4F                 CLRA                    DELIMIT THIS RECORD WITH "0"
 1497 0B1C 7E 0AB2            JMP    LSFI7            COMPLETING THIS BUFFER RECORD
 1498                  *
 1499                  *
 1500 0B1F BD 0BF2     OPFIL  JSR    DOOF1            CREATE A PROTOTYPE FILE CONTROL BLOCK
 1501 0B22 BD 0C14            JSR    DEFOP            DEFINE THE OUTPUT FILE
 1502 0B25 FE 0159            LDX    APARS            LOAD POINTER TO STRING BUFFER
 1503 0B28 96 0B              LDAA   OTRK             GET THE START TRACK OF THE FILE
 1504 0B2A A7 00              STAA   $0,X             AND STORE IT IN THE BUFFER
 1505 0B2C 96 0C              LDAA   OSCTR            GET THE DRIVE & SECTOR OF THE FILE
 1506 0B2E A7 01              STAA   $1,X             AND STORE IT IN THE BUFFER
 1507 0B30 96 09              LDAA   OSIZE            LOAD THE SIZE HIGH BYTE
 1508 0B32 A7 02              STAA   $2,X             AND STORE IT IN THE BUFFER
 1509 0B34 96 0A              LDAA   OSIZE+LBYT       LOAD THE SIZE LOW BYTE
 1510 0B36 A7 03              STAA   $3,X             AND STORE IT IN THE BUFFER
 1511 0B38 86 FF              LDAA   #$FF             DEFINE FLAG VALUE = FF (DO UPDATE)
 1512 0B3A 97 01              STAA   OFILE            FOR FILE CLOSURE ON EDOS RETURN
 1513 0B3C 7C 0AC3            INC    LSFIB            SET FLAG TO SHOW O/P FILE NOW ASSIGNED
 1514 0B3F 4F                 CLRA                    DELIMIT THIS RECORD WITH "0"
 1515 0B40 7E 0AB2            JMP    LSFI7            COMPLETING THIS BUFFER RECORD
 1516                  *
 1517                  *
 1518 0B43             FLABF  RMB    18               INPUT COMMAND STRING FILE ASSIGNMENT BUFFER
 1519      0B55        FLABE  EQU    *                END OF BUFFER SPACE ALLOCATED
 1520                  *
 1521                  *
 1522 0B55 CE 0B81     EDIT   LDX    #NAMDF           POINT TO THE SYSTEM FILE NAME GENERATOR
 1523 0B58 86 45              LDAA   #'E              DEFINE AN IMAGE
 1524 0B5A A7 01              STAA   $1,X             OF "EDIT " TO
 1525 0B5C 86 44              LDAA   #'D              BE USED AS A
 1526 0B5E A7 05              STAA   $5,X             SEARCH TEMPLATE
 1527 0B60 86 49              LDAA   #'I              WHILE LOOKING FOR
 1528 0B62 A7 09              STAA   $9,X             THE "EDIT " SYSTEM FILE.
 1529 0B64 86 54              LDAA   #'T              NOTE THAT THIS SEQUENCE
 1530 0B66 A7 0D              STAA   $D,X             DIRECTLY LOADS THE "#"
 1531 0B68 86 20              LDAA   #SPC             NAME GENERATION VALUES, I.E.
 1532 0B6A A7 11              STAA   $11,X            IT MODIFIES THE EXECUTABLE CODE.
 1533                  *
 1534 0B6C BD 036E     FILGT  JSR    PRSFL            IF THE INPUT FILE NAME
 1535 0B6F 96 C0              LDAA   FLNM0            DOES NOT OVERWRITE THE FIRST SPACE
 1536 0B71 81 20              CMPA   #SPC             IT IS ASSUMED TO BE DEFINED "NULL"
 1537 0B73 27 4A              BEQ    NULFL            ELSE
 1538 0B75 BD 0BDF            JSR    EDINF            LOOK FOR THE REQUESTED INPUT FILE
 1539 0B78 BD 0C40            JSR    SVIOF            GET OUTPUT FILE & SAVE FILE DEFINITIONS
 1540                  *
 1541 0B7B 7F 00C5     NAMDO  CLR    FLNM5            FORCE THE SYSTEM FILE SEARCH TO DRIVE 0
 1542 0B7E CE 00C0            LDX    #FLNM0           POINT TO THE SEARCH TARGET STRING
 1543                  *
 1544                  *THIS STRING LOAD IS RUN-TIME MODIFIED, AND WILL
 1545                  *CONTAIN THE "#" VALUES DEFINING THE TARGET FILE
 1546                  *
 1547 0B81 86 45       NAMDF  LDAA   #'E              DEFINE FLNM0 (NOMINALLY "E")
 1548 0B83 A7 00              STAA   0,X              PUT IT IN THE FILE NAME
 1549 0B85 86 44              LDAA   #'D              DEFINE FLNM1 (NOMINALLY "D")
 1550 0B87 A7 01              STAA   1,X              PUT IT IN THE FILE NAME
 1551 0B89 86 49              LDAA   #'I              DEFINE FLNM2 (NOMINALLY "I")
 1552 0B8B A7 02              STAA   2,X              PUT IT IN THE FILE NAME
 1553 0B8D 86 54              LDAA   #'T              DEFINE FLNM3 (NOMINALLY "T")
 1554 0B8F A7 03              STAA   3,X              PUT IT IN THE FILE NAME
 1555 0B91 86 20              LDAA   #SPC             DEFINE FLNM4 (NOMINALLY <SPC>)
 1556 0B93 A7 04              STAA   4,X              PUT IT IN THE FILE NAME
 1557 0B95 BD 053A     GEPRO  JSR    DFINF            IF THE REQUESTED SYSTEM PROGRAM OBJECT FILE
 1558 0B98 4D                 TSTA                    IS NOT RESIDENT ON THE SYSTEM DISK
 1559 0B99 27 03              BEQ    GEPR1            THEN
 1560 0B9B 7E 06F4            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 1561 0B9E B6 0156     GEPR1  LDAA   TIUNT            ELSE DEFINE THE LOAD DISK
 1562 0BA1 97 03              STAA   IUNIT            IN IUNIT
 1563 0BA3 7E E824            JMP    EDITR            LOAD AND RUN THE REQUESTED SYSTEM PROGRAM
 1564                  *
 1565                  *
 1566                  *THIS FUNCTION SETS UP AND RUNS BASIC
 1567                  *
 1568 0BA6 CE 0B81     BASIC  LDX    #NAMDF           POINT TO THE SYSTEM FILE NAME GENERATOR
 1569 0BA9 86 42              LDAA   #'B              DEFINE A IMAGE
 1570 0BAB A7 01              STAA   $1,X             OF "BASIC" TO
 1571 0BAD 86 41              LDAA   #'A              BE USED AS A
 1572 0BAF A7 05              STAA   $5,X             SEARCH TEMPLATE
 1573 0BB1 86 53              LDAA   #'S              WHILE LOOKING FOR
 1574 0BB3 A7 09              STAA   $9,X             THE "BASIC" SYSTEM FILE.
 1575 0BB5 86 49              LDAA   #'I              NOTE THAT THIS SEQUENCE
 1576 0BB7 A7 0D              STAA   $D,X             DIRECTLY LOADS THE "#"
 1577 0BB9 86 43              LDAA   #'C              NAME GENERATION VALUES, I.E.
 1578 0BBB A7 11              STAA   $11,X            IT MODIFIES THE EXECUTABLE CODE
 1579 0BBD 20 AD              BRA    FILGT            LOOK FOR I/O FILES, LOAD BASIC & GO
 1580                  *
 1581                  *
 1582                  *THIS ROUTINE SETS UP A DUMMY FILE, IF A FILE WAS DECLARED "NULL"
 1583                  *
 1584 0BBF CE 0001     NULFL  LDX    #$1              DEFINE A DUMMY FILE SIZE OF 1 SECTOR
 1585 0BC2 DF 04              STX    ISIZE            FOR THE ISIZE SETUP VALUE
 1586 0BC4 86 01              LDAA   #$1              DEFINE TRACK NUMBER
 1587 0BC6 97 06              STAA   ITRK             AS TRACK 1
 1588 0BC8 7F 0008            CLR    ICNTR            CLEAR THE INPUT BYTE COUNTER
 1589 0BCB 7F 0007            CLR    ISCTR            DEFINE INPUT <UNIT><SECTOR> AS 0
 1590 0BCE 7F 0003            CLR    IUNIT            ON UNIT 0
 1591 0BD1 BD 0C40            JSR    SVIOF            PREPARE FCB, AND SAVE I/O FILE DEFINITIONS
 1592 0BD4 20 A5              BRA    NAMDO            CALL IN THE REQUESTED SYSTEM PROGRAM
 1593                  *
 1594                  *THIS ROUTINE USED TO CHECK FOR A MISSING NAME
 1595                  *
 1596 0BD6 BD 036E     NONAM  JSR    PRSFL            IF NEXT NAME IN THE INPUT COMMAND STRING
 1597 0BD9 96 C0              LDAA   FLNM0            DOES NOT OVERWITE THE FIRST SPACE
 1598 0BDB 81 20              CMPA   #SPC             IT IS ASSUMED NOT TO EXIST
 1599 0BDD 27 07              BEQ    EDNOF            ELSE
 1600                  *
 1601 0BDF BD 053A     EDINF  JSR    DFINF            IF THE INPUT FILE IS FOUND
 1602 0BE2 4D                 TSTA                    AND SUCCESSFULLY DEFINED
 1603 0BE3 26 01              BNE    EDNOF            THEN
 1604 0BE5 39                 RTS                     RETURN (SUCCESS)
 1605                  *
 1606 0BE6 7E 06F4     EDNOF  JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 1607                  *
 1608 0BE9 BD 036E     DOOFL  JSR    PRSFL            PARSE OUTPUT FILE NAME
 1609 0BEC 96 C0              LDAA   FLNM0            IF OUTPUT FILE WAS SPECIFIED
 1610 0BEE 81 20              CMPA   #SPC             (VALID CHAR OVERWRITES FIRST SPACE CHAR)
 1611 0BF0 27 F4              BEQ    EDNOF            THEN
 1612                  *
 1613                  *
 1614                  *CREATE A PROTOTYPE FCB, ATTR = FF (EOD), SIZE = FREE SPACE ON DISK
 1615                  *
 1616 0BF2 CE 07B7     DOOF1  LDX    #1975            ALLOW AN ALLOCATION OF 1975 SECTORS (FULL DISK)
 1617 0BF5 DF 09              STX    OSIZE            IN THE OSIZE LOCATION
 1618 0BF7 DF C7              STX    FILRQ            AND DEFINE THE REQUESTED FILE SIZE
 1619 0BF9 86 FF       DOOF2  LDAA   #$FF             DEFINE END OF DIRECTORY (NEW FILE GOES ON THE END)
 1620 0BFB 97 C6              STAA   FILAT            WITH ATTRIBUTE = $FF
 1621 0BFD BD 058F            JSR    CREAF            CREATE THE FILE DIRECTORY ENTRY
 1622 0C00 4D                 TSTA                    IF THE FILE CAN BE CREATED
 1623 0C01 26 01              BNE    DOOF3            THEN
 1624 0C03 39                 RTS                     RETURN (SUCCESS)
 1625                  *
 1626 0C04 81 03       DOOF3  CMPA   #$3              IF ERROR WORSE THAN DISK NOT EMPTY
 1627 0C06 27 03              BEQ    DOOF4            THEN
 1628 0C08 7E 081B            JMP    ERTYP            SORT OUT & REPORT THE ERROR
 1629                  *
 1630 0C0B DF 09       DOOF4  STX    OSIZE            THIS IS THE FREE SPACE AVAILABLE
 1631 0C0D DF C7              STX    FILRQ            IF FREE SPACE IS = 0
 1632 0C0F 26 E8              BNE    DOOF2            THEN
 1633 0C11 7E 0828            JMP    NRMMS            PRINT "NO ROOM" & WAIT FOR NEW COMMAND
 1634                  *
 1635                  *
 1636 0C14 B6 0153     DEFOP  LDAA   STRAK            PICK UP START TRACK ADDRESS FOR PROTOTYPE
 1637 0C17 97 0B              STAA   OTRK             DEFINE OUTPUT FILE TRACK
 1638 0C19 96 C5              LDAA   FLNM5            PICK UP FILE NAME UID
 1639 0C1B 97 02              STAA   OUNIT            AND DEFINE OUTPUT UNIT NUMBER
 1640 0C1D 0C                 CLC                     CLEAR C FOR SHIFTING
 1641 0C1E 46                 RORA                    SHIFT UID INTO TOP 2 BITS
 1642 0C1F 46                 RORA                    OF <UNIT><SECTOR> PACK
 1643 0C20 46                 RORA                    BIT 7 BECOMES OLD 1, 6 BECOMES OLD 0
 1644 0C21 BA 0154            ORAA   STSEC            OR IN START SECTOR ADDRESS
 1645 0C24 97 0C              STAA   OSCTR            DEFINE OUTPUT <UNIT><SECTOR>
 1646 0C26 7F 000D            CLR    OCNTR            CLEAR OUTPUT BYTE COUNT
 1647 0C29 39                 RTS                     RETURN DEFINED OUTPUT FILE
 1648                  *
 1649                  *
 1650 0C2A 96 06       MOVIP  LDAA   ITRK             TAKE CURRENT DEFINED INPUT FILE TRACK ADDRESS
 1651 0C2C 97 0E              STAA   TITRK            AND SAVE IT (DURING PROGRAM LOAD)
 1652 0C2E DE 04              LDX    ISIZE            TAKE CURRENT DEFINED INPUT FILE SIZE
 1653 0C30 DF 0F              STX    TISZE            AND SAVE IT (DURING PROGRAM LOAD)
 1654 0C32 96 03              LDAA   IUNIT            TAKE THE CURRENT DEFINED UNIT ID
 1655 0C34 B7 0156            STAA   TIUNT            AND SAVE IT (DURING PROGRAM LOAD)
 1656 0C37 39                 RTS                     RETURN SAVED INPUT DEFINITIONS TO CALLER
 1657                  *
 1658 0C38 86 FF       SVIO1  LDAA   #$FF             SET FLAG VALUE = $FF (CLOSE FILE)
 1659 0C3A 97 01              STAA   OFILE            COMMANDING EDOS TO CLOSE FILE & UPDATE
 1660 0C3C 39                 RTS                     THE DIRECTORY WHEN EDOS RELOADS
 1661                  *
 1662                  *
 1663                  *
 1664 0C3D BD 0BD6            JSR    NONAM            THIS CALL IS NOT USED
 1665                  *
 1666                  *
 1667 0C40 BD 0BE9     SVIOF  JSR    DOOFL            PARSE COMMAND FOR OUTPUT FILE
 1668 0C43 BD 0C14            JSR    DEFOP            SET UP FILE DEFINITION LOCATIONS TO OUTPUT FILE
 1669                  *
 1670 0C46 BD 0C2A     SVIPF  JSR    MOVIP            SAVE INPUT FILE DEFINITIONS DURING PROGRAM LOAD
 1671 0C49 20 ED              BRA    SVIO1            FLAG REQUIRED OUTPUT FILE CLOSURE
 1672                  *
 1673                  *
 1674                  *THESE ROUTINES GENERATE DISK FILES FROM:
 1675                  *
 1676                  *CASSETTE
 1677                  *
 1678                  *HS PAPER TAPE READER
 1679                  *
 1680                  *TELETYPE READER
 1681                  *
 1682      0C4B        CTAPE  EQU    *
 1683      0C4B        PTAPE  EQU    *
 1684      0C4B        TTAPE  EQU    *
 1685 0C4B BD 0C40            JSR    SVIOF            VALIDATE NEW FILE NAME, & ALLOCATE
 1686 0C4E BD 0C96            JSR    GENDV            SWITCH TO SELECTED TERMINAL, INPUT DATA & WRITE IT TO DISK
 1687 0C51 7E 06A0            JMP    FLCLS            CLOSE THE NEW FILE, WAIT FOR NEXT COMMAND
 1688                  *
 1689                  *THESE ROUTINES GENERATE A COPY OF A NEW SYSTEM FROM:
 1690                  *
 1691                  *
 1692                  *CASSETTE
 1693                  *
 1694                  *HS PAPER TAPE READER
 1695                  *
 1696                  *TELETYPE READER
 1697                  *
 1698      0C54        PXGEN  EQU    *
 1699      0C54        CXGEN  EQU    *
 1700      0C54        TXGEN  EQU    *
 1701 0C54 86 01              LDAA   #1               SELECT TRACK 1
 1702 0C56 97 0B              STAA   OTRK             FOR THE SYSTEM AREA
 1703 0C58 97 0C              STAA   OSCTR            BEGIN AT SECTOR 1
 1704 0C5A 7F 0002            CLR    OUNIT            USE THE SYSTEM DISK
 1705 0C5D 7F 000D            CLR    OCNTR            CLEAR THE O/P BYTE COUNT
 1706 0C60 CE 0082            LDX    #SYSSZ           ALLOCATE SYSSZ SECTORS
 1707 0C63 DF 09              STX    OSIZE            FOR THE NEW SYSTEM AREA
 1708 0C65 BD 0C96            JSR    GENDV            SWITCH TO SELECTED TERMINAL, INPUT DATA & WRITE IT TO DISK
 1709 0C68 86 53              LDAA   #'S              DEFINE FILE BLOCK "S"
 1710 0C6A BD E80C            JSR    XWRT             AND WRITE IT TO DISK
 1711 0C6D 86 1B              LDAA   #ESC             GENERATE END OF OBJECT FILE MARK (ESC CHAR)
 1712 0C6F BD E80C            JSR    XWRT             AND WRITE IT TO DISK
 1713 0C72 86 14              LDAA   #DC4             COMMAND "PUNCH OFF" IN THE FILE TO TERMINATE DUMPS
 1714 0C74 BD E80C            JSR    XWRT             WRITE THE DC4 TO THE DISK
 1715 0C77 7D 000D     GENS1  TST    OCNTR            IF DISK DATA BUFFER IS NOT FULL (128 BYTES)
 1716 0C7A 27 06              BEQ    GENS2            THEN
 1717 0C7C 4F                 CLRA                    PAD WITH NULLS
 1718 0C7D BD E80C            JSR    XWRT             WRITING TO DISK
 1719 0C80 20 F5              BRA    GENS1            UNTIL BUFFER IS FULL
 1720                  *
 1721 0C82 86 03       GENS2  LDAA   #3               DEFINE SECTOR 3
 1722 0C84 B7 0150            STAA   USECT            AS THE CURRENT SECTOR
 1723 0C87 86 01              LDAA   #1               DEFINE SECTOR 1
 1724 0C89 B7 0152            STAA   CRSEC            AS THE STARTING SECTOR
 1725 0C8C 96 0B              LDAA   OTRK             DEFINE THE START TRACK
 1726 0C8E 4C                 INCA                    AS THE CURRENT TRACK +1
 1727 0C8F B7 0151            STAA   CRTRK            FOR USE BY WTNDX
 1728 0C92 BD 0650            JSR    WTND5            GENERATE THE DIRECTORY ENTRY
 1729 0C95 39                 RTS                     AND RETURN
 1730                  *
 1731                  *
 1732                  *IDENTIFY INPUT DEVICE, & READ TO DISK
 1733                  *UNTIL END OF MEDIA OCCURS.
 1734                  *
 1735 0C96 96 6C       GENDV  LDAA   IBUF1            GET THE FIRST CHARACTER OF COMMAND
 1736 0C98 81 50              CMPA   #'P              IF IT IS AN ASCII "P", THEN
 1737 0C9A 27 79              BEQ    GENDA            USE HS PAPER TAPE READER I/P
 1738 0C9C 7D FF02     GEND1  TST    SPEED            IF SPEED FLAG IS NEGATIVE
 1739 0C9F 2A 0C              BPL    GEND2            IT IS A TAPE CASSETTE TERMINAL
 1740 0CA1 86 10              LDAA   #$10             LOAD THE RDC "ATTENTION"
 1741 0CA3 BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1742 0CA6 86 37              LDAA   #$37             LOAD "BLOCK FORWARD" MODE
 1743 0CA8 BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1744 0CAB 20 0D              BRA    GEND3            INPUT RESULTING DATA STREAM
 1745                  *
 1746 0CAD B6 FCFD     GEND2  LDAA   SBITC            GET CONTROL TEMPLATE FOR ACIA
 1747 0CB0 84 55              ANDA   #$55             MASK TO REQUEST FOR READER RELAY CONTROL
 1748 0CB2 B7 FCF4            STAA   ACIAC            SET UP IN ACIA (RTS)
 1749 0CB5 86 11              LDAA   #$11             LOAD "AUTO READER ON"
 1750 0CB7 BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1751 0CBA CE 1200     GEND3  LDX    #TRKBF           LOAD POINTER TO TRACK BUFFER AREA (END OF EDOS + MOD 2
 1752 0CBD DF CA       GEND4  STX    BGBFP            SAVE WRITE BUFFER POINTER
 1753 0CBF CE FFFF            LDX    #TIMAX           BEGIN TIMEOUT FOR EOM
 1754 0CC2 B6 FCF4     GEND5  LDAA   ACIAS            READ ACIA STATUS REGISTER
 1755 0CC5 47                 ASRA                    SHIFT "DATA AVAILABLE" FLAG TO C BIT
 1756 0CC6 25 09              BCS    GEND6            IF DATA IS READY, GO GET IT
 1757 0CC8 09                 DEX                     IF TIMEOUT HAS RUN DOWN
 1758 0CC9 26 F7              BNE    GEND5            THEN
 1759 0CCB 86 1A              LDAA   #ASUB            LOAD A "SUB" CHARACTER TO SHOW EOM
 1760 0CCD DE CA              LDX    BGBFP            GET CURRENT BUFFER POINTER
 1761 0CCF 20 10              BRA    GEND7            AND CLOSE OFF THE READ
 1762                  *
 1763 0CD1 DE CA       GEND6  LDX    BGBFP            GET CURRENT BUFFER POINTER
 1764 0CD3 B6 FCF5            LDAA   ACIAR            PICK UP THE DATA CHARACTER
 1765 0CD6 84 7F              ANDA   #$7F             STRIP OFF THE PARITY BIT
 1766 0CD8 81 0D              CMPA   #CR              IF IT IS AN ASCII <CR>, CYCLE THE TTY
 1767 0CDA 27 05              BEQ    GEND7            ELSE,
 1768 0CDC A7 00              STAA   0,X              STORE THE CHARACTER IN THE BUFFER
 1769 0CDE 08                 INX                     MOVE ON TO THE NEXT FREE BUFFER LOCATION
 1770 0CDF 20 DC              BRA    GEND4            AND CONTINUE READING
 1771                  *
 1772 0CE1 A7 00       GEND7  STAA   0,X              STORE THE <CR> OR <SUB>(EOM) IN THE BUFFER
 1773 0CE3 08                 INX                     MOVE ON TO THE NEXT FREE BUFFER LOCATION
 1774 0CE4 86 FF              LDAA   #$FF             GENERATE AN END-OF-LINE MARKER
 1775 0CE6 A7 00              STAA   0,X              IN THE BUFFER
 1776 0CE8 B6 FCFD            LDAA   SBITC            GET CONTROL TEMPLATE FOR ACIA
 1777 0CEB 84 35              ANDA   #$35             TURN OFF RELAY CONTROLLED READER
 1778 0CED B7 FCF4            STAA   ACIAC            BY DROPPING RTS SIGNAL
 1779 0CF0 86 13              LDAA   #$13             SIGNAL "READER OFF" OR CYCLE THE TTY
 1780 0CF2 BD F9CF            JSR    OCHAR            OUTPUT CHARACTER (NO NULLS)
 1781 0CF5 B6 FCF5            LDAA   ACIAR            REMOVE BAD CHARACTERS FROM ACIA INPUT BUFFER
 1782 0CF8 B6 FCF5            LDAA   ACIAR            DUE TO READER SHUTDOWN ON TTY
 1783                  *
 1784                  *HAVING A LOAD OF CHARACTERS IN THE BUFFER
 1785                  *WRITE THEM TO THE DISK, WITH READER OFF
 1786                  *
 1787 0CFB CE 1200            LDX    #TRKBF           DEFINE THE START OF THE DATA BUFFER
 1788 0CFE DF CA              STX    BGBFP            SET THE BUFFER POINTER TO THE START OF THE BUFFER
 1789 0D00 DE CA       GEND8  LDX    BGBFP            PICK UP THE CURRENT BUFFER POINTER
 1790 0D02 A6 00              LDAA   0,X              PICK UP A DATA CHARACTER
 1791 0D04 08                 INX                     MOVE ON TO THE NEXT CHARACTER
 1792 0D05 DF CA              STX    BGBFP            SAVE THE BUFFER POINTER
 1793 0D07 81 FF              CMPA   #$FF             AT END OF LINE, START THE READER AGAIN
 1794 0D09 27 91              BEQ    GEND1            ELSE,
 1795 0D0B 81 1A              CMPA   #ASUB            AT EOM OR TIMEOUT, EXIT
 1796 0D0D 27 05              BEQ    GEND9            ELSE,
 1797 0D0F BD E80C            JSR    XWRT             WRITE THE CHARACTER TO DISK
 1798 0D12 20 EC              BRA    GEND8            WHILE CHARACTERS IN THE BUFFER, CONTINUE
 1799                  *
 1800 0D14 39          GEND9  RTS                     RETURN TO CALLER
 1801                  *
 1802 0D15 BD EB04     GENDA  JSR    INITR            INITIALIZE HS PAPER TAPE READER
 1803 0D18 BD 0036     GENDB  JSR    PTAPV            GET DATA TO THE END OF TAPE
 1804 0D1B 25 F7              BCS    GEND9            WHILE MORE TAPE
 1805 0D1D BD E80C            JSR    XWRT             WRITE DATA TO DISK
 1806 0D20 20 F6              BRA    GENDB            CONTINUE
 1807                  *
 1808                  *
 1809      0D22        TDUMP  EQU    *
 1810      0D22        CDUMP  EQU    *
 1811 0D22 BD 036E            JSR    PRSFL            PARSE THE INPUT FILE NAME
 1812 0D25 BD 053A            JSR    DFINF            IF THE REQUESTED FILE
 1813 0D28 4D                 TSTA                    IS NOT FOUND
 1814 0D29 27 03              BEQ    DUMP1            THEN
 1815 0D2B 7E 06F4            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 1816 0D2E 96 6C       DUMP1  LDAA   IBUF1            IF FIRST CHARACTER OF COMMAND
 1817 0D30 81 43              CMPA   #'C              IS NOT A "C" (CASSETTE DUMP)
 1818 0D32 27 2D              BEQ    CDMP1            THEN
 1819 0D34 BD 0DD9            JSR    NULOC            OUTPUT 100 NULLS (10" LEADER ON TAPE)
 1820 0D37 BD 0DD9            JSR    NULOC            OUTPUT 100 NULLS (20" LEADER ON TAPE)
 1821 0D3A BD E809     TDMP1  JSR    XRI              READ A BYTE FROM DISK
 1822 0D3D 25 09              BCS    TDMP2            IF NOT END OF FILE, AND
 1823 0D3F 81 0D              CMPA   #CR              IF NOT A <CR>
 1824 0D41 27 15              BEQ    TDMP3            THEN
 1825 0D43 BD 0033            JSR    PRICV            PUNCH THIS CHARACTER
 1826 0D46 20 F2              BRA    TDMP1            AND CONTINUE
 1827                  *
 1828 0D48 86 1A       TDMP2  LDAA   #ASUB            LOAD ASCII "SUB" (EOM MARK)
 1829 0D4A BD 0033            JSR    PRICV            AND PUNCH IT TO TAPE
 1830 0D4D 86 0D              LDAA   #CR              LOAD AN ASCII <CR>
 1831 0D4F BD 0033            JSR    PRICV            AND PUNCH IT TO TAPE
 1832 0D52 BD 0DD9            JSR    NULOC            OUTPUT 100 NULLS (10" TRAILER)
 1833 0D55 7E 016E            JMP    WTCMD            WAIT FOR NEW COMMAND
 1834                  *
 1835 0D58 BD 0033     TDMP3  JSR    PRICV            PUNCH THE <CR>
 1836 0D5B 4F                 CLRA                    DEFINE A NULL (ALLOW FOR PUNCH ON/OFF)
 1837 0D5C BD 0033            JSR    PRICV            AND PUNCH IT
 1838 0D5F 20 D9              BRA    TDMP1            CONTINUE PUNCHING
 1839                  *
 1840                  *
 1841 0D61 7F 0158     CDMP1  CLR    EOFFL            CLEAR END-OF-FILE FLAG FOR CASSETTE WRITE
 1842 0D64 8D 0E       CDMP2  BSR    DUMRD            READ A RECORD TERMINATED BY EOF OR <CR>
 1843 0D66 7D 0158            TST    EOFFL            IF NOT END OF FILE YET
 1844 0D69 26 04              BNE    CDMP3            THEN
 1845 0D6B 8D 2C              BSR    DUMWT            WRITE THIS RECORD TO THE CASSETTE
 1846 0D6D 20 F5              BRA    CDMP2            CONTINUE
 1847                  *
 1848 0D6F 8D 28       CDMP3  BSR    DUMWT            WRITE THE LAST (EOF) RECORD TO CASSETTE
 1849 0D71 7E 016E            JMP    WTCMD            WAIT FOR NEXT COMMAND
 1850                  *
 1851                  *
 1852                  *THIS SUBROUTINE READS A DISK FILE UNTIL <CR> OR EOF
 1853                  *
 1854 0D74 CE 1200     DUMRD  LDX    #TRKBF           DEFINE A POINTER TO A LARGE
 1855 0D77 DF CA              STX    BGBFP            BUFFER WORK AREA
 1856                  *
 1857 0D79 BD E809     DUMR1  JSR    XRI              READ A BYTE FROM DISK
 1858 0D7C 25 0C              BCS    DUMR2            IF NOT EOF
 1859 0D7E DE CA              LDX    BGBFP            USE POINTER TO
 1860 0D80 A7 00              STAA   $0,X             STORE CHARACTER IN BUFFER
 1861 0D82 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 1862 0D83 DF CA              STX    BGBFP            AND UPDATE THE POINTER
 1863 0D85 81 0D              CMPA   #CR              IF THE CHARACTER WAS NOT <CR>
 1864 0D87 26 F0              BNE    DUMR1            CONTINUE
 1865 0D89 39                 RTS                     ELSE RETURN
 1866                  *
 1867 0D8A 86 1A       DUMR2  LDAA   #ASUB            LOAD AN ASCII "SUB" AS EOM MARK
 1868 0D8C DE CA              LDX    BGBFP            USING THE BUFFER POINTER
 1869 0D8E A7 00              STAA   $0,X             STORE "SUB" IN THE BUFFER
 1870 0D90 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 1871 0D91 86 0D              LDAA   #CR              LOAD AN ASCII <CR>
 1872 0D93 A7 00              STAA   $0,X             STORE "CR" IN THE BUFFER
 1873 0D95 7C 0158            INC    EOFFL            SET END-OF-FILE FLAG
 1874 0D98 39                 RTS                     AND RETURN
 1875                  *
 1876                  *
 1877                  *THIS SUBROUTINE WRITES A RECORD TO CASSETTE
 1878                  *RETURN IS DELAYED UNTIL RECORD IS WRITTEN
 1879                  *
 1880 0D99 0D          DUMWT  SEC                     SET THE CARRY BIT TO "1"
 1881 0D9A 79 FF62            ROL    EXPUN            SET THE EXBUG PUNCH FLAG BIT 0
 1882 0D9D 86 10              LDAA   #DLE             LOAD A R.O.C. "ATTENTION" CHAR FOR CASSETTE TERMINAL
 1883 0D9F BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1884 0DA2 86 30              LDAA   #'0              DEFINE "PRINTER OFF" COMMAND
 1885 0DA4 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1886 0DA7 86 FF              LDAA   #RUB             DEFINE A RUBOUT CHAR (TIME FILLER)
 1887 0DA9 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1888 0DAC 86 12              LDAA   #DC2             DEFINE "CASSETTE WRITE" COMMAND
 1889 0DAE BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1890 0DB1 CE 1200            LDX    #TRKBF           SET POINTER AT BEGINNING OF BUFFER
 1891 0DB4 A6 00       DUMW1  LDAA   $0,X             PICK UP A CHARACTER
 1892 0DB6 BD F018            JSR    PRINC            WRITE IT TO THE CASSETTE TAPE
 1893 0DB9 A6 00              LDAA   $0,X             LOAD THE CHARACTER AGAIN
 1894 0DBB 08                 INX                     TAKE THE NEXT BUFFER POSITION
 1895 0DBC 81 0D              CMPA   #CR              IF THE CHARACTER WAS NOT <CR>, THEN
 1896 0DBE 26 F4              BNE    DUMW1            CONTINUE, ELSE
 1897                  *
 1898 0DC0 86 14              LDAA   #DC4             DEFINE "CASSETTE OFF" COMMAND
 1899 0DC2 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1900 0DC5 86 10              LDAA   #DLE             LOAD A R.O.C. "ATTENTION" CHAR FOR CASSETTE TERMINAL
 1901 0DC7 BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1902 0DCA 86 39              LDAA   #'9              DEFINE "PRINTER ON" COMMAND
 1903 0DCC BD F9CF            JSR    OCHAR            SEND IT TO TERMINAL (NO NULLS)
 1904 0DCF 7F FF62            CLR    EXPUN            CLEAR THE PUNCH ON CONTROL FLAG
 1905                  *
 1906                  *NOW WAIT FOR CASSETTE TO WRITE LAST RECORD & STOP
 1907                  *
 1908 0DD2 CE 5DC0            LDX    #24000           DEFINE A COUNT OF 24000, DECIMAL
 1909 0DD5 09          WAIT1  DEX                     COUNT DOWN TO 0, @ 8 USEC PER COUNT
 1910 0DD6 26 FD              BNE    WAIT1            WHILE COUNT, CONTINUE (200 MILLISECONDS)
 1911 0DD8 39                 RTS                     AFTER TIMED WAIT, RETURN TO CALLER
 1912                  *
 1913                  *
 1914                  *
 1915                  *THIS ROUTINE OUTPUTS 100 DECIMAL NULLS TO THE SWITCHED PRINT DEVICE
 1916                  *
 1917 0DD9 C6 64       NULOC  LDAB   #100             DEFINE A COUNT OF
 1918 0DDB D7 C9              STAB   NULC1            100 NULLS TO BE O/P
 1919 0DDD 4F          NULO1  CLRA                    PRODUCE A NULL CHARACTER
 1920 0DDE BD 0033            JSR    PRICV            USING SWITCH VECTOR, PRINT IT
 1921 0DE1 7A 00C9            DEC    NULC1            WHILE 100 NULLS
 1922 0DE4 26 F7              BNE    NULO1            CONTINUE TO OUTPUT NULLS
 1923 0DE6 39                 RTS                     RETURN TO CALLER
