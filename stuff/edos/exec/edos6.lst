 2175                         PAGE                    THIS PROGRAM WAS COMMENTED BY THE AUSTRALIAN 6800 USER'S GROUP
 2176                  *
 2177                  *THIS FUNCTION PURGES UNWANTED FILES FROM THE DISK, AND
 2178                  *PACKS THE REMAINING FILES, RECLAIMING THE SPACE
 2179                  *
 2180                  *PURGE IS DONE IN TWO PASSES
 2181                  *
 2182                  *                     PASS 1
 2183                  *TEST VALIDITY OF INPUT FILE STRING, WRITE DELETED FILE
 2184                  *MARKERS IN DIRECTORY FCB OF FILES TO BE PURGED.
 2185                  *
 2186                  *                     PASS 2
 2187                  *SEARCH FOR DELETED FILE MARK (ATTRIBUTE = 80).  ON FINDING
 2188                  *THE FIRST DELETED FILE MARK, SCAN FORWARD UNTIL A NON-
 2189                  *DELETED FILE IS FOUND. THIS FILE IS THEN MOVED INTO THE
 2190                  *AREA TO BE PURGED.  THIS PROCESS THEN CONTINUES TO THE END
 2191                  *OF THE DIRECTORY. EACH TIME A FILE IS MOVED, THE DIRECTORY
 2192                  *IS UPDATED.
 2193                  *
 2194                  *                    ERRORS
 2195                  *SEVERAL ERRORS MAY OCCUR DURING THE PURGE PROCESS, SOME OF
 2196                  *WHICH ARE FATAL TO ALL FILES FOLLOWING THE ERROR.  SOME
 2197                  *POSSIBLE ERRORS MAY CAUSE DIRECTORY FAULTS.  PURGE SHOULD
 2198                  *NOT BE USED ON A DISK THAT HAS NO BACKUP COPY.
 2199                  *
 2200      0FAD        PURGE  EQU    *
 2201 0FAD 96 C5              LDAA   FLNM5            GET THE UNIT I/D TO BE PURGED
 2202 0FAF B7 0F86            STAA   PUUID            AND DEFINE THE PURGE UID
 2203 0FB2 BD 036E     PURG1  JSR    PRSFL            PARSE THE NEXT FILE NAME
 2204 0FB5 96 C0              LDAA   FLNM0            GET THE FIRST CHARACTER
 2205 0FB7 81 20              CMPA   #SPC             IF IT IS A SPACE
 2206 0FB9 26 03              BNE    PURG2            THEN
 2207 0FBB 7E 105E            JMP    PKDSK            FILE INPUT IS COMPLETE
 2208                  *
 2209 0FBE B6 0F86     PURG2  LDAA   PUUID            PICK UP THE PURGE UID
 2210 0FC1 97 C5              STAA   FLNM5            AND DEFINE THIS FILE TO RESIDE ON PURGE UID DRIVE
 2211 0FC3 BD 053A            JSR    DFINF            DEFINE THE INPUT FILE
 2212 0FC6 4D                 TSTA                    IF SUCCESSFUL
 2213 0FC7 26 E9              BNE    PURG1            THEN
 2214 0FC9 A6 05              LDAA   $5,X             GET THE ATTRIBUTE ENTRY
 2215 0FCB 81 01              CMPA   #$1              IF THE ATTRIBUTE IS NOT "PERMANENT" (01)
 2216 0FCD 26 16              BNE    PURG3            THEN
 2217                  *
 2218 0FCF CE 00C0            LDX    #FLNM0           SET A POINTER TO THE FILE NAME
 2219 0FD2 C6 05              LDAB   #$5              WITH A CHARACTER COUNT OF 5
 2220 0FD4 BD 03C1            JSR    PRINS            PRINT OUT THE FILE NAME
 2221 0FD7 CE 0F8E            LDX    #PERMM+1         POINT TO MESSAGE STRING & SET CHAR
 2222 0FDA F6 0F8D            LDAB   PERMM            COUNT FOR PERMANENT MESSAGE
 2223 0FDD BD 03C1            JSR    PRINS            PRINT " PERMANENT"
 2224 0FE0 BD 03CB            JSR    CRLF             PRINT <CR><LF> FOR NEW LINE ON PRINTER
 2225 0FE3 20 CD              BRA    PURG1            CONTINUE WITH NEXT FILE
 2226                  *
 2227 0FE5 86 80       PURG3  LDAA   #$80             DEFINE A "DELETED FILE" MARK
 2228 0FE7 A7 05              STAA   $5,X             SET FILE ATTRIBUTE "DELETED" IN FCB
 2229 0FE9 B6 0150            LDAA   USECT            PICK UP THE DIRECTORY <UNIT><SECTOR>
 2230 0FEC 5F                 CLRB                    SELECT TRACK 0 FOR DIRECTORY
 2231 0FED CE 00D0            LDX    #SECB1           SET A POINTER TO THE SECTOR BUFFER
 2232 0FF0 BD 0487            JSR    WRTSE            WRITE THIS SECTOR TO DISK
 2233 0FF3 4D                 TSTA                    IF DIRECTORY SECTOR WRITE FAILURE
 2234 0FF4 27 03              BEQ    PURG4            THEN
 2235 0FF6 7E 043C            JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 2236                  *
 2237 0FF9 CE 00C0     PURG4  LDX    #FLNM0           SET A POINTER TO THE FILE NAME
 2238 0FFC C6 05              LDAB   #$5              WITH A CHARACTER COUNT OF 5
 2239 0FFE BD 03C1            JSR    PRINS            PRINT OUT THE FILE NAME
 2240 1001 CE 0F99            LDX    #PURGM+1         POINT TO MESSAGE STRING & SET CHAR
 2241 1004 F6 0F98            LDAB   PURGM            COUNT FOR PURGED MESSAGE
 2242 1007 BD 03C1            JSR    PRINS            PRINT " PURGED"
 2243 100A BD 03CB            JSR    CRLF             PRINT <CR><LF> FOR NEW LINE ON PRINTER
 2244 100D 20 A3              BRA    PURG1            CONTINUE WITH NEXT FILE
 2245                  *
 2246                  *
 2247 100F 0C          DIRSE  CLC                     CLEAR "C" BIT FOR SHIFTING
 2248 1010 B6 0F86            LDAA   PUUID            PICK UP PURGE UNIT I/D
 2249 1013 46                 RORA                    SHIFT UID BITS INTO BITS 6 &7
 2250 1014 46                 RORA                    ROTATING THEM THROUGH THE C BIT
 2251 1015 46                 RORA                    BIT 7 BECOMES OLD 1, BIT 6 BECOMES OLD 0
 2252 1016 8A 04              ORAA   #$4              THE DIRECTORY STARTS AT SECTOR 4
 2253 1018 B7 0F8C            STAA   PUSEM            DEFINE THE PURGE DIRECTORY <UNIT><SECTOR>
 2254                  *
 2255 101B CE 00D0     DIRS1  LDX    #SECB1           LOAD POINTER FOR SECTOR BUFFER
 2256 101E FF 0F8A            STX    PUFMP            INITIALIZE THE SECTOR SCAN
 2257                  *
 2258 1021 B6 0F8C     DIRS2  LDAA   PUSEM            GET CURRENT <UNIT><SECTOR>
 2259 1024 84 3F              ANDA   #$3F             MASK TO SECTOR ONLY (STRIP OFF UID)
 2260 1026 81 1B              CMPA   #27              IF THIS IS THE END OF TRACK (26 SECTORS/TRACK)
 2261 1028 26 03              BNE    DIRS3            THEN
 2262 102A 86 FF              LDAA   #$FF             FLAG END OF DIRECTORY
 2263 102C 39                 RTS                     AND RETURN TO CALLER
 2264                  *
 2265 102D CE 00D0     DIRS3  LDX    #SECB1           START AT THE BEGINNING OF THE SECTOR BUFFER
 2266 1030 B6 0F8C            LDAA   PUSEM            GET CURRENT <UNIT><SECTOR>
 2267 1033 5F                 CLRB                    SELECT TRACK 0 FOR THE DIRECTORY
 2268 1034 BD 040F            JSR    RED11            READ IN THE DIRECTORY SECTOR
 2269 1037 4D                 TSTA                    IF A "DD" MARK WAS FOUND IN THIS SECTOR
 2270 1038 27 05              BEQ    DIRS5            THEN
 2271 103A 7C 0F8C     DIRS4  INC    PUSEM            TAKE THE NEXT SECTOR
 2272 103D 20 DC              BRA    DIRS1            AND TRY IT
 2273                  *
 2274 103F FE 0F8A     DIRS5  LDX    PUFMP            USE THE CURRENT SECTOR POINTER
 2275 1042 A6 05              LDAA   $5,X             READ THE ATTRIBUTE VALUE FROM THE CURRENT FCB
 2276 1044 39                 RTS                     AND RETURN TO CALLER
 2277                  *
 2278                  *
 2279                  *ADVANCE BUFFER POINTER BY 11 TO NEXT FCB.
 2280                  *WHEN NEEDED, GET NEXT DIRECTORY SECTOR
 2281                  *
 2282 1045 86 0B       NXFCB  LDAA   #11              DEFINE 11 BYTES IN A FILE CONTROL BLOCK
 2283 1047 5F                 CLRB                    WITH A HIGH BYTE OF 0
 2284 1048 BB 0F8B            ADDA   PUFMP+LBYT       ADD 11 TO LOW BYTE OF POINTER
 2285 104B F9 0F8A            ADCB   PUFMP            ADD IN THE CARRY (IF ANY) TO THE HIGH BYTE
 2286 104E B7 0F8B            STAA   PUFMP+LBYT       STORE THE LOW POINTER BYTE
 2287 1051 F7 0F8A            STAB   PUFMP            AND THE HIGH POINTER BYTE (POINTER IS NOW +11)
 2288 1054 FE 0F8A            LDX    PUFMP            USE THE NEW POINTER VALUE (NEXT FCB)
 2289 1057 8C 0149            CPX    #SECB1+121       IF THERE ARE NO MORE FCB'S IN THIS SECTOR
 2290 105A 26 C5              BNE    DIRS2            THEN
 2291 105C 20 DC              BRA    DIRS4            TAKE THE NEXT SECTOR & FIRST FCB IN THAT SECTOR
 2292                  *
 2293                  *
 2294                  *SEARCH DIRECTORY FOR FILES TO BE PURGED (ATTRIBUTE = $80)
 2295                  *
 2296 105E CE 0FA1     PKDSK  LDX    #PKDSM+1         LOAD POINTER TO MESSAGE STRING
 2297 1061 F6 0FA0            LDAB   PKDSM            LOAD THE CHARACTER COUNT
 2298 1064 BD 03C1            JSR    PRINS            PRINT "PACKING DISK"
 2299 1067 BD 03CB            JSR    CRLF             PRINT <CR><LF> FOR NEW LINE
 2300 106A BD 100F            JSR    DIRSE            READ & SET UP THE FIRST DIRECTORY SECTOR
 2301                  *
 2302 106D 81 FF       PKDS1  CMPA   #$FF             IF THIS IS THE END OF THE DIRECTORY TRACK
 2303 106F 26 01              BNE    PKDS2            THEN
 2304 1071 39                 RTS                     RETURN
 2305 1072 81 80       PKDS2  CMPA   #$80             IF ATTRIBUTE OF CURRENT FCB IS NOT "DELETED FILE" ($80
 2306 1074 27 05              BEQ    PURFL            THEN
 2307 1076 BD 1045            JSR    NXFCB            LOOK AT THE NEXT FCB
 2308 1079 20 F2              BRA    PKDS1            AND CONTINUE
 2309                  *
 2310                  *PURGE THIS FILE, MOVE THE FILES, UPDATE THE DIRECTORY
 2311                  *
 2312 107B FE 0F8A     PURFL  LDX    PUFMP            GET POINTER TO CURRENT FCB
 2313 107E A6 06              LDAA   $6,X             GET THE STARTING TRACK ADDRESS OF FILE TO BE PURGED
 2314 1080 97 0B              STAA   OTRK             DEFINE IT AS START OF AN OUTPUT FILE
 2315 1082 B6 0F86            LDAA   PUUID            GET PURGE UNIT NUMBER
 2316 1085 97 02              STAA   OUNIT            DEFINE OUTPUT FILE ON THAT UNIT
 2317 1087 0C                 CLC                     CLEAR THE "C" BIT FOR SHIFTING
 2318 1088 46                 RORA                    SHIFT THE UID INTO BITS 6 & 7
 2319 1089 46                 RORA                    SHIFTING THROUGH THE CARRY BIT
 2320 108A 46                 RORA                    BIT 7 BECOMES OLD 1, BIT 6 BECOMES OLD 0
 2321 108B AA 07              ORAA   $7,X             INCLUDE THE START SECTOR OF THE FILE TO BE PURGED
 2322 108D 97 0C              STAA   OSCTR            DEFINE AS THE OUTPUT FILE <UNIT><SECTOR>
 2323 108F 7F 000D            CLR    OCNTR            CLEAR THE BYTE COUNTER FOR THE OUTPUT FILE
 2324 1092 CE 07B7            LDX    #1975            DEFINE A FILE SIZE OF ALL USER SPACE ON DISK
 2325 1095 DF 09              STX    OSIZE            AS THE OUTPUT FILE SIZE (SHUT OFF FILE SIZE MONITOR)
 2326 1097 DF C7              STX    FILRQ            REQUEST A FILE SIZE OF ALL USER SPACE
 2327 1099 FE 0F8A            LDX    PUFMP            GET POINTER TO CURRENT FCB
 2328 109C FF 0F87            STX    PUFCP            SAVE IT FOR LATER USE
 2329 109F B6 0F8C            LDAA   PUSEM            GET THE CURRENT DIRECTORY <UNIT><SECTOR>
 2330 10A2 B7 0F89            STAA   PUSEC            SAVE IT FOR USE LATER
 2331                  *
 2332 10A5 BD 1045     PURF1  JSR    NXFCB            TAKE THE NEXT FILE CONTROL BLOCK
 2333 10A8 81 FF              CMPA   #$FF             IF THIS IS NOT THE END OF THE DIRECTORY TRACK
 2334 10AA 27 36              BEQ    PURF3            AND
 2335 10AC 81 80              CMPA   #$80             IF THIS IS NOT ANOTHER DELETED FILE
 2336 10AE 27 F5              BEQ    PURF1            THEN
 2337                  *
 2338 10B0 FE 0F8A            LDX    PUFMP            POINT TO THE CURRENT FILE CONTROL BLOCK
 2339 10B3 A6 06              LDAA   $6,X             PICK UP THIS FILE'S STARTING TRACK ADDRESS
 2340 10B5 97 06              STAA   ITRK             DEFINE THIS AS AN INPUT FILE TRACK START ADDRESS
 2341 10B7 A6 08              LDAA   $8,X             PICK UP THIS FILE'S LENGTH (HIGH BYTE)
 2342 10B9 97 04              STAA   ISIZE            DEFINE AS INPUT FILE SIZE (HIGH BYTE)
 2343 10BB A6 09              LDAA   $9,X             PICK UP THIS FILE'S LENGTH (LOW BYTE)
 2344 10BD 97 05              STAA   ISIZE+LBYT       DEFINE AS INPUT FILE SIZE (LOW BYTE)
 2345 10BF 7F 0008            CLR    ICNTR            CLEAR THE INPUT FILE BYTE COUNTER
 2346 10C2 B6 0F86            LDAA   PUUID            GET PURGE UNIT NUMBER
 2347 10C5 0C                 CLC                     CLEAR THE "C" BIT FOR SHIFTING
 2348 10C6 46                 RORA                    SHIFT THE UID INTO BITS 6 & 7
 2349 10C7 46                 RORA                    ROTATING THEM THROUGH THE CARRY BIT
 2350 10C8 46                 RORA                    BIT 7 BECOMES OLD 1, BIT 6 BECOMES OLD 0
 2351 10C9 AA 07              ORAA   $7,X             INCLUDE SECTOR TO MAKE <UNIT><SECTOR>
 2352 10CB 4A                 DECA                    MINUS ONE
 2353 10CC 97 07              STAA   ISCTR            AS THE STARTING SECTOR FOR AN INPUT FILE
 2354 10CE 0C                 CLC                     CLEAR THE "C" BIT FOR SHIFTING
 2355 10CF 49                 ROLA                    SHIFT UID BACK INTO BITS 1 & 0
 2356 10D0 49                 ROLA                    SECTOR NUMBER NOW OCCUPIES BITS 3 - 7
 2357 10D1 49                 ROLA                    (SECTOR NUMBER IS * 8)
 2358 10D2 97 03              STAA   IUNIT            SAVE THIS AS INPUT UNIT <SECTOR><UNIT>
 2359 10D4 BD 0F51            JSR    MOVFL            MOVE THE INPUT FILE INTO SPACE CREATED BY PURGING
 2360 10D7 7D 000D     PURF2  TST    OCNTR            IF OUTPUT SECTOR NOT COMPLETE
 2361 10DA 27 09              BEQ    PURF4            THEN
 2362 10DC 4F                 CLRA                    DEFINE A NULL
 2363 10DD BD E80C            JSR    XWRT             PAD THE REMAINDER OF THIS SECTOR WITH NULLS
 2364 10E0 20 F5              BRA    PURF2            WHILE SECTOR, CONTINUE
 2365                  *
 2366 10E2 7E 119A     PURF3  JMP    WTEOD            CLOSE END OF DIRECTORY (BRANCH RANGE EXTENSION)
 2367                  *
 2368                  *
 2369                  *UPDATE THE FCB NOW RELATING TO THE FILE JUST MOVED
 2370                  *
 2371 10E5 FE 0F8A     PURF4  LDX    PUFMP            SET THE POINTER TO THE FCB OF THE FILE JUST MOVED
 2372 10E8 A6 05              LDAA   $5,X             GET FILE ATTRIBUTE
 2373 10EA 36                 PSHA                    AND SAVE IT
 2374 10EB A6 04              LDAA   $4,X             GET NAME CHAR #5
 2375 10ED 36                 PSHA                    AND SAVE IT
 2376 10EE A6 03              LDAA   $3,X             GET NAME CHAR #4
 2377 10F0 36                 PSHA                    AND SAVE IT
 2378 10F1 A6 02              LDAA   $2,X             GET NAME CHAR #3
 2379 10F3 36                 PSHA                    AND SAVE IT
 2380 10F4 A6 01              LDAA   $1,X             GET NAME CHAR #2
 2381 10F6 36                 PSHA                    AND SAVE IT
 2382 10F7 A6 00              LDAA   $0,X             GET NAME CHAR #1
 2383 10F9 36                 PSHA                    AND SAVE IT
 2384                  *
 2385 10FA D6 C7              LDAB   FILRQ            GET THE CURRENT "MAXIMUM USER DISK SPACE"
 2386 10FC 96 C8              LDAA   FILRQ+LBYT       (IT STARTED OUT AS 1975 SECTORS)
 2387 10FE 90 0A              SUBA   OSIZE+LBYT       SUBTRACT THE SECTORS NOT USED DURING
 2388 1100 D2 09              SBCB   OSIZE            WRITE, GIVING THIS FILE'S SECTOR COUNT
 2389 1102 8B 01              ADDA   #$1              OR SIZE, AFTER ALLOWING ONE MORE SECTOR
 2390 1104 C9 00              ADCB   #$0              WITH PROPAGATED CARRY
 2391 1106 37                 PSHB                    SAVE FILE SIZE (HIGH)
 2392 1107 36                 PSHA                    SAVE FILE SIZE (LOW)
 2393                  *
 2394 1108 CE 00D0            LDX    #SECB1           POINT TO THE DIRECTORY SECTOR BUFFER
 2395 110B B6 0F89            LDAA   PUSEC            GET <UNIT><SECTOR> FOR PURGED FILE FCB
 2396 110E 5F                 CLRB                    USE TRACK 0 FOR DIRECTORY READ
 2397 110F BD 040F            JSR    RED11            READ THE DIRECTORY SECTOR
 2398                  *
 2399                  *AN ERROR CHECK HAS BEEN MISSED HERE!!!!
 2400                  *
 2401 1112 FE 0F87            LDX    PUFCP            POINT TO THE CURRENT PURGED FILE FCB
 2402 1115 32                 PULA                    GET LOW BYTE OF MOVED FILE SIZE
 2403 1116 A7 09              STAA   $9,X             STORE IT AS FCB LENGTH (LOW)
 2404 1118 32                 PULA                    GET HIGH BYTE OF MOVED FILE SIZE
 2405 1119 A7 08              STAA   $8,X             STORE IT AS FCB LENGTH (HIGH)
 2406 111B 32                 PULA                    GET THE FIRST CHAR OF THE MOVED FILE NAME
 2407 111C A7 00              STAA   $0,X             STORE IT AS FCB NAME, CHAR 1
 2408 111E 32                 PULA                    GET THE SECOND CHAR OF THE MOVED FILE NAME
 2409 111F A7 01              STAA   $1,X             STORE IT AS FCB NAME, CHAR 2
 2410 1121 32                 PULA                    GET THE THIRD CHAR OF THE MOVED FILE NAME
 2411 1122 A7 02              STAA   $2,X             STORE IT AS FCB NAME, CHAR 3
 2412 1124 32                 PULA                    GET THE FOURTH CHAR OF THE MOVED FILE NAME
 2413 1125 A7 03              STAA   $3,X             STORE IT AS FCB NAME, CHAR 4
 2414 1127 32                 PULA                    GET THE FIFTH CHAR OF THE MOVED FILE NAME
 2415 1128 A7 04              STAA   $4,X             STORE IT AS FCB NAME, CHAR 5
 2416 112A 32                 PULA                    GET THE ATTRIBUTE CHARACTER OF THE MOVED FILE
 2417 112B A7 05              STAA   $5,X             STORE IT AS FCB ATTRIBUTE CHAR
 2418                  *
 2419                  *FCB IS NOW UPDATED (TRACK & SECTOR ARE KNOWN TO BE CORRECT)
 2420                  *
 2421 112D CE 00D0            LDX    #SECB1           POINT TO THE BEGINNING OF THE SECTOR BUFFER
 2422 1130 B6 0F89            LDAA   PUSEC            GET THE <UNIT><SECTOR> FOR THIS FCB ENTRY
 2423 1133 5F                 CLRB                    SELECT TRACK 0 FOR THE DIRECTORY
 2424 1134 BD 0487            JSR    WRTSE            WRITE THIS SECTOR TO DISK
 2425 1137 4D                 TSTA                    IF THERE WAS A WRITE ERROR
 2426 1138 27 03              BEQ    PURF5            THEN
 2427 113A 7E 043C            JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 2428                  *
 2429 113D B6 0F8A     PURF5  LDAA   PUFMP            GET POINTER TO CURRENT FCB (HIGH BYTE)
 2430 1140 36                 PSHA                    AND SAVE IT
 2431 1141 B6 0F8B            LDAA   PUFMP+LBYT       GET POINTER TO CURRENT FCB (LOW BYTE)
 2432 1144 36                 PSHA                    AND SAVE IT
 2433 1145 B6 0F8C            LDAA   PUSEM            GET CURRENT FCB <UNIT><SECTOR>
 2434 1148 36                 PSHA                    AND SAVE IT
 2435 1149 FE 0F87            LDX    PUFCP            GET THE POINTER FOR FCB OF THE PURGED FILE
 2436 114C FF 0F8A            STX    PUFMP            AND SAVE IT AS TARGET FOR FCB MOVE
 2437 114F B6 0F89            LDAA   PUSEC            GET THE <UNIT><SECTOR> FOR FCB OF THE PURGED FILE
 2438 1152 B7 0F8C            STAA   PUSEM            AND SAVE IT AS TARGET FOR FCB MOVE
 2439 1155 BD 1045            JSR    NXFCB            GET THE NEXT FCB
 2440 1158 FE 0F8A            LDX    PUFMP            POINT TO IT IN THE SECTOR BUFFER
 2441 115B 96 0B              LDAA   OTRK             GET THE LAST TRACK USED
 2442 115D A7 06              STAA   $6,X             SAVE IT AS START TRACK IN THE NEW FCB
 2443 115F 96 0C              LDAA   OSCTR            GET THE LAST <UNIT><SECTOR> USED
 2444 1161 84 3F              ANDA   #$3F             STRIP OFF THE UNIT ID BITS
 2445 1163 A7 07              STAA   $7,X             SAVE IT AS START SECTOR IN THE NEW FCB
 2446 1165 CE 00D0            LDX    #SECB1           START AT THE BEGINNING OF THE SECTOR BUFFER
 2447 1168 B6 0F8C            LDAA   PUSEM            GET THE <UNIT><SECTOR> FOR THE CHANGED FCB
 2448 116B 5F                 CLRB                    SELECT TRACK 0 FOR THE DIRECTORY
 2449 116C BD 0487            JSR    WRTSE            WRITE THIS SECTOR TO DISK
 2450 116F 4D                 TSTA                    IF THERE WAS A WRITE ERROR
 2451 1170 27 03              BEQ    PURF7            THEN
 2452 1172 7E 043C     PURF6  JMP    MEDER            PRINT "MEDIA ERROR" & WAIT FOR NEW COMMAND
 2453 1175 CE 07B7     PURF7  LDX    #1975            DEFINE MAXIMUM USER SPACE AVAILABLE ON DISK
 2454 1178 DF 09              STX    OSIZE            SET AN OUTPUT SIZE OF MAX. (SHUT OFF OUTPUT TEST)
 2455 117A DF C7              STX    FILRQ            REQUEST A OUTPUT FILE OF MAXIMUM USER SPACE
 2456 117C 7F 000D            CLR    OCNTR            CLEAR THE OUTPUT FILE BYTE COUNTER
 2457 117F FE 0F8A            LDX    PUFMP            GO BACK TO THE PURGED FILE FCB
 2458 1182 FF 0F87            STX    PUFCP            IN THE SAVE LOCATION
 2459 1185 B6 0F8C            LDAA   PUSEM            GO BACK TO THE PURGED FILE <UNIT><SECTOR>
 2460 1188 B7 0F89            STAA   PUSEC            IN THE SAVE LOCATION
 2461 118B 32                 PULA                    GET CURRENT <UNIT><SECTOR> OFF STACK
 2462 118C B7 0F8C            STAA   PUSEM            AND RESTORE IT
 2463 118F 32                 PULA                    GET LOW BYTE OF CURRENT FCB PONTER OFF STACK
 2464 1190 B7 0F8B            STAA   PUFMP+LBYT       AND RESTORE IT
 2465 1193 32                 PULA                    GET HIGH BYTE OF CURRENT FCB POINTER OFF STACK
 2466 1194 B7 0F8A            STAA   PUFMP            AND RESTORE IT
 2467 1197 7E 10A5            JMP    PURF1            CONTINUE THE PACKING PROCESS
 2468                  *
 2469                  *
 2470                  *THIS SUBROUTINE WRITES AN END-OF-DIRECTORY FCB ENTRY
 2471                  *
 2472 119A CE 00D0     WTEOD  LDX    #SECB1           POINT TO THE SECTOR BUFFER
 2473 119D B6 0F89            LDAA   PUSEC            GET THE CURRENT <UNIT><SECTOR>
 2474 11A0 5F                 CLRB                    SELECT TRACK 0 FOR THE DIRECTORY
 2475 11A1 BD 040F            JSR    RED11            READ THIS SECTOR FROM THE DISK
 2476                  *
 2477                  *AN ERROR CHECK IS MISSING HERE!!!
 2478                  *
 2479 11A4 FE 0F87            LDX    PUFCP            POINT TO THE "NEXT FCB" DEFINED AT LAST MOVE
 2480 11A7 86 2A              LDAA   #'*              DEFINE ASCII CHARACTER "*"
 2481 11A9 A7 00              STAA   $0,X             DEFINE THE NAME
 2482 11AB A7 01              STAA   $1,X             OF THE EOD
 2483 11AD A7 02              STAA   $2,X             FILE TO BE
 2484 11AF A7 03              STAA   $3,X             "*****"
 2485 11B1 A7 04              STAA   $4,X             AS AN IDENTIFIER
 2486 11B3 86 FF              LDAA   #$FF             DEFINE EOD ATTRIBUTE
 2487 11B5 A7 05              STAA   $5,X             AS NEW FCB ATTRIBUTE
 2488 11B7 96 0B              LDAA   OTRK             TAKE THE LAST TRACK WRITTEN
 2489 11B9 A7 06              STAA   $6,X             AS THE START TRACK FOR THIS FCB
 2490 11BB 96 0C              LDAA   OSCTR            TAKE THE LAST <UNIT><SECTOR> WRITTEN
 2491 11BD 84 3F              ANDA   #$3F             STRIP OFF UNIT ID BITS
 2492 11BF A7 07              STAA   $7,X             AND USE AS START SECTOR FOR THIS FCB
 2493 11C1 CE 00D0            LDX    #SECB1           POINT TO THE BEGINNING OF THE SECTOR BUFFER
 2494 11C4 B6 0F89            LDAA   PUSEC            GET <UNIT><SECTOR> FOR THIS FCB
 2495 11C7 5F                 CLRB                    SELECT TRACK 0 FOR THE DIRECTORY
 2496 11C8 BD 0487            JSR    WRTSE            WRITE THIS SECTOR TO DISK
 2497 11CB 4D                 TSTA                    IF THERE WAS NO WRITE ERROR
 2498 11CC 26 A4              BNE    PURF6            THEN
 2499 11CE 39                 RTS                     RETURN TO CALLER
 2500                  *
 2501                  *
 2502                  **TRACK BUFFER & LARGE BUFFER ALLOCATION BEGINS AFTER EDOS
 2503                  *
 2504 1200                    ORG    $1200
 2505                  *
 2506      1200        TRKBF  EQU    *                DISK TRACK BUFFER START ADDRESS
 2507 1200             BGBUF  RMB    3326             LARGE DATA BUFFER
 2508      1EFE        BGBFE  EQU    *                END OF ALLOCATION FOR LARGE DATA BUFFER
 2509                  *
 2510                         END

