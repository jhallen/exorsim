  159                  *
  160                  *EDOS STARTUP ENTRY POINT - PRINT OUT ID MESSAGE - WAIT FOR COMMAND I/P
  161                  *
  162 015C 8E 006B     EXEC   LDS    #EXSTK           INITIALIZE EXECUTIVE STACK
  163 015F BD 03CB            JSR    CRLF             ESTABLISH NEW LINE ON CONSOLE
  164 0162 F6 02F7            LDAB   IDMES            GET CHARACTER COUNT FOR I/D
  165 0165 CE 02F8            LDX    #IDMES+1         SET STRING POINTER FOR I/D
  166 0168 BD 03C1            JSR    PRINS            OUTPUT I/D MESSAGE ON CONSOLE
  167 016B BD 03CB            JSR    CRLF             END I/D WITH <CR><LF>
  168 016E 0F          WTCMD  SEI                     WAIT FOR USER COMMAND (INTERRUPTS DISABLED)
  169 016F BD E806            JSR    INTIO            INIT DISC INTERFACE TO KNOWN STATE
  170 0172 8E 006B            LDS    #EXSTK           REINITIALIZE EDOS STACK SPACE
  171 0175 BD 0335            JSR    USCMD            OUTPUT USER PROMPT CHARACTER, WAIT FOR COMMAND
  172 0178 BD 036E            JSR    PRSFL            PARSE COMMAND & LEAVE IN FLNM0-FLNM4
  173                  *
  174                  *DO STRING COMPARE TO IDENTIFY COMMAND.  COMMAND LIST IS PACKED
  175                  *IN 5-CHARACTER STRINGS, PADDED WITH TRAILING SPACES.  THE SWITCH
  176                  *ADDRESS FOR EACH COMMAND FOLLOWS THE CHARACTER STRING.
  177                  *THE INPUT COMMAND STRING IS FOUND AT FLNM0 TO FLNM4
  178                  *
  179 017B CE 01BB            LDX    #CMDST           POINT TO START OF PROTOTYPE COMMANDS
  180 017E 8C 0286     CMDLP  CPX    #CMDLM           IF ALL POSSIBLE COMMANDS EXAUSTED
  181 0181 26 0B              BNE    TRYCM            THEN
  182 0183 F6 0286     ERRM   LDAB   FERRM            GET CHARACTER COUNT FOR MESSAGE
  183 0186 CE 0287            LDX    #FERRM+1         SET STRING POINTER FOR FORMAT ERROR MESSAGE
  184 0189 BD 03C1     MSWTC  JSR    PRINS            PRINT MESSAGE ON CONSOLE
  185 018C 20 E0              BRA    WTCMD            WAIT FOR ANOTHER COMMAND INPUT
  186                  *
  187 018E A6 00       TRYCM  LDAA   $0,X             IF FIRST PROTOTYPE CHARACTER EQUALS
  188 0190 91 C0              CMPA   FLNM0            FIRST CHARACTER OF THIS COMMAND
  189 0192 26 1E              BNE    SKPCM            AND
  190 0194 A6 01              LDAA   $1,X             SECOND PROTOTYPE CHARACTER EQUALS
  191 0196 91 C1              CMPA   FLNM1            SECOND CHARACTER OF THIS COMMAND
  192 0198 26 18              BNE    SKPCM            AND
  193 019A A6 02              LDAA   $2,X             THIRD PROTOTYPE CHARACTER EQUALS
  194 019C 91 C2              CMPA   FLNM2            THIRD CHARACTER OF THIS COMMAND
  195 019E 26 12              BNE    SKPCM            AND
  196 01A0 A6 03              LDAA   $3,X             FOURTH PROTOTYPE CHARACTER EQUALS
  197 01A2 91 C3              CMPA   FLNM3            FOURTH CHARACTER OF THIS COMMAND
  198 01A4 26 0C              BNE    SKPCM            AND
  199 01A6 A6 04              LDAA   $4,X             FITH PROTOTYPE CHARACTER EQUALS
  200 01A8 91 C4              CMPA   FLNM4            FITH CHARACTER OF THIS COMMAND
  201 01AA 26 06              BNE    SKPCM            THEN
  202 01AC EE 05              LDX    $5,X             COMMAND IS IDENTIFIED, SELECT ADDRESS
  203 01AE AD 00              JSR    $0,X             CALL THIS COMMAND SERVICE
  204 01B0 20 BC              BRA    WTCMD            WAIT FOR NEXT COMMAND
  205                  *
  206 01B2 08          SKPCM  INX                     STEP
  207 01B3 08                 INX                     OVER
  208 01B4 08                 INX                     FIVE
  209 01B5 08                 INX                     PROTOTYPE
  210 01B6 08                 INX                     CHARS &
  211 01B7 08                 INX                     SERVICE
  212 01B8 08                 INX                     ADDRESS.
  213 01B9 20 C3              BRA    CMDLP            TRY ANOTHER COMMAND
