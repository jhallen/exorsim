 2107                  *
 2108                  *THIS FUNCTION IS A GENERAL FILE DUPLICATE OR MERGE FACILITY
 2109                  *
 2110      0F34        MERGE  EQU    *
 2111 0F34 BD 0C40            JSR    SVIOF            CREATE A NAMED FCB, ATTR = FF, SIZE = FREE SPACE
 2112 0F37 BD 036E     MERG1  JSR    PRSFL            PARSE THE NEXT FILE NAME & UNIT I/D
 2113 0F3A 96 C0              LDAA   FLNM0            IF THE FILE IS DEFINED
 2114 0F3C 81 20              CMPA   #SPC             (FIRST SPACE IS OVERWRITTEN)
 2115 0F3E 27 0E              BEQ    MERG3            THEN
 2116 0F40 BD 053A            JSR    DFINF            LOOK FOR THIS FILE
 2117 0F43 4D                 TSTA                    IF IT DOES NOT EXIST
 2118 0F44 27 03              BEQ    MERG2            THEN
 2119 0F46 7E 06F4            JMP    NOSFL            PRINT "NO SUCH FILE" & WAIT FOR NEW COMMAND
 2120                  *
 2121 0F49 BD 0F51     MERG2  JSR    MOVFL            MOVE SOURCE FILE TO DESTINATION FILE
 2122 0F4C 20 E9              BRA    MERG1            LOOK FOR MORE SOURCE FILES
 2123                  *
 2124 0F4E 7E 06A0     MERG3  JMP    FLCLS            CLOSE THE OUPUT FILE & WAIT FOR THE NEXT COMMAND
 2125                  *
 2126                  *
 2127                  *MOVE AN INPUT FILE TO A OUTPUT FILE, VIA A LARGE BUFFER AREA
 2128                  *
 2129 0F51 7F 0158     MOVFL  CLR    EOFFL            CLEAR "END OF FILE" FLAG
 2130 0F54 CE 1200     MOVF1  LDX    #BGBUF           SET THE POINTER AT THE START
 2131 0F57 DF CA       MOVF2  STX    BGBFP            OF THE LARGE BUFFER AREA
 2132 0F59 BD E809            JSR    XRI              GET AN INPUT BYTE FROM THE DISK
 2133 0F5C 25 23              BCS    MOVF5            IF NOT EOF, THEN
 2134 0F5E DE CA              LDX    BGBFP            LOAD THE CURRENT BUFFER POINTER
 2135 0F60 A7 00              STAA   $0,X             STORE THE DATA IN THE BUFFER AREA
 2136 0F62 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 2137 0F63 8C 1EFE            CPX    #BGBFE           IF END OF THE BUFFER
 2138 0F66 26 EF              BNE    MOVF2            THEN
 2139                  *
 2140 0F68 DF CA              STX    BGBFP            SAVE THE POINTER AS A LIMIT
 2141 0F6A CE 1200     MOVF3  LDX    #BGBUF           START AT THE BEGINNING OF THE BUFFER
 2142 0F6D DF CC       MOVF4  STX    BFOP2            USING AN OUTPUT POINTER LOCATION
 2143 0F6F A6 00              LDAA   $0,X             GET THE CURRENT DATA BYTE
 2144 0F71 BD E80C            JSR    XWRT             WRITE THE DATA TO DISK
 2145 0F74 DE CC              LDX    BFOP2            LOAD THE OUTPUT POINTER
 2146 0F76 08                 INX                     TAKE THE NEXT BUFFER LOCATION
 2147 0F77 9C CA              CPX    BGBFP            IF REACHED PREVIOUS END POINT
 2148 0F79 26 F2              BNE    MOVF4            THEN
 2149 0F7B 7D 0158            TST    EOFFL            IF THE END OF FILE HAS BEEN REACHED
 2150 0F7E 27 D4              BEQ    MOVF1            THEN
 2151 0F80 39                 RTS                     FILE IS MOVED, RETURN TO CALLER
 2152                  *
 2153 0F81 7C 0158     MOVF5  INC    EOFFL            RECORD END OF FILE FOUND
 2154 0F84 20 E4              BRA    MOVF3            START WRITING IT
