   12                  *
   13                  * EDOS and EXBUG addresses
   14                  *
   15      0000        XPASS  EQU    $0               ASSEMBLY PASS: 5, 7, 9 (USER 2,3,4)
   16      E800        XABORT EQU    $E800            ENTER EDOS, ABORT OUTPUT FILE
   17      E809        XRI    EQU    $E809            EDOS ROM DISK BYTE READ ROUTINE
   18      E80C        XWRT   EQU    $E80C            EDOS ROM DISK WRITE ROUTINE
   19      E80F        XSAVE  EQU    $E80F            ENTER EDOS, KEEP OUTPUT FILE
   20      F018        XOUTC  EQU    $F018            EXBUG PRINT SINGLE CHARACTER (ON CONSOLE)
   21      E82D        XRESTR EQU    $E82D            EDOS REWIND INPUT FILE
   22      FF8A        EXBST  EQU    $FF8A            EXBUG STACK ALLOCATION START ADDRESS
   23                  *
   24                  * MEMORY LIMIT: Assembler will not use memory above this value
   25                  *
   26      7FFF        MLIMIT EQU    $7FFF
   27                  *
   28                  * EDOS START ADDRESS
   29                  *
   30 0020                    ORG    $20
   31 0020 7E 05D9            JMP    PASS1
   32                  *
   33                  * Skip over EDOS stack so that it doesn't get clobbered during load
   34                  *
   35 015C                    ORG    $15C
   36                  *
   37                  * Save original stack pointer here
   38 015C             ORGSTK RMB    2
   39                  *
