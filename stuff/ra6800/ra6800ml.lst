  891                  *
  892                  * COMPARE TWO STRINGS *
  893                  *
  894                  * ON ENTRY (X) = A PRAM LIST OF 5 BYTES *
  895                  *    ADDR(STRING1)
  896                  *    ADDR(STRING2)
  897                  *    COUNT OF # BYTES TO BE COMPARED
  898                  *
  899                  * ON RETURN IF CC Z BIT IS SET THERE IS A MATCH
  900                  *    EXAMPLE :
  901                  *          LDX #STRING1
  902                  *          JSR COMPAR
  903                  *          BEQ ------   MATCH
  904                  *
  905                  *    STRING1 RMB 2
  906                  *    STRING2 RMB 2
  907                  *    COUNT   RMB 1
  908                  *
  909 08E6 36          COMPAR PSHA
  910 08E7 37                 PSHB
  911 08E8 E6 04              LDAB   4,X              GET COUNT
  912 08EA FF 0915            STX    XSAV             SAVE PARAM POINTER
  913 08ED FE 0915     CMP1   LDX    XSAV             GET PARAM POINTER
  914 08F0 EE 00              LDX    0,X              GET ADDR(STRING1)
  915 08F2 A6 00              LDAA   0,X              GET CHARACTER
  916 08F4 FE 0915            LDX    XSAV             GET PTR
  917 08F7 6C 01              INC    1,X              PTR SET TO NEXT
  918 08F9 26 02              BNE    CMP2             CHAR IN
  919 08FB 6C 00              INC    0,X              STRING1
  920 08FD FE 0915     CMP2   LDX    XSAV             GET PARAM POINTER
  921 0900 EE 02              LDX    2,X              GET ADDR(STRING2)
  922 0902 A1 00              CMPA   0,X              COMPARE
  923 0904 26 0C              BNE    CDONE            NOT EQUAL
  924 0906 FE 0915            LDX    XSAV             GET PARAM POINTER
  925 0909 6C 03              INC    3,X              PTR SET TO NEXT
  926 090B 26 02              BNE    CMP3             CHAR IN
  927 090D 6C 02              INC    2,X              STRING2
  928 090F 5A          CMP3   DECB                    DECREMENT COUNTER
  929 0910 26 DB              BNE    CMP1             TRY AGAIN
  930 0912 33          CDONE  PULB                    DONE
  931 0913 32                 PULA
  932 0914 39                 RTS
  933                  *
  934 0915             XSAV   RMB    2                PARAM PTR SAVE AREA
  935                  *
  936                  * NEXT TOKEN ROUTINE
  937                  * SCANS A LINE OF SOURCE CODE AND RETURNS
  938                  * THE NEXT TOKEN, CLASS &RC IN REGS A,B
  939                  * THE ADDRESS OF THE TOKEN IS RETURNED IN
  940                  * DESCRA AND THE NUM OF BYTES IN THE TOKEN IS
  941                  * THE RC AND CLASS ARE:
  942                  *
  943                  *   TYPE    RC(B)    CLASS(A)
  944                  *
  945                  * NAME       01        02        SUBSTRINGS
  946                  * HEX        03        02
  947                  * DECIMAL    09        02
  948                  *
  949                  * #          23        04        DELIMITERS
  950                  * ,          2C        04
  951                  * '          27        04
  952                  *
  953                  * *          2A        24        ARITHMETIC
  954                  * /          2F        24
  955                  * +          2B        24
  956                  * -          2D        24
  957                  *
  958                  * A          41        01        A,B,X REGS
  959                  * B          42        01
  960                  * X          58        01
  961                  *
  962                  * CR         0D        0D        EOL
  963                  *
  964                  * ERROR      00        00        ERRORS
  965                  *
  966                  *
  967 0917 7F 04C6     NXTOK  CLR    DESCRC
  968 091A 7C 04C6            INC    DESCRC           DESCRC := 1
  969 091D FE 04C7     NXT0   LDX    CUCHAR           POINT TO CURRENT CHAR
  970 0920 FF 04C4            STX    DESCRA           INIT DESCRA
  971 0923 A6 00              LDAA   0,X              GET CHAR
  972 0925 08                 INX
  973 0926 FF 04C7            STX    CUCHAR           POINT TO NEXT CHAR
  974 0929 81 20              CMPA   #$20             LESS THAN 20 HEX? (SPACE)
  975 092B 27 F0              BEQ    NXT0             BLANK,SKIP OVER
  976 092D 22 06              BHI    NXT1             IS > 20
  977                  *
  978 092F 81 0D              CMPA   #$0D             CR?
  979 0931 26 47              BNE    NXTER            NO,UNRECOGNIZABLE CHAR
  980 0933 16                 TAB                     YES, SET RC
  981 0934 39                 RTS
  982                  *
  983 0935 81 5F       NXT1   CMPA   #$5F             IS >5F?
  984 0937 23 02              BLS    NXT3             NO
  985 0939 20 3F              BRA    NXTER            YES,UNRECOGNIZABLE CHAR
  986                  *
  987 093B BD 09E4     NXT3   JSR    GCHRTB           GET BYTE FROM CHARTAB
  988 093E 85 01              BITA   #$01             A,B,X REG?
  989 0940 27 13              BEQ    NXT4             NO
  990                  *
  991 0942 FE 04C7            LDX    CUCHAR           YES,CHECK NEXT CHAR
  992 0945 E6 00              LDAB   0,X
  993 0947 C1 20              CMPB   #$20             BLANK?
  994 0949 27 04              BEQ    NXT3A            YES
  995 094B C1 0D              CMPB   #$0D             EOL?
  996 094D 26 0A              BNE    NXT4A            NO GOTO NSCAN
  997                  *
  998 094F FE 04C4     NXT3A  LDX    DESCRA           GET RC
  999 0952 E6 00              LDAB   0,X
 1000 0954 39                 RTS
 1001                  *
 1002 0955 85 80       NXT4   BITA   #$80             NAME?
 1003 0957 27 04              BEQ    NXT5             NO
 1004 0959 BD 0994     NXT4A  JSR    NSCAN            YES SCAN NAME STRING
 1005 095C 39                 RTS
 1006                  *
 1007 095D 85 40       NXT5   BITA   #$40             DECIMAL?
 1008 095F 27 04              BEQ    NXT6             NO
 1009 0961 BD 097D            JSR    DSCAN            YES,SCAN DECIMAL STRING
 1010 0964 39                 RTS
 1011                  *
 1012 0965 85 20       NXT6   BITA   #$20             ARITHMETIC?
 1013 0967 26 E6              BNE    NXT3A            YES GET RC AND RETURN
 1014                  *
 1015 0969 85 04              BITA   #$04             DELIMITERS?
 1016 096B 27 0D              BEQ    NXTER            NO,UNRCOGNIZABLE CHAR
 1017 096D FE 04C4            LDX    DESCRA           GET CHAR
 1018 0970 E6 00              LDAB   0,X
 1019 0972 C1 24              CMPB   #$24             IS ? (HEX)
 1020 0974 26 D9              BNE    NXT3A            NO,GET RC AND RTN
 1021                  *
 1022 0976 BD 09B9            JSR    HSCAN            SCAN HEX STRING
 1023 0979 39                 RTS
 1024                  *
 1025 097A 4F          NXTER  CLRA                    TROUBLE,SET RC,CLASS=00
 1026 097B 5F                 CLRB
 1027 097C 39                 RTS
 1028                  *
 1029                  * DSCAN - SCAN DECIMAL STRING AND STOP AT
 1030                  * FIRST NON-DECMIAL CHARACTER.
 1031                  *
 1032 097D FE 04C7     DSCAN  LDX    CUCHAR           POINT TO NEXT CHAR
 1033 0980 A6 00              LDAA   0,X              GET CHAR
 1034 0982 7C 04C6            INC    DESCRC           INCR DESCRC COUNT
 1035 0985 08                 INX
 1036 0986 FF 04C7            STX    CUCHAR           POINT TO NEXT CHAR
 1037 0989 BD 09E4            JSR    GCHRTB           GET BYTE IN CHARTAB
 1038 098C 85 40              BITA   #$40             DECIMAL?
 1039 098E 26 ED              BNE    DSCAN            YES CONTINUE SCAN
 1040 0990 C6 09              LDAB   #$09
 1041 0992 20 43              BRA    ENDSCN           RETURN
 1042                  *
 1043                  * NSCAN SCAN NAME STRING AND STOP AT
 1044                  * FIRST NON-ALPHANUMERIC CHAR
 1045                  *
 1046 0994 FE 04C7     NSCAN  LDX    CUCHAR           POINT TO NEXT CHAR
 1047 0997 A6 00              LDAA   0,X              GET CHAR
 1048 0999 7C 04C6            INC    DESCRC           INCR DESCRC COUNT
 1049 099C 08                 INX
 1050 099D FF 04C7            STX    CUCHAR           POINT TO NEXT CHAR
 1051 09A0 BD 09E4            JSR    GCHRTB           GET BYTE FROM CHARTAB
 1052 09A3 85 80              BITA   #$80             ALPHA?
 1053 09A5 26 ED              BNE    NSCAN            YES CONTINUE SCAN
 1054 09A7 85 40              BITA   #$40             NUMERIC?
 1055 09A9 26 E9              BNE    NSCAN            YES CONTINUE SCAN
 1056 09AB C6 07              LDAB   #$07             NAME TO LONG?
 1057 09AD F1 04C6            CMPB   DESCRC
 1058 09B0 24 03              BCC    NSCANA           NO
 1059 09B2 F7 04C6            STAB   DESCRC           YES,TRUNCATE
 1060 09B5 C6 01       NSCANA LDAB   #$01             LOAD RC
 1061 09B7 20 1E              BRA    ENDSCN           RETURN
 1062                  *
 1063                  * HSCAN - SCAN A STRING OF HEX DATA AND STOP
 1064                  * AT FIRST NON-HEXADECIMAL CHARACTER.
 1065                  *
 1066 09B9 7F 04C6     HSCAN  CLR    DESCRC           DESCRC:=0
 1067 09BC FE 04C7            LDX    CUCHAR           POINT TO NEXT CHAR
 1068 09BF FF 04C4            STX    DESCRA           INIT DESCRA
 1069 09C2 FE 04C7     HSCAN1 LDX    CUCHAR           POINT TO NEXT CHAR
 1070 09C5 A6 00              LDAA   0,X              GET CHAR
 1071 09C7 7C 04C6            INC    DESCRC           INCR DESCRC COUNT
 1072 09CA 08                 INX
 1073 09CB FF 04C7            STX    CUCHAR           POINT TO NEXT CHAR
 1074 09CE BD 09E4            JSR    GCHRTB           GET BYTE FROM CHRTAB
 1075 09D1 85 02              BITA   #$02             HEX?
 1076 09D3 26 ED              BNE    HSCAN1           YES CONTINUE SCAN
 1077 09D5 C6 03              LDAB   #$03
 1078                  *
 1079 09D7 7A 04C6     ENDSCN DEC    DESCRC           DESCRC := CORRECT COUNT
 1080 09DA FE 04C7            LDX    CUCHAR
 1081 09DD 09                 DEX
 1082 09DE FF 04C7            STX    CUCHAR           CUCHAR:= CORRECT VALUE
 1083 09E1 86 02              LDAA   #$02             LOAD CLASS RC
 1084 09E3 39                 RTS                     ALL DONE
 1085                  *
 1086                  * GET A BYTE FROM CHARACTER TABLE INDEXED BY
 1087                  * VALUE IN A REGISTER.
 1088                  *
 1089 09E4 81 20       GCHRTB CMPA   #$20             VALID CHAR?
 1090 09E6 25 16              BCS    GCHRTR           NO <20
 1091 09E8 81 5F              CMPA   #$5F             VALID CHAR?
 1092 09EA 22 12              BHI    GCHRTR           NO >5F
 1093                  *
 1094 09EC 7F 0A00            CLR    CHPTR            INIT PARAM
 1095 09EF B7 0A01            STAA   CHPTR+1          SAVE CHAR
 1096 09F2 CE 0A00            LDX    #CHPTR           POINT TO PARAM
 1097 09F5 BD 0E0D            JSR    ADD16            ADD IN BASE OF CHARTAB
 1098 09F8 FE 0A00            LDX    CHPTR            GET BYTE IN CHARTAB
 1099 09FB A6 00              LDAA   0,X
 1100 09FD 39                 RTS
 1101                  *
 1102 09FE 4F          GCHRTR CLRA
 1103 09FF 39                 RTS
 1104                  *
 1105 0A00             CHPTR  RMB    2                PARAM LIST
 1106 0A02 04 36              FDB    CHRTAB-$20
 1107                  *
 1108                  * TABLE MANIPULATION ROUTINES FOR TABLES
 1109                  * SYMTAB AND MNTAB
 1110                  *
 1111                  * STORAGE LOCATIONS USED BY ROUTINES:
 1112                  *
 1113 0A04             PSTNG1 RMB    2                ADDRESS OF MENMONIC
 1114 0A06             PSTNG2 RMB    2                ADDRESS IN THE TABLE
 1115 0A08             PCOUNT RMB    1                LENGTH OF MNEMONIC
 1116 0A09             TBADD  RMB    2                TABLE POINTER
 1117 0A0B             HSMBL  RMB    6                SYMBOL TEMP LOC
 1118 0A11             HKEYA  RMB    2                HASHED CODE
 1119 0A13             HKEYB  RMB    2                TEMP LOC FOR HASHED CODE
 1120 0A15             HSAV1  RMB    2                TEMP LOC FOR PTR
 1121 0A17             HSAV2  RMB    2                TEMP LOC FOR PTR
 1122                  *
 1123                  *
 1124                  * STORE A SYMBOL IN SYMTAB (SYMBOL TABLE)
 1125                  * ON ENTRY DESCRA CONTAINS THE ADDRESS OF
 1126                  * THE SYMBOL, AND DESCRC CONTAINS THE LENGTH
 1127                  * A STANDARD HASH CODE ALGORITHM IS USED
 1128                  *
 1129 0A19 BD 0ADA     STOSYM JSR    HASH             GET HASHED KEY
 1130 0A1C FF 04CB            STX    SYMPTR           SAVE
 1131                  *
 1132                  * SEE IF LOC(HASH KEY) IS EMPTY
 1133                  *
 1134 0A1F A6 00       SYMA   LDAA   0,X              GET FIRST CHARACTER
 1135 0A21 81 20              CMPA   #$20             BLANK?
 1136 0A23 26 2F              BNE    SYMB             NO
 1137                  *
 1138                  * STORE SYMBOL IN SYMTAB
 1139                  *
 1140 0A25 FF 0A17            STX    HSAV2            SAVE TABLE POINTER
 1141 0A28 CE 0A0B            LDX    #HSMBL           POINT TO HSMBL
 1142 0A2B FF 0A15            STX    HSAV1            SAVE
 1143 0A2E C6 06              LDAB   #6               LOAD SYMBOL LENGTH
 1144                  *
 1145                  * DO TRANSFER
 1146                  *
 1147 0A30 FE 0A15     SYM1   LDX    HSAV1            POINT TO HSYMBL
 1148 0A33 A6 00              LDAA   0,X              GET CHAR
 1149 0A35 08                 INX
 1150 0A36 FF 0A15            STX    HSAV1            POINT TO NEXT CHAR
 1151 0A39 FE 0A17            LDX    HSAV2            POINT TO TABLE SPACE
 1152 0A3C A7 00              STAA   0,X              STORE CHAR IN SYMTAB
 1153 0A3E 08                 INX
 1154 0A3F FF 0A17            STX    HSAV2            POINT TO NEXT POS
 1155 0A42 5A                 DECB                    ALL DONE?
 1156 0A43 26 EB              BNE    SYM1             NO
 1157                  *
 1158                  * STORE STORE LC, AND SET INFO BYTE
 1159                  *
 1160 0A45 B6 04BC            LDAA   LC               GET LC
 1161 0A48 A7 00              STAA   0,X              STORE
 1162 0A4A B6 04BD            LDAA   LC+1             GET LS BYTE OF LC
 1163 0A4D A7 01              STAA   1,X              STORE
 1164 0A4F 86 40              LDAA   #$40             INFO BYTE:=RELOC,DEFINED
 1165 0A51 A7 02              STAA   2,X
 1166 0A53 39                 RTS                     RETURN
 1167                  *
 1168                  * COMPARE HSMBL WITH ENTRY IN SYMTAB
 1169                  *
 1170 0A54 BD 0A9F     SYMB   JSR    SYMCMP           COMPARE
 1171 0A57 26 10              BNE    SYMC             NO MATCH
 1172                  *
 1173                  * ERROR, SYMBOL ALREADY IN TABLE
 1174                  *
 1175 0A59 FE 04CB            LDX    SYMPTR           GET ADDRESS OF ENTRY
 1176 0A5C 86 80              LDAA   #$80
 1177 0A5E AA 08              ORAA   8,X              SET REDEFINED BIT
 1178 0A60 A7 08              STAA   8,X
 1179 0A62 CE 0206            LDX    #$0206           LOAD ERROR NUMBER
 1180 0A65 BD 0FDC     SYMB1  JSR    PRINTE           PRINT IT
 1181 0A68 39                 RTS                     RETURN
 1182                  *
 1183                  * FIND ANOTHER SLOT IN SYMTAB FOR SYMBOL
 1184                  *
 1185 0A69 BD 0AB4     SYMC   JSR    SYMMOD           GET ADDR(NEXT SLOT)
 1186 0A6C BC 0A11            CPX    HKEYA            CHECKED ALREADY?
 1187 0A6F 27 02              BEQ    *+4              YES,TABLE IS FULL
 1188                  *
 1189 0A71 20 AC              BRA    SYMA             TRY AGAIN
 1190                  *
 1191 0A73 CE 0221            LDX    #$0221           LOAD ERROR NUMBER
 1192 0A76 20 ED              BRA    SYMB1            PRINT IT & RETURN
 1193                  *
 1194                  * LOOK UP SYMBOL IN SYMTAB
 1195                  * ON ENTRY DESCRA = ADDRESS OF SYMBOL
 1196                  *          DESCRC = SYMBOL LENGTH
 1197                  * ON RETURN B = VALUE OF INFO BYTE
 1198                  *             = FF SYMBOL NOT FOUND
 1199                  *           X = VALUE OF SYMBOL
 1200                  *
 1201                  *
 1202 0A78 BD 0ADA     LKPSYM JSR    HASH             GET KEY
 1203 0A7B FF 04CB            STX    SYMPTR           SAVE
 1204                  *
 1205 0A7E A6 00       LKPSM1 LDAA   0,X              GET CHARACTER
 1206 0A80 81 20              CMPA   #$20             BLANK?
 1207 0A82 26 03              BNE    LKPSM3           NO
 1208                  *
 1209                  * ENTRY NOT IN SYMTAB
 1210                  *
 1211 0A84 C6 FF       LKPSM2 LDAB   #$FF             LOAD RC
 1212 0A86 39                 RTS                     RETURN
 1213                  *
 1214                  * COMPARE SYMBOL WITH ENTRY IN SYMTAB
 1215                  *
 1216 0A87 BD 0A9F     LKPSM3 JSR    SYMCMP           COMPARE
 1217 0A8A 26 08              BNE    LKPSM4           NO MATCH
 1218                  *
 1219                  * FOUND, EXTRACT INFO, AND VALUE
 1220                  *
 1221 0A8C FE 04CB            LDX    SYMPTR           POINT TO ENTRY
 1222 0A8F E6 08              LDAB   8,X              GET INFO BYTE
 1223 0A91 EE 06              LDX    6,X              GET VALUE
 1224 0A93 39                 RTS
 1225                  *
 1226                  * PROBE AGAIN FOR SYMBOL IN SYMTAB
 1227                  *
 1228 0A94 BD 0AB4     LKPSM4 JSR    SYMMOD           GET NEXT KEY
 1229 0A97 BC 0A11            CPX    HKEYA            ALREADY CHECKED?
 1230 0A9A 26 E2              BNE    LKPSM1           NO,TRY AGAIN
 1231 0A9C C6 FF              LDAB   #$FF             SET RC
 1232 0A9E 39                 RTS
 1233                  *
 1234                  * ROUTINE TO COMPARE SYMBOL WITH ENTRY
 1235                  *
 1236 0A9F FF 0A04     SYMCMP STX    PSTNG1           SAVE PTR TO ENTRY
 1237 0AA2 86 06              LDAA   #6
 1238 0AA4 B7 0A08            STAA   PCOUNT           PCOUNT := LENGTH(SYMBOL)
 1239 0AA7 CE 0A0B            LDX    #HSMBL
 1240 0AAA FF 0A06            STX    PSTNG2           POINT TO HSMBL
 1241 0AAD CE 0A04            LDX    #PSTNG1          POINT TO PARAMS
 1242 0AB0 BD 08E6            JSR    COMPAR           COMPARE
 1243 0AB3 39                 RTS
 1244                  *
 1245                  * FIND NEXT SLOT IN SYMTAB
 1246                  * SYMPTR:=SYMPTR+9 (MODULO NSYM)
 1247                  *
 1248 0AB4 FE 04CB     SYMMOD LDX    SYMPTR           GET ADDR(CURRENT SLOT)
 1249 0AB7 08                 INX
 1250 0AB8 08                 INX
 1251 0AB9 08                 INX
 1252 0ABA 08                 INX
 1253 0ABB 08                 INX
 1254 0ABC 08                 INX
 1255 0ABD 08                 INX
 1256 0ABE 08                 INX
 1257 0ABF 08                 INX
 1258                  *
 1259                  * BEYOND SYMTAB?
 1260                  *
 1261 0AC0 BC 04B5            CPX    SYMEND
 1262 0AC3 26 03              BNE    *+5              NO
 1263 0AC5 FE 04B1            LDX    SYMTAB           POINT TO FIRST ENTRY
 1264 0AC8 FF 04CB            STX    SYMPTR           SAVE PTR TO ENTRY
 1265 0ACB 39                 RTS
 1266                  *
 1267                  * DELETE LAST SYMBOL ENTERED
 1268                  *
 1269 0ACC FE 04CB     DELSYM LDX    SYMPTR
 1270 0ACF 86 20              LDAA   #$20             LOAD BLANK
 1271 0AD1 C6 09              LDAB   #9               LOAD ENTRY LENGTH
 1272                  *
 1273 0AD3 A7 00       DEL1   STAA   0,X              BLANK BYTE
 1274 0AD5 08                 INX                     POINT TO NEXT BYTE
 1275 0AD6 5A                 DECB                    ALL DONE ?
 1276 0AD7 26 FA              BNE    DEL1             NO
 1277                  *
 1278 0AD9 39                 RTS                     YES, RETURN
 1279                  *
 1280                  * HASH SYMBOL TO PRODUCE A KEY
 1281                  *
 1282 0ADA CE 2020     HASH   LDX    #$2020           BLANK HSMBL
 1283 0ADD FF 0A0B            STX    HSMBL
 1284 0AE0 FF 0A0D            STX    HSMBL+2
 1285 0AE3 FF 0A0F            STX    HSMBL+4
 1286                  *
 1287                  * MOVE SYMBOL TO HSMBL
 1288                  *
 1289 0AE6 CE 0A0B            LDX    #HSMBL           POINT TO HSMBL
 1290 0AE9 FF 0A17            STX    HSAV2            SAVE
 1291 0AEC FE 04C4            LDX    DESCRA           POINT TO SYMBOL
 1292 0AEF FF 0A15            STX    HSAV1            SAVE
 1293 0AF2 F6 04C6            LDAB   DESCRC           GET LENGTH(SYMBOL)
 1294                  *
 1295 0AF5 FE 0A15     HASH1  LDX    HSAV1            POINT TO SYMBOL
 1296 0AF8 A6 00              LDAA   0,X              GET CHAR
 1297 0AFA 08                 INX
 1298 0AFB FF 0A15            STX    HSAV1            POINT TO NEXT CHAR
 1299 0AFE FE 0A17            LDX    HSAV2            POINT TO HSYMBL
 1300 0B01 A7 00              STAA   0,X              STORE CHAR
 1301 0B03 08                 INX
 1302 0B04 FF 0A17            STX    HSAV2            POINT TO NEXT CHAR
 1303 0B07 5A                 DECB                    ALL DONE
 1304 0B08 26 EB              BNE    HASH1            NO
 1305                  *
 1306                  * FOLD HSMBL TO CREATE A KEYA
 1307                  *
 1308 0B0A FE 0A0B            LDX    HSMBL            HKEYA:=HSMBL(2)
 1309 0B0D FF 0A11            STX    HKEYA
 1310 0B10 FE 0A0D            LDX    HSMBL+2
 1311 0B13 FF 0A13            STX    HKEYB
 1312 0B16 CE 0A11            LDX    #HKEYA
 1313 0B19 BD 0E0D            JSR    ADD16            ;      +HSMBL+2(2)
 1314 0B1C FE 0A0F            LDX    HSMBL+4
 1315 0B1F FF 0A13            STX    HKEYB
 1316 0B22 CE 0A11            LDX    #HKEYA
 1317 0B25 BD 0E0D            JSR    ADD16            ;       +HSMBL+4(2)
 1318                  *
 1319                  * HKEYA:=REMAINDER OF HKEYA/NSYM
 1320                  *
 1321 0B28 B6 0A11            LDAA   HKEYA            LOAD VALUES
 1322 0B2B F6 0A12            LDAB   HKEYA+1
 1323 0B2E FE 04B3            LDX    NSYM
 1324 0B31 FF 0A13            STX    HKEYB
 1325 0B34 CE 0A13            LDX    #HKEYB           POINT TO NSYM
 1326 0B37 BD 0DC2            JSR    DIV16
 1327 0B3A FF 0A11            STX    HKEYA            SAVE REMAINDER
 1328                  *
 1329                  * HKEYA:=HKEYA*9
 1330                  *
 1331 0B3D 4F                 CLRA
 1332 0B3E C6 09              LDAB   #9
 1333 0B40 CE 0A11            LDX    #HKEYA
 1334 0B43 BD 0D9E            JSR    MPY16
 1335 0B46 B7 0A11            STAA   HKEYA
 1336 0B49 F7 0A12            STAB   HKEYA+1
 1337                  *
 1338                  * ADD IN BASE OF SYMTAB
 1339                  *
 1340 0B4C FE 04B1            LDX    SYMTAB
 1341 0B4F FF 0A13            STX    HKEYB
 1342 0B52 CE 0A11            LDX    #HKEYA
 1343 0B55 BD 0E0D            JSR    ADD16
 1344 0B58 FE 0A11            LDX    HKEYA
 1345 0B5B 39                 RTS
 1346                  *
 1347                  * LOOK UP MNEMONIC IN MNTAB
 1348                  * ON ENTRY DESCRA = ADDR OF MNEMONIC
 1349                  *          DESCRC = LENGTH OF MNEMONIC
 1350                  * ON RETURN
 1351                  *  REG A = 00 FOUND
 1352                  *  REG A = FF NOT IN TABLE
 1353                  *  REG X = ADDR OF ROUTINE TO PROCESS
 1354                  *          THE OPCODE/PSEUDOP
 1355                  *  REG B = MACHINE CODE FOR OPCODES
 1356                  *        = FF FOR PSEUDOPS
 1357                  *
 1358                  * THE ALGORITHM USED IS A BINARY SEARCH
 1359                  *
 1360                  * TEMPORARY LOCATIONS:
 1361 0B5C             LP     RMB    1                ONE BELOW LOWEST ENTRY
 1362 0B5D             MP     RMB    1                ONE HIGHER THAN HIGHEST ENTRY
 1363 0B5E             IP     RMB    1                CALCULATED PROBE VALUE
 1364 0B5F 00 06       ENSIZ  FDB    6                LENGTH OF ENTRY IN MNTAB
 1365                  *
 1366 0B61 B6 04C6     MNLKP  LDAA   DESCRC
 1367 0B64 B7 0A08            STAA   PCOUNT           INIT PCOUNT
 1368 0B67 86 57              LDAA   #$57             $57=CHRTAB-MNTAB/6+1 (# OF ENTRIES+1)
 1369 0B69 B7 0B5D            STAA   MP               INIT MP
 1370 0B6C 4F                 CLRA
 1371 0B6D B7 0B5C            STAA   LP               INIT LP
 1372                  *
 1373 0B70 B6 0B5C     MNLKPA LDAA   LP
 1374 0B73 4C                 INCA                    A:=LP+1
 1375 0B74 B1 0B5D            CMPA   MP               MP:=LP+1 ?
 1376 0B77 26 03              BNE    MNLKPB           NO
 1377                  *
 1378 0B79 86 FF              LDAA   #$FF             YES, ENTRY NOT IN TABLE
 1379 0B7B 39                 RTS
 1380                  *
 1381                  * IP:=(LP+MP)/2 TRUNCATED
 1382                  *
 1383 0B7C F6 0B5C     MNLKPB LDAB   LP
 1384 0B7F FB 0B5D            ADDB   MP               B:=LP+MP
 1385 0B82 56                 RORB                    B:=B/2
 1386 0B83 F7 0B5E            STAB   IP               SAVE IP
 1387                  *
 1388                  * GET 16 BITADDRESS OF ENTRY
 1389                  *
 1390 0B86 4F                 CLRA
 1391 0B87 CE 0B5F            LDX    #ENSIZ           GET ENTRY LENGTH
 1392 0B8A 5A                 DECB                    B:=IP-1
 1393 0B8B BD 0D9E            JSR    MPY16            GET (IP-1)*6
 1394 0B8E B7 0A04            STAA   PSTNG1           SAVE
 1395 0B91 F7 0A05            STAB   PSTNG1+1
 1396 0B94 CE 025E            LDX    #MNTAB
 1397 0B97 FF 0A06            STX    PSTNG2           PSTNG2:=BASE OF MNTAB
 1398 0B9A CE 0A04            LDX    #PSTNG1          POINT TO PARAMS
 1399 0B9D BD 0E0D            JSR    ADD16            PSTNG1:=(IP-1)*6+MNTAB
 1400 0BA0 FE 0A04            LDX    PSTNG1
 1401 0BA3 FF 0A09            STX    TBADD            SAVE
 1402                  *
 1403                  * COMPARE MNEMONIC WITH ENTRY IN MNTAB
 1404                  *
 1405 0BA6 FE 04C4            LDX    DESCRA           GET MNEMONIC ADDRESS
 1406 0BA9 FF 0A06            STX    PSTNG2           INIT PARAM FOR COMPARE
 1407 0BAC CE 0A04            LDX    #PSTNG1          POINT TO PARAMS
 1408 0BAF BD 08E6            JSR    COMPAR           COMPARE
 1409 0BB2 25 0B              BCS    MNLI             ENTRY<MNEMONIC
 1410 0BB4 26 11              BNE    MNMI             ENTRY>MNEMONIC
 1411                  *
 1412 0BB6 4F                 CLRA                    ENTRY FOUND
 1413 0BB7 FE 0A09            LDX    TBADD            POINT TO ENTRY
 1414 0BBA E6 05              LDAB   5,X              GET MACHINE CODE
 1415 0BBC EE 03              LDX    3,X              GET BRANCH TO ROUTINE ADDR
 1416 0BBE 39                 RTS
 1417                  *
 1418                  * ENTRY<MNEMONIC LP:=IP
 1419                  *
 1420 0BBF B6 0B5E     MNLI   LDAA   IP
 1421 0BC2 B7 0B5C            STAA   LP
 1422 0BC5 20 A9              BRA    MNLKPA           TRY AGAIN
 1423                  *
 1424                  * ENTRY>MNEMONIC MP:=IP
 1425                  *
 1426 0BC7 B6 0B5E     MNMI   LDAA   IP
 1427 0BCA B7 0B5D            STAA   MP
 1428 0BCD 20 A1              BRA    MNLKPA           TRY AGAIN
 1429                  *
 1430                  * EVALUATE NUMBERS, SYMBOLS AND EXPRESSIONS
 1431                  *
 1432 0BCF             VALUE  RMB    2
 1433 0BD1             TMPVAL RMB    2
 1434 0BD3             CLFLG  RMB    1                CLASS OF PREVIOUS TOKEN
 1435 0BD4             CLASS  RMB    1                CLASS OF CURRENT TOKEN
 1436 0BD5             OPERN  RMB    1                ARITHMETIC OPERATOR
 1437                  *
 1438 0BD6 7F 0BCF     NSEVL  CLR    VALUE
 1439 0BD9 7F 0BD0            CLR    VALUE+1          VALUE := 0
 1440 0BDC 7F 0BD3            CLR    CLFLG            CLFLG := 0
 1441 0BDF B7 0BD4            STAA   CLASS            SAVE CLASS OF TOKEN
 1442 0BE2 C1 2A              CMPB   #$2A             IS * ?
 1443 0BE4 26 2D              BNE    NSVLC1           NO
 1444                  *
 1445 0BE6 FE 04BC            LDX    LC               YES
 1446 0BE9 FF 0BCF            STX    VALUE            VALUE := LC
 1447 0BEC 86 02              LDAA   #2
 1448 0BEE B7 0BD3            STAA   CLFLG            CLFLG:=2
 1449 0BF1 73 04C0            COM    RELFLG           RELFLG:=RELOC
 1450                  *
 1451 0BF4 FE 04C7     NSVLA  LDX    CUCHAR
 1452 0BF7 A6 00              LDAA   0,X              GET NEXT CHAR
 1453 0BF9 81 20              CMPA   #$20             BLANK?
 1454 0BFB 27 08              BEQ    NSVLB            YES
 1455 0BFD 81 0D              CMPA   #$0D             EOL?
 1456 0BFF 27 04              BEQ    NSVLB            YES
 1457 0C01 81 2C              CMPA   #$2C             COMMA?
 1458 0C03 26 08              BNE    NSVLC            NO
 1459                  *
 1460 0C05 FE 0BCF     NSVLB  LDX    VALUE
 1461 0C08 FF 0E89            STX    ADR1             ADR1,2:=VALUE
 1462 0C0B 5F                 CLRB                    RC := 00
 1463 0C0C 39                 RTS                     ALL DONE
 1464                  *
 1465 0C0D BD 0917     NSVLC  JSR    NXTOK            GET NEXT TOKEN
 1466 0C10 B7 0BD4            STAA   CLASS            SAVE TOKEN CLASS
 1467 0C13 B1 0BD3     NSVLC1 CMPA   CLFLG            CLASS = CLFLG?
 1468 0C16 26 06              BNE    NSVLF            NO
 1469                  *
 1470 0C18 CE 0204     NSVLD  LDX    #$0204           ERROR
 1471 0C1B 5F          NSVLE  CLRB
 1472 0C1C 53                 COMB                    RC := FF
 1473 0C1D 39                 RTS                     RETURN
 1474                  *
 1475 0C1E 81 02       NSVLF  CMPA   #$02             IS STRING?
 1476 0C20 27 14              BEQ    NSVLH            YES
 1477                  *
 1478 0C22 81 24              CMPA   #$24             ARITHMETIC OPERATOR?
 1479 0C24 27 02              BEQ    NSVLG            YES
 1480 0C26 20 F0              BRA    NSVLD            ERROR
 1481                  *
 1482 0C28 7D 0BD3     NSVLG  TST    CLFLG            CLFLG=0?
