 1747 0DDF A6 03              LDAA   3,X
 1748 0DE1 E6 04              LDAB   4,X
 1749 0DE3 6F 03              CLR    3,X
 1750 0DE5 6F 04              CLR    4,X
 1751 0DE7 E0 02       DIV163 SUBB   2,X
 1752 0DE9 A2 01              SBCA   1,X
 1753 0DEB 24 07              BCC    DIV165           DIVISOR STILL OK
 1754 0DED EB 02              ADDB   2,X              DIVISOR TOO LARGE
 1755 0DEF A9 01              ADCA   1,X              RESTORE
 1756 0DF1 0C                 CLC
 1757 0DF2 20 01              BRA    DIV167
 1758 0DF4 0D          DIV165 SEC
 1759 0DF5 69 04       DIV167 ROL    4,X
 1760 0DF7 69 03              ROL    3,X
 1761 0DF9 64 01              LSR    1,X              ADJUST DIVISOR
 1762 0DFB 66 02              ROR    2,X
 1763 0DFD 6A 00              DEC    0,X
 1764 0DFF 26 E6              BNE    DIV163
 1765                  *
 1766 0E01 A7 00              STAA   0,X              SAVE REMAINDER IN X
 1767 0E03 E7 01              STAB   1,X
 1768 0E05 EE 00              LDX    0,X
 1769 0E07 31                 INS                     CLEAN UP STACK
 1770 0E08 31                 INS
