 1736 0DCB 30                 TSX                     (X) PNTR TO STACKED DATA
 1737 0DCC 86 01              LDAA   #1
 1738 0DCE 6D 01              TST    1,X
 1739 0DD0 2B 0B              BMI    DIV153
 1740 0DD2 4C          DIV151 INCA
 1741 0DD3 68 02              ASL    2,X
 1742 0DD5 69 01              ROL    1,X
 1743 0DD7 2B 04              BMI    DIV153
 1744 0DD9 81 11              CMPA   #17
