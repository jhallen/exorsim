 1588                  *
 1589                  * CVHB CONVERT HEX TO BINARY
 1590                  *
 1591                  * ON ENTRY DESCRA = ADDRESS OF STRING
 1592                  *          DESCRC = # OF BYTES IN STRING
 1593                  * ON RETURN [X]=VALUE
 1594                  *
 1595 0CED             HVAL   RMB    2                TEMP STORAGE
 1596                  *
 1597 0CEF FE 04C4     CVHB   LDX    DESCRA           GET ADDRESS OF STRING
 1598 0CF2 7F 0CED            CLR    HVAL
 1599 0CF5 7F 0CEE            CLR    HVAL+1
 1600 0CF8 F6 04C6            LDAB   DESCRC           GET COUNT
 1601 0CFB 09                 DEX                     DECR PTR TO STRING
 1602 0CFC 08          CVHB1  INX                     POINT TO RIGHT MOST
 1603 0CFD 5A                 DECB                    BYTE OF THE
 1604 0CFE 26 FC              BNE    CVHB1            STRING
 1605                  *
 1606 0D00 F6 04C6            LDAB   DESCRC           GET COUNT
 1607 0D03 BD 0D39            JSR    CVHBS            CONVERT
 1608 0D06 B7 0CEE            STAA   HVAL+1           SAVE
 1609 0D09 5A                 DECB                    DECR COUNT
 1610 0D0A 27 29              BEQ    CVHBD            (1 HEX DIGIT)
 1611 0D0C 09                 DEX                     POINT TO NEXT LEFT BYTE
 1612 0D0D BD 0D39            JSR    CVHBS            CONVERT
 1613 0D10 48                 ASLA                    SHIFT TO LEFT NIBBLE
 1614 0D11 48                 ASLA
 1615 0D12 48                 ASLA
 1616 0D13 48                 ASLA
 1617 0D14 BA 0CEE            ORAA   HVAL+1           CONVERT TO BYTE
 1618 0D17 B7 0CEE            STAA   HVAL+1           SAVE
 1619 0D1A 5A                 DECB                    DECREMENT COUNT
 1620 0D1B 27 18              BEQ    CVHBD            (2 HEX DIGITS)
 1621 0D1D 09                 DEX                     POINT TO NEXT LEFT BYTE
 1622 0D1E BD 0D39            JSR    CVHBS            CONVERT
 1623 0D21 B7 0CED            STAA   HVAL             SAVE
 1624 0D24 5A                 DECB                    DECREMENT COUNT
 1625 0D25 27 0E              BEQ    CVHBD            (3 HEX DIGITS)
 1626                  *
 1627 0D27 09                 DEX                     POINT TO NEXT LEFT BYTE
 1628 0D28 BD 0D39            JSR    CVHBS            CONVERT
 1629 0D2B 48                 ASLA                    SHIFT TO LEFT NIBBLE
 1630 0D2C 48                 ASLA
 1631 0D2D 48                 ASLA
 1632 0D2E 48                 ASLA
 1633 0D2F BA 0CED            ORAA   HVAL             CONVERT TO BYTE
 1634 0D32 B7 0CED            STAA   HVAL             SAVE
 1635 0D35 FE 0CED     CVHBD  LDX    HVAL             GET FINAL VALUE
 1636 0D38 39                 RTS                     RETURN
 1637                  *
 1638                  * ROUTINE TO CONVERT ASCII TO BINARY
 1639                  *
 1640 0D39 A6 00       CVHBS  LDAA   0,X              GET BYTE
 1641 0D3B 80 30              SUBA   #$30             CONVERT
 1642 0D3D 81 09              CMPA   #$09             0 - 9 ?
 1643 0D3F 2F 02              BLE    *+4              YES
 1644 0D41 80 07              SUBA   #$07             NO, 10 - 15
 1645 0D43 39                 RTS
 1646                  *
 1647                  * CVDB: CONVERT DECIMAL TO BINARY
 1648                  * ON ENTRY DESCRA = ADDRESS OF DECIMAL STRING
 1649                  *          DESCRC = # BYTES IN DECIMAL STRING
 1650                  * ON RETURN [X] = VALUE IN BINARY
 1651                  *
 1652 0D44             DVAL   RMB    2                TEMP STORAGE FOR BINARY
 1653 0D46             DCOUNT RMB    1                DIGIT COUNT
 1654 0D47             TENVL  RMB    2                POWER OF TEN
 1655 0D49             DXSAV  RMB    2                TEMPORARY STORAGE FOR X
 1656                  *
 1657 0D4B 7F 0D44     CVDB   CLR    DVAL             DVAL:=0
 1658 0D4E 7F 0D45            CLR    DVAL+1
 1659 0D51 7F 0D47            CLR    TENVL
 1660 0D54 7F 0D48            CLR    TENVL+1
 1661 0D57 7C 0D48            INC    TENVL+1          TENVL:=1
 1662 0D5A FE 04C4            LDX    DESCRA           POINT TO STRING
 1663 0D5D 09                 DEX
 1664 0D5E F6 04C6            LDAB   DESCRC
 1665 0D61 F7 0D46            STAB   DCOUNT           INIT DCOUNT
 1666                  *
 1667 0D64 08          CVDB1  INX                     POINT TO
 1668 0D65 5A                 DECB                    LEAST SIGNIFICANT
 1669 0D66 26 FC              BNE    CVDB1            DIGIT
 1670                  *
 1671 0D68 FF 0D49     CVDB2  STX    DXSAV            SAVE POINTER
 1672 0D6B E6 00              LDAB   0,X              GET DIGIT
 1673 0D6D C4 0F              ANDB   #$0F             CONVERT TO BCD
 1674 0D6F 4F                 CLRA                    CLEAR ACCUMULATOR
 1675 0D70 CE 0D47            LDX    #TENVL           POINT TO POWER OF TEN
 1676 0D73 BD 0D9E            JSR    MPY16            (A,B):=TENVL*DIGIT
 1677 0D76 FB 0D45            ADDB   DVAL+1           DVAL:=DVAL+TENVL*DIGIT
 1678 0D79 B9 0D44            ADCA   DVAL
 1679 0D7C B7 0D44            STAA   DVAL
 1680 0D7F F7 0D45            STAB   DVAL+1
 1681 0D82 4F                 CLRA
 1682 0D83 C6 0A              LDAB   #$0A             B:=10
 1683 0D85 CE 0D47            LDX    #TENVL           POINT TO POWER OF TEN
 1684 0D88 BD 0D9E            JSR    MPY16            TENVL:=TENVL*10
 1685 0D8B B7 0D47            STAA   TENVL
 1686 0D8E F7 0D48            STAB   TENVL+1
 1687 0D91 FE 0D49            LDX    DXSAV            RESTORE POINTER TO STRING
 1688 0D94 09                 DEX                     POINT NEXT LEFT DIGIT
 1689 0D95 7A 0D46            DEC    DCOUNT           DONE?
 1690 0D98 26 CE              BNE    CVDB2            NO
 1691 0D9A FE 0D44            LDX    DVAL             GET FINAL VALUE
 1692 0D9D 39                 RTS                     RETURN
